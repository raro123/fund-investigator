---
/**
 * ReportCard Component
 *
 * Editorial dark card for investigation reports. Five content zones:
 * meta (readTime + date), title, hook, metrics, footer (CTA).
 *
 * @example
 * <ReportCard report={report} href={`/reports/${report.slug}`} />
 *
 * @param report - Astro content collection entry with data fields:
 *   title, category, readTime, hook?, keyMetrics?, date, status?
 * @param href - URL to navigate to on click
 * @param surface - 'dark' (default, /reports/) or 'light' (homepage); light swaps gold for fi-link
 */

import Badge from './ui/Badge.astro';
import MetricIcon from './ui/MetricIcon.astro';
import type { ReportMetricIconName } from '../lib/report-metrics';
import { formatDate } from '../lib/format';

interface KeyMetric {
  label: string;
  value?: string;
  icon?: ReportMetricIconName;
}

interface Props {
  report: {
    /** Content-collection slug; names the title for the card → article transition */
    slug?: string;
    data: {
      title: string;
      category: string;
      readTime: string;
      date: string;
      hook?: string;
      keyMetrics?: KeyMetric[];
      status?: 'current' | 'archived';
    };
  };
  href: string;
  /** Section surface: 'dark' (default, /reports/) or 'light' (homepage) */
  surface?: 'light' | 'dark';
}

const { report, href, surface = 'dark' } = Astro.props;

// One class set per surface; gold text and hovers only on dark (style_spec §1).
const styles = {
  dark: {
    card: 'bg-fi-mid border-fi-border-dark hover:border-fi-subtle hover:shadow-fi-card-dark',
    meta: 'text-fi-subtle',
    title: 'text-fi-ink-inv group-hover:text-fi-gold',
    hook: 'text-fi-muted-inv',
    rule: 'border-fi-border-dark',
    value: 'text-fi-ink-inv',
    cta: 'text-fi-gold',
  },
  light: {
    card: 'bg-white border-fi-border shadow-fi-card hover:border-fi-subtle',
    meta: 'text-fi-muted',
    title: 'text-fi-ink group-hover:text-fi-link',
    hook: 'text-fi-muted',
    rule: 'border-fi-border',
    value: 'text-fi-ink',
    cta: 'text-fi-link',
  },
}[surface];
const { title, readTime, date, hook, keyMetrics, status = 'current' } = report.data;

const formattedDate = formatDate(date, 'short');

// Same name as the article H1 (ArticleLayout.astro), so the title moves into
// place on navigation. Slugs are unique, so names never clash on one page.
const titleTransition = report.slug ? `view-transition-name: report-${report.slug}` : undefined;

---

<a href={href} class="block h-full group">
  <article class:list={[styles.card, 'border rounded-lg p-6 h-full flex flex-col hover:-translate-y-1 transition-all duration-200']}>

    <!-- Zone 1: Meta row -->
    <div class="flex justify-between items-center gap-3">
      <div class="flex items-center gap-2">
        <span class:list={[styles.meta, 'text-caption font-medium uppercase tracking-widest']}>{readTime}</span>
        {status === 'archived' && <Badge variant="dark" size="sm">Historical</Badge>}
      </div>
      <time class:list={[styles.meta, 'text-caption font-medium uppercase tracking-widest tabular-nums']}>{formattedDate}</time>
    </div>

    <!-- Zone 2: Title -->
    <h2 class:list={[styles.title, 'text-heading-sm font-bold leading-tight line-clamp-2 mt-4 transition-colors duration-200']} style={titleTransition}>
      {title}
    </h2>

    <!-- Zone 3: Hook -->
    {hook && (
      <p class:list={[styles.hook, 'text-body-sm leading-relaxed mt-3 flex-1']}>{hook}</p>
    )}

    <!-- Zone 4: Metrics -->
    {keyMetrics && keyMetrics.length > 0 && (
      <div class:list={[styles.rule, 'border-t mt-5 pt-5']}>
        <div class="grid grid-cols-3">
          {keyMetrics.map((metric, i) => (
            <div class:list={['text-center', i > 0 && ['border-l', styles.rule]]}>
              {metric.icon ? (
                <MetricIcon name={metric.icon} surface={surface} />
              ) : (
                <p class:list={[styles.value, 'text-heading-md font-bold']}>{metric.value}</p>
              )}
              <p class:list={[styles.meta, 'text-caption font-medium uppercase tracking-wide mt-2']}>{metric.label}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Footer -->
    <div class:list={[styles.rule, 'border-t mt-5 pt-5 flex items-center justify-center']}>
      <span class:list={[styles.cta, 'text-caption font-semibold inline-block transition-transform duration-200 group-hover:translate-x-2']}>Read Investigation →</span>
    </div>

  </article>
</a>
