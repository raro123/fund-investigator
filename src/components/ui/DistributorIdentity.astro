---
/**
 * DistributorIdentity Component
 *
 * The AMFI distributor disclosure: registered name, the exact tagline, ARN, and
 * a link to verify the ARN on AMFI's distributor search. Values come from
 * `src/lib/distributor.ts` so every page shows the same, current details.
 *
 * The standard risk warning (RISK_WARNING) was taken out of the footer line at
 * the owner's decision, 2026-10-19, against the advice that AMFI expects it
 * wherever mutual funds are promoted; it stays on /disclaimer/.
 *
 * @example
 * <!-- Footer bottom bar: one line of identity -->
 * <DistributorIdentity variant="inline" surface="dark" />
 *
 * <!-- Card body on a light page: name, registration, ARN validity, RIA note -->
 * <DistributorIdentity variant="block" surface="light" />
 */
import {
  REGISTERED_NAME,
  ARN,
  ARN_VALID_UNTIL,
  TAGLINE,
  AMFI_VERIFY_URL,
} from '../../lib/distributor';
import { formatDate } from '../../lib/format';

interface Props {
  /** inline: one identity line (footer). block: stacked details (cards). */
  variant?: 'inline' | 'block';
  /** Background the component sits on; text colours differ per surface. */
  surface: 'light' | 'dark';
  /** Additional CSS classes */
  class?: string;
}

const { variant = 'inline', surface, class: className = '' } = Astro.props;

// Approved surface pairs (docs/style_spec.md §1): muted on light, muted-inv/subtle on dark.
const tone = {
  light: { primary: 'text-fi-ink', secondary: 'text-fi-muted', link: 'text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link' },
  dark: { primary: 'text-fi-muted-inv', secondary: 'text-fi-subtle', link: 'text-fi-muted-inv underline decoration-fi-subtle hover:text-fi-ink-inv transition-colors' },
}[surface];
---

{variant === 'inline' ? (
  <div class:list={['text-body-sm', className]}>
    <!-- AMFI's search opens empty, so the label names the ARN to type in. -->
    <p class={tone.primary}>
      {REGISTERED_NAME} · {TAGLINE} · {ARN} ·
      <a href={AMFI_VERIFY_URL} target="_blank" rel="noopener noreferrer" class:list={[tone.link, 'whitespace-nowrap']}>Verify {ARN} on AMFI ↗</a>
    </p>
  </div>
) : (
  <div class:list={['text-body-sm', className]}>
    <p class:list={[tone.primary, 'font-semibold']}>{REGISTERED_NAME}</p>
    <p class={tone.primary}>{TAGLINE}</p>
    <p class:list={[tone.secondary, 'mb-3']}>{ARN} · valid to {formatDate(ARN_VALID_UNTIL, 'short')}</p>
    <p class:list={[tone.secondary, 'leading-relaxed']}>We are not a SEBI-registered investment adviser.</p>
  </div>
)}
