---
/**
 * Section Component
 *
 * A layout component for consistent section spacing and backgrounds.
 *
 * @example
 * <!-- Default white section with large spacing -->
 * <Section>
 *   <h2>Section Content</h2>
 * </Section>
 *
 * <!-- Cream background with custom max-width -->
 * <Section background="cream" maxWidth="lg">
 *   <p>Narrower content area</p>
 * </Section>
 *
 * <!-- Navy section with small spacing -->
 * <Section background="navy" spacing="sm">
 *   <p>Dark section with less padding</p>
 * </Section>
 *
 * <!-- Dark content section with the hero's gold glow (style_spec §10) -->
 * <Section background="dark" glow>…</Section>
 */

interface Props {
  /** Anchor id for in-page links (e.g. /invest/#review) */
  id?: string;
  /** Background color variant */
  background?: 'white' | 'light' | 'dark';
  /** Vertical padding (spacing) */
  spacing?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  /** Maximum width of inner container */
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'full';
  /** Additional CSS classes for section */
  class?: string;
  /** Additional CSS classes for container */
  containerClass?: string;
  /** The hero's faint gold glow behind the content; dark sections only */
  glow?: boolean;
}

const {
  id,
  background = 'white',
  spacing = 'lg',
  maxWidth = 'xl',
  class: className = '',
  containerClass = '',
  glow = false,
} = Astro.props;

const showGlow = glow && background === 'dark';

// Background styles
const backgroundStyles = {
  white: 'bg-white',
  light: 'bg-fi-light',
  dark:  'bg-fi-dark text-fi-ink-inv',
};

// Spacing styles (vertical padding)
const spacingStyles = {
  none: '',
  sm: 'py-12 md:py-16',
  md: 'py-16 md:py-24',
  lg: 'py-20 md:py-32',
  xl: 'py-32 md:py-40',
};

// Max width styles
const maxWidthStyles = {
  sm: 'max-w-3xl',
  md: 'max-w-4xl',
  lg: 'max-w-5xl',
  xl: 'max-w-6xl',
  '2xl': 'max-w-7xl',
  'full': 'max-w-full',
};

// Combined classes
const sectionClasses = `${backgroundStyles[background]} ${spacingStyles[spacing]} px-4 sm:px-6 lg:px-10 ${showGlow ? 'relative overflow-hidden' : ''} ${className}`.trim();
const containerClasses = `${maxWidthStyles[maxWidth]} mx-auto ${showGlow ? 'relative' : ''} ${containerClass}`.trim();
---

<section id={id} class={sectionClasses}>
  {showGlow && <div class="fi-section-glow pointer-events-none" aria-hidden="true"></div>}
  <div class={containerClasses}>
    <slot />
  </div>
</section>

<style>
  /* Same treatment as Hero.astro's .fi-hero-glow (fi-gold at 8%), placed at the top edge. */
  .fi-section-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 45% at 50% 0%, rgba(251, 191, 36, 0.08) 0%, transparent 60%);
  }
</style>
