---
/**
 * FaqList Component
 *
 * Questions and answers as native <details> rows: no script, keyboard
 * accessible, and every answer is in the page for search engines. The first
 * row starts open so the visitor sees how the list works. Light surfaces only.
 *
 * @example
 * import { investFaq } from '../lib/faq';
 * <FaqList items={investFaq} />
 *
 * @param items - [{ question, answer }]
 * @param class - extra classes for the wrapper
 */
import type { FaqItem } from '../../lib/faq';

interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['max-w-3xl mx-auto border-b border-fi-border text-left', className]}>
  {items.map((item, index) => (
    <details class="group border-t border-fi-border" open={index === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-sm py-5 text-body-md font-semibold text-fi-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fi-link [&::-webkit-details-marker]:hidden">
        {item.question}
        <span class="text-heading-sm leading-none text-fi-link transition-transform duration-200 group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">+</span>
      </summary>
      <p class="pb-5 max-w-fi-content text-body-sm leading-relaxed text-fi-muted">{item.answer}</p>
    </details>
  ))}
</div>
