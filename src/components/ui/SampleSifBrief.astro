---
/**
 * SampleSifBrief Component
 *
 * An illustrative SIF fit assessment card, shown as a white document on the
 * dark /invest/sif/ hero (matching SampleBrief.astro's visual language). It
 * previews what a client receives in writing: portfolio-fit checks and a
 * side-by-side comparison across fund houses before deciding on a ₹10 lakh+
 * allocation.
 *
 * Compliance guardrails (SIF promotional page — R-10, R-22, H-04, H-05, H-15):
 *   - names no fund house, SIF brand, or SEBI strategy category name
 *   - shows no returns, yields, or commission rates
 *   - labelled "Sample" with the H-15 made-up data notice in the caption
 *
 * @example
 * <SampleSifBrief />
 * <SampleSifBrief surface="light" />
 *
 * @param surface - 'dark' (default) or 'light': back sheet, shadow and caption colour
 * @param class - extra classes for the figure
 */
import Badge from './Badge.astro';

interface Props {
  surface?: 'dark' | 'light';
  class?: string;
}

const { surface = 'dark', class: className = '' } = Astro.props;

const fitChecks = [
  { value: '11%', note: 'Portfolio share if ₹10 lakh is added to ₹80 lakh in existing funds' },
  { value: '38%', note: 'Illustrative stock overlap between Strategy A and current equity funds' },
  { value: '15 days', note: 'Notice period on Strategy A; ₹10 lakh PAN breach buffer flagged' },
] as const;

const comparisonRows = [
  { metric: 'SEBI Risk-Band', a: 'Band 4', b: 'Band 5' },
  { metric: 'Short exposure', a: 'Equity', b: 'Equity + debt' },
  { metric: 'Redemption', a: 'Set days · 15d notice', b: 'Daily · exit load' },
  { metric: 'Tax structure', a: 'Per asset mix', b: 'Per asset mix' },
  { metric: 'Commission', a: 'In writing', b: 'In writing' },
] as const;

const look = {
  dark: { sheet: 'bg-fi-mid border-fi-border-dark', shadow: 'shadow-fi-card-dark', caption: 'text-fi-subtle' },
  light: { sheet: 'bg-fi-border border-fi-border', shadow: 'shadow-fi-card', caption: 'text-fi-muted' },
}[surface];
---

<figure class:list={['w-full max-w-lg mx-auto', className]}>
  <div class="relative">
    <div class:list={['absolute inset-0 rounded-xl border rotate-3 translate-x-2 translate-y-1.5', look.sheet]} aria-hidden="true"></div>

    <div class:list={['relative rounded-xl bg-white text-fi-ink text-left p-5 sm:p-6 transition-transform duration-300 hover:-translate-y-1', look.shadow]}>
      <div class="flex items-center justify-between gap-3">
        <p class="text-body-lg font-bold leading-snug">SIF fit assessment</p>
        <Badge size="sm" rounded={false} class="shrink-0">Sample</Badge>
      </div>
      <p class="mt-2 text-body-sm text-fi-muted tabular-nums">Illustrative portfolio · ₹80 lakh existing MFs · ₹10 lakh SIF check</p>

      <div class="mt-4 border-t border-dashed border-fi-border pt-4">
        <p class="font-mono text-caption uppercase text-fi-muted mb-3">Example fit findings</p>
        <ul role="list" class="space-y-2.5">
          {fitChecks.map((item) => (
            <li class="flex items-baseline gap-3">
              <span class="w-16 shrink-0 text-heading-sm font-bold text-fi-ink tabular-nums whitespace-nowrap">{item.value}</span>
              <span class="text-body-sm text-fi-muted leading-snug text-pretty">{item.note}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-4 border-t border-dashed border-fi-border pt-4">
        <div
          tabindex="0"
          role="region"
          aria-labelledby="sif-sample-shortlist-caption"
          class="overflow-x-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fi-link rounded-sm"
        >
          <table class="w-full text-left border-collapse text-body-sm">
            <caption
              id="sif-sample-shortlist-caption"
              class="caption-top text-left font-mono text-caption uppercase text-fi-muted mb-3"
            >
              Cross-fund-house shortlist
            </caption>
            <thead>
              <tr class="border-b border-fi-border text-body-sm font-semibold text-fi-muted">
                <th scope="col" class="pb-2 pr-2 font-semibold text-balance">Check</th>
                <th scope="col" class="pb-2 px-2 font-semibold text-balance">Strategy A</th>
                <th scope="col" class="pb-2 pl-2 font-semibold text-balance">Strategy B</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-fi-border">
              {comparisonRows.map((row) => (
                <tr>
                  <th scope="row" class="py-2 pr-2 font-medium text-fi-ink">{row.metric}</th>
                  <td class="py-2 px-2 text-fi-muted tabular-nums">{row.a}</td>
                  <td class="py-2 pl-2 text-fi-muted tabular-nums">{row.b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-4 border-t border-dashed border-fi-border pt-4">
        <p class="text-body-sm text-fi-muted text-pretty">
          <strong class="font-semibold text-fi-ink">Example verdict:</strong> Strategy A overlaps heavily with current equity holdings; Strategy B adds lower overlap at a higher risk band. Trade-offs and commission are shared in writing before you decide.
        </p>
      </div>
    </div>
  </div>
  <figcaption class:list={['mt-6 text-body-sm text-center text-pretty', look.caption]}>
    Illustration with made-up data. Not a real fund or recommendation.
  </figcaption>
</figure>
