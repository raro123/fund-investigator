---
/**
 * Credentials Component
 *
 * The investigator shows their credentials: a "Credentials" folder tab
 * (FolderTab, like the report cards and the subscribe card) on a card holding
 * a typed record in the report cards' style (mono label, mono value, dashed
 * rules): the AMFI tagline, the ARN with a link to verify it on AMFI, and the
 * fund houses we are empanelled with. The verify link turns the claim into
 * evidence anyone can check. Values come from src/lib/distributor.ts.
 *
 * - default: no owner name (the homepage's privacy rule); the footer carries
 *   the full disclosure
 * - `detailed`: for service pages, where the name may appear: adds the
 *   investigator's name with "Read our story", the ARN's validity, and the
 *   contact email
 *
 * @example
 * <Credentials class="max-w-lg mx-auto" />                       <!-- homepage hero -->
 * <Credentials surface="light" detailed class="max-w-2xl mx-auto" />  <!-- /invest/ -->
 *
 * @param surface - 'dark' (default: fi-mid card, gold links) or 'light' (white card, fi-link)
 * @param detailed - add the name, the ARN's validity and the contact email
 * @param class - extra classes for the wrapper, e.g. width
 */
import FolderTab from './FolderTab.astro';
import {
  AMFI_VERIFY_URL,
  ARN,
  ARN_VALID_UNTIL,
  CONTACT_EMAIL,
  EMPANELMENT,
  REGISTERED_NAME,
  TAGLINE,
} from '../../lib/distributor';
import { formatDate } from '../../lib/format';

interface Props {
  surface?: 'dark' | 'light';
  detailed?: boolean;
  class?: string;
}

const { surface = 'dark', detailed = false, class: className = '' } = Astro.props;

// One class set per surface; gold links only on dark (style_spec §1).
const tone = {
  dark: {
    card: 'bg-fi-mid border-fi-border-dark',
    rule: 'divide-fi-border-dark',
    label: 'text-fi-subtle',
    value: 'text-fi-ink-inv',
    link: 'text-fi-gold decoration-fi-gold/40 hover:text-fi-gold-hover hover:decoration-fi-gold-hover',
  },
  light: {
    card: 'bg-white border-fi-border shadow-fi-card',
    rule: 'divide-fi-border',
    label: 'text-fi-muted',
    value: 'text-fi-ink',
    link: 'text-fi-link decoration-fi-link/40 hover:decoration-fi-link',
  },
}[surface];

const linkClass = ['whitespace-nowrap underline underline-offset-4 transition-colors', tone.link];

// The label already says "ARN", so the value is the number alone.
const arnNumber = ARN.replace(/^ARN-/, '');
---

<div class:list={['flex flex-col text-left', className]}>
  <FolderTab surface={surface}>Credentials</FolderTab>
  <div class:list={['rounded-lg rounded-tl-none border px-5 py-4 sm:px-6', tone.card]}>
    <!-- Label above value on phones, side by side from sm, as on the report cards. -->
    <dl class:list={['divide-y divide-dashed font-mono text-body-sm leading-snug', tone.rule]}>
      {detailed && (
        <div class="grid gap-x-3 gap-y-0.5 py-2.5 first:pt-0 sm:grid-cols-fi-record">
          <dt class:list={['text-caption uppercase pt-0.5', tone.label]}>Investigator</dt>
          <dd class={tone.value}>
            {REGISTERED_NAME} · <a href="/about/" class:list={linkClass}>Read our story →</a>
          </dd>
        </div>
      )}
      <div class="grid gap-x-3 gap-y-0.5 py-2.5 first:pt-0 sm:grid-cols-fi-record">
        <dt class:list={['text-caption uppercase pt-0.5', tone.label]}>Registered</dt>
        <dd class={tone.value}>{TAGLINE}</dd>
      </div>
      <div class="grid gap-x-3 gap-y-0.5 py-2.5 sm:grid-cols-fi-record">
        <dt class:list={['text-caption uppercase pt-0.5', tone.label]}>ARN</dt>
        <dd class:list={[tone.value, 'tabular-nums']}>
          {arnNumber} ·
          {detailed && <><span class="whitespace-nowrap">valid to {formatDate(ARN_VALID_UNTIL, 'short')}</span> · </>}
          <!-- AMFI's search opens empty, so the accessible name gives the ARN to type in. -->
          <a href={AMFI_VERIFY_URL} target="_blank" rel="noopener noreferrer" aria-label={`Verify ${ARN} on AMFI (opens in a new tab)`} class:list={linkClass}>Verify on AMFI ↗</a>
        </dd>
      </div>
      <div class="grid gap-x-3 gap-y-0.5 py-2.5 last:pb-0 sm:grid-cols-fi-record">
        <dt class:list={['text-caption uppercase pt-0.5', tone.label]}>Empanelled</dt>
        <dd class={tone.value}>{EMPANELMENT}</dd>
      </div>
      {detailed && (
        <div class="grid gap-x-3 gap-y-0.5 py-2.5 last:pb-0 sm:grid-cols-fi-record">
          <dt class:list={['text-caption uppercase pt-0.5', tone.label]}>Contact</dt>
          <dd><a href={`mailto:${CONTACT_EMAIL}`} class:list={linkClass}>{CONTACT_EMAIL}</a></dd>
        </div>
      )}
    </dl>
  </div>
</div>
