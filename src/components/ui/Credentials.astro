---
/**
 * Credentials Component
 *
 * The investigator shows their credentials: a dark card with a "Credentials"
 * folder tab (FolderTab, like the report cards and the subscribe card) and a
 * typed record in the report cards' style (mono label, mono value, dashed
 * rules): the AMFI tagline, the ARN with a link to verify it on AMFI, and the
 * fund houses we are empanelled with. The verify link turns the claim into
 * evidence anyone can check. Values come from src/lib/distributor.ts. No
 * owner name (homepage privacy); the footer carries the full disclosure.
 * Dark surfaces only (gold link).
 *
 * @example
 * <Credentials class="max-w-lg mx-auto" />
 *
 * @param class - extra classes for the wrapper, e.g. width
 */
import FolderTab from './FolderTab.astro';
import { AMFI_VERIFY_URL, ARN, EMPANELMENT, TAGLINE } from '../../lib/distributor';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// The label already says "ARN", so the value is the number alone.
const arnNumber = ARN.replace(/^ARN-/, '');
---

<div class:list={['flex flex-col text-left', className]}>
  <FolderTab surface="dark">Credentials</FolderTab>
  <div class="rounded-lg rounded-tl-none border border-fi-border-dark bg-fi-mid px-5 py-4 sm:px-6">
    <!-- Label above value on phones, side by side from sm, as on the report cards. -->
    <dl class="divide-y divide-dashed divide-fi-border-dark font-mono text-body-sm leading-snug">
      <div class="grid gap-x-3 gap-y-0.5 py-2.5 first:pt-0 sm:grid-cols-fi-record">
        <dt class="text-caption uppercase text-fi-subtle pt-0.5">Registered</dt>
        <dd class="text-fi-ink-inv">{TAGLINE}</dd>
      </div>
      <div class="grid gap-x-3 gap-y-0.5 py-2.5 sm:grid-cols-fi-record">
        <dt class="text-caption uppercase text-fi-subtle pt-0.5">ARN</dt>
        <dd class="text-fi-ink-inv tabular-nums">
          {arnNumber} ·
          <!-- AMFI's search opens empty, so the link names the ARN to type in. -->
          <a href={AMFI_VERIFY_URL} target="_blank" rel="noopener noreferrer" aria-label={`Verify ${ARN} on AMFI (opens in a new tab)`} class="whitespace-nowrap text-fi-gold underline decoration-fi-gold/40 underline-offset-4 transition-colors hover:text-fi-gold-hover hover:decoration-fi-gold-hover">Verify on AMFI ↗</a>
        </dd>
      </div>
      <div class="grid gap-x-3 gap-y-0.5 py-2.5 last:pb-0 sm:grid-cols-fi-record">
        <dt class="text-caption uppercase text-fi-subtle pt-0.5">Empanelled</dt>
        <dd class="text-fi-ink-inv">{EMPANELMENT}</dd>
      </div>
    </dl>
  </div>
</div>
