---
import {
  reportCategoryLabel,
  type ReportCategory,
} from '../../lib/report-categories';
import { formatDate } from '../../lib/format';

interface Props {
  published: string;
  updated?: string;
  readTime: string;
  category?: ReportCategory;
  status?: 'current' | 'archived';
}

const { published, updated, readTime, category, status = 'current' } = Astro.props;
const showUpdated = Boolean(updated && updated !== published);
const displayDate = showUpdated && updated ? updated : published;
const displayReadTime = readTime.replace(/\s+read$/i, '');
---

<div class="border-t border-fi-gold pt-5 text-sm">
    <dl class="flex flex-wrap items-baseline gap-x-3 gap-y-2" aria-label="Article details">
      <div class="inline-flex items-baseline gap-1.5">
        <dt class="text-fi-subtle">{showUpdated ? 'Last updated' : 'Published'}</dt>
        <dd class="font-semibold text-fi-muted-inv">
          <time datetime={displayDate}>{formatDate(displayDate)}</time>
        </dd>
      </div>
      <div class="inline-flex items-baseline gap-1.5">
        <dt class="sr-only">Reading time</dt>
        <dd class="font-semibold text-fi-muted-inv"><span aria-hidden="true" class="mr-3 text-fi-subtle">·</span>{displayReadTime} read</dd>
      </div>
      {category && (
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="sr-only">Category</dt>
          <dd class="font-semibold text-fi-muted-inv"><span aria-hidden="true" class="mr-3 text-fi-subtle">·</span>{reportCategoryLabel(category)}</dd>
        </div>
      )}
      {status === 'archived' && (
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="sr-only">Status</dt>
          <dd class="font-semibold text-fi-muted-inv"><span aria-hidden="true" class="mr-3 text-fi-subtle">·</span>Historical</dd>
        </div>
      )}
    </dl>

    <dl class="mt-3" aria-label="Article byline">
      <div class="inline-flex items-baseline gap-1.5 whitespace-nowrap">
        <dt class="text-fi-subtle">By</dt>
        <dd>
          <a
            href="/about/"
            class="rounded-sm font-semibold text-fi-muted-inv transition-colors hover:text-fi-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fi-gold focus-visible:ring-offset-2 focus-visible:ring-offset-fi-dark"
          >Fund Investigator</a>
        </dd>
      </div>
    </dl>
</div>
