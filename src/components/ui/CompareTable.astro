---
/**
 * CompareTable Component
 *
 * A small comparison of two to four products, row by row (for example SIF,
 * PMS and AIF on /invest/sif/). From `md` it is a real table, with the row
 * names as row headers. Below `md` each product becomes its own card with the
 * same rows, so phones never scroll sideways. `highlight` marks the column we
 * offer with a top border, not with colour alone. Light surfaces only.
 *
 * @example
 * <CompareTable
 *   caption="SIF, PMS and AIF compared"
 *   columns={['SIF', 'PMS', 'AIF']}
 *   rows={[{ name: 'Minimum', cells: ['₹10 lakh', '₹50 lakh', '₹1 crore'] }]}
 *   note="Sources: …"
 *   highlight={0}
 * />
 *
 * @param caption - table caption (screen readers; shown above the phone cards)
 * @param columns - product names, in display order
 * @param rows - [{ name, cells }]; `cells` has one entry per column
 * @param note - optional sources line under the table
 * @param highlight - optional index of the column to mark
 * @param class - extra classes for the wrapper
 */
interface Row {
  name: string;
  cells: string[];
}

interface Props {
  caption: string;
  columns: string[];
  rows: Row[];
  note?: string;
  highlight?: number;
  class?: string;
}

const { caption, columns, rows, note, highlight, class: className = '' } = Astro.props;

for (const row of rows) {
  if (row.cells.length !== columns.length) {
    throw new Error(`CompareTable "${caption}": row "${row.name}" has ${row.cells.length} cells for ${columns.length} columns`);
  }
}

const marked = (index: number) => index === highlight;
---

<div class:list={['text-left', className]}>
  <table class="hidden md:table w-full border-collapse bg-white border border-fi-border rounded-lg overflow-hidden">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="border-b border-fi-border">
        <td class="p-4"></td>
        {columns.map((column, index) => (
          <th scope="col" class:list={['p-4 text-body-md font-bold text-fi-ink align-bottom', marked(index) && 'border-t-4 border-t-fi-ink']}>{column}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-b border-fi-border last:border-b-0">
          <th scope="row" class="p-4 text-caption uppercase tracking-fi-label font-bold text-fi-muted align-top w-40">{row.name}</th>
          {row.cells.map((cell) => (
            <td class="p-4 text-body-sm text-fi-ink leading-relaxed align-top">{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

  <div class="md:hidden space-y-4">
    {columns.map((column, index) => (
      <section class:list={['bg-white border border-fi-border rounded-lg p-5', marked(index) && 'border-t-4 border-t-fi-ink']} aria-label={`${caption}: ${column}`}>
        <h3 class="text-body-lg font-bold text-fi-ink mb-3">{column}</h3>
        <dl class="space-y-3">
          {rows.map((row) => (
            <div>
              <dt class="text-caption uppercase tracking-fi-label font-bold text-fi-muted">{row.name}</dt>
              <dd class="text-body-sm text-fi-ink leading-relaxed">{row.cells[index]}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>

  {note && <p class="mt-4 text-caption text-fi-muted leading-relaxed">{note}</p>}
</div>
