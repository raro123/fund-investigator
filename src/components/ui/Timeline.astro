---
/**
 * Timeline Component
 *
 * An ordered list of steps joined by a line. Vertical below `lg`, so phones
 * never scroll sideways; horizontal from `lg`. The list order carries the
 * sequence, so there are no "Step 1, 2…" labels (log #70).
 *
 * @example
 * <Timeline steps={[
 *   { title: 'Book a review call', body: 'Pick a time.', icon: '<circle cx="12" cy="12" r="9"/>' },
 *   { title: 'First conversation', body: 'We discuss your goals.', icon: '…' },
 * ]} />
 *
 * @param steps - Each step's heading, one-line body and inner SVG markup
 *   (24×24 viewBox, stroked) for the marker icon.
 */

interface Step {
  title: string;
  body: string;
  /** Inner SVG markup for the marker icon (24×24 viewBox, stroked) */
  icon: string;
}

interface Props {
  steps: Step[];
  /** Additional CSS classes */
  class?: string;
}

const { steps, class: className = '' } = Astro.props;

// The grid needs a literal class per column count so Tailwind can see it.
const desktopColumns: Record<number, string> = {
  3: 'lg:grid-cols-3',
  4: 'lg:grid-cols-4',
  5: 'lg:grid-cols-5',
  6: 'lg:grid-cols-6',
};
---

<ol class:list={['grid gap-8 lg:gap-0 max-w-xl lg:max-w-none mx-auto', desktopColumns[steps.length], className]}>
  {steps.map((step, index) => (
    <li class="relative flex gap-5 lg:flex-col lg:items-center lg:text-center lg:gap-0 lg:px-3">
      {/* Connector to the next marker: runs down below lg, across from lg. */}
      {index < steps.length - 1 && (
        <span
          class="absolute bg-fi-border w-0.5 left-5 top-11 -bottom-8 lg:w-full lg:h-0.5 lg:left-1/2 lg:top-5 lg:bottom-auto"
          aria-hidden="true"
        ></span>
      )}
      <span class="relative z-10 shrink-0 w-fi-icon-lg h-fi-icon-lg rounded-full bg-fi-dark text-fi-gold flex items-center justify-center">
        <svg class="w-fi-icon h-fi-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={step.icon} />
      </span>
      <div class="lg:mt-5">
        <h3 class="text-heading-sm font-bold text-fi-ink mb-1">{step.title}</h3>
        <p class="text-body-sm text-fi-muted leading-relaxed">{step.body}</p>
      </div>
    </li>
  ))}
</ol>
