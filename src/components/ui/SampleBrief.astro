---
/**
 * SampleBrief Component
 *
 * A sample brief, shown as a white document on a dark hero. It previews what
 * a client receives after the first call: their mix against a target, and
 * headline points in plain words. Dark surfaces by default (homepage hero);
 * pass `surface="light"` on a white or fi-light section (portfolio review page).
 *
 * Two variants:
 *   - `review` (default): a portfolio review, for existing investors (homepage,
 *     /invest/portfolio-review/)
 *   - `start`: a starting brief, for savings moving into mutual funds
 *     (/invest/start-investing-mutual-funds/). Never called a "plan" ("financial planning"
 *     is a legal limit, content guide).
 *
 * Compliance guardrails (these pages promote the service):
 *   - names no fund and shows no returns or projections
 *   - labelled "Sample", with an example profile and no client name
 *
 * @example
 * <SampleBrief />
 * <SampleBrief variant="start" />
 * <SampleBrief surface="light" />
 *
 * @param variant - 'review' (default) or 'start'
 * @param surface - 'dark' (default) or 'light': the back sheet, shadow and caption colour
 * @param class - extra classes for the figure
 */

interface Props {
  variant?: 'review' | 'start';
  surface?: 'dark' | 'light';
  class?: string;
}

import Badge from './Badge.astro';

const { variant = 'review', surface = 'dark', class: className = '' } = Astro.props;

// Illustrative values only. Each mix sums to 100.
// Each point reads as one plain sentence: the value, then what it means.
// Metric names (overlap, benchmark, expense ratio) stay out of the text,
// because the client does not need the term to act on the point.
// Review: correlation is left out: most Indian equity funds move together
// (0.9+), so it is not a finding on its own, and overlap already shows the cause.
// Review copy from the agreed portfolio review demo (owner, 9 Nov 2026): no age
// or risk label (open question T-115), overlap "by weight", sector overlap in
// place of a benchmark claim (H-17 wants "its stated benchmark index").
// The summary line states the gap only, as an example, not advice.
// Start: the points describe the process (a safety net, few funds, investing in
// stages), never a return.
const briefs = {
  review: {
    title: 'Portfolio review',
    profile: 'Illustrative portfolio · 5 funds',
    mixLabel: 'Current mix against an example target',
    mixes: [
      { label: 'Current', equity: 82, debt: 14, gold: 4 },
      { label: 'Target', equity: 65, debt: 28, gold: 7 },
    ],
    pointsLabel: 'Example findings',
    points: [
      { value: '41%', text: 'of the stocks in the three equity funds overlap, by weight' },
      { value: '32%', text: 'of the money invested in stocks is in financial services' },
      { value: '1.6%', text: 'in yearly fund costs, on average' },
    ],
    caption: 'Illustrative portfolio review brief.',
  },
  start: {
    title: 'Starting brief',
    profile: 'Age 31 · ₹15 lakh to invest · 7-year goal',
    mixLabel: 'Investment mix, after the emergency reserve',
    mixes: [
      { label: 'Target', equity: 60, debt: 30, gold: 10 },
    ],
    pointsLabel: 'How you start',
    points: [
      { value: '6 months', text: 'of expenses held separately for emergencies' },
      { value: '3 funds', text: 'for this example goal and risk profile' },
      { value: '12 months', text: 'to invest in stages in this example' },
    ],
    caption: 'Illustrative starting brief. ₹15 lakh is not a minimum; the reserve, fund count and timing are examples, not requirements.',
  },
} as const;

const { title, profile, mixLabel, mixes, pointsLabel, points, caption } = briefs[variant];

// The value column fits the longest value, so the sentences start in one line.
const valueWidth = { review: 'w-16', start: 'w-28' }[variant];

// Back sheet, shadow and caption follow the surface the brief sits on.
const look = {
  dark: { sheet: 'bg-fi-mid border-fi-border-dark', shadow: 'shadow-fi-card-dark', caption: 'text-fi-subtle' },
  light: { sheet: 'bg-fi-border border-fi-border', shadow: 'shadow-fi-card', caption: 'text-fi-muted' },
}[surface];

const assetClasses = [
  { key: 'equity', name: 'Equity', fill: 'bg-fi-mid' },
  { key: 'debt', name: 'Debt', fill: 'bg-fi-link' },
  { key: 'gold', name: 'Gold', fill: 'bg-fi-gold' },
] as const;

// Segment widths are data, not design values, so they are set inline below.
// A 0% segment is left out: its padding and border would still show a sliver.
// A segment shows its name only when wide enough to fit it, and its value
// only when wide enough for the number; the key below names every colour.
// On phones a 10–19% segment is too narrow for its number (14% of a 320px bar
// is about 23px), so below sm no segment carries text: one line under each bar
// gives every value ("82% equity · 14% debt · 4% gold"), as in demo v32. From sm
// the numbers sit in the segments. The aria-label has them all.
const segmentText = (name: string, value: number) =>
  value >= 20 ? `${name} ${value}%` : value >= 10 ? `${value}%` : '';
// Each value stays whole: on the narrowest phones the line breaks between values.
const mixParts = (mix: Record<string, number>) =>
  assetClasses.filter(({ key }) => mix[key] > 0).map(({ key, name }) => `${mix[key]}% ${name.toLowerCase()}`);
---

<figure class:list={['w-full max-w-lg mx-auto', className]}>
  <div class="relative">
    <!-- Second sheet behind, so the card reads as a document -->
    <div class:list={['absolute inset-0 rounded-xl border rotate-3 translate-x-2 translate-y-1.5', look.sheet]} aria-hidden="true"></div>

    <div class:list={['relative rounded-xl bg-white text-fi-ink text-left p-5 sm:p-6 transition-transform duration-300 hover:-translate-y-1', look.shadow]}>
      <!-- A quiet "Sample" box, not a stamp: it must say "this is an example" without
           pulling the eye from the brief. It shares the title's row; the profile runs full
           width below, so it stays on one line. -->
      <div class="flex items-center justify-between gap-3">
        <p class="text-body-lg font-bold leading-snug">{title}</p>
        <Badge size="sm" rounded={false} class="shrink-0">Sample</Badge>
      </div>
      <p class="mt-2 text-body-sm text-fi-muted tabular-nums">{profile}</p>

      <div class="mt-4 border-t border-dashed border-fi-border pt-4">
        <p class="font-mono text-caption uppercase text-fi-muted mb-3">{mixLabel}</p>
        <div class="space-y-2">
          {mixes.map((mix) => (
            <div class="flex items-start gap-2">
              <span class="w-16 shrink-0 text-body-sm leading-6 text-fi-muted">{mix.label}</span>
              <div class="flex-1 min-w-0">
                <div
                  class="flex h-6 overflow-hidden rounded-md bg-fi-light"
                  role="img"
                  aria-label={`${mix.label}: equity ${mix.equity}%, debt ${mix.debt}%, gold ${mix.gold}%`}
                >
                  {assetClasses.filter(({ key }) => mix[key] > 0).map(({ key, name, fill }) => (
                    <span class:list={['flex items-center overflow-hidden pl-2 border-r-2 border-white last:border-r-0', fill]} style={`width: ${mix[key]}%`}>
                      <span class="hidden sm:inline whitespace-nowrap text-xs font-semibold text-white tabular-nums">{key === 'gold' ? '' : segmentText(name, mix[key])}</span>
                    </span>
                  ))}
                </div>
                <p class="sm:hidden mt-1 text-xs text-fi-muted tabular-nums" aria-hidden="true">
                  {mixParts(mix).map((part, i) => <span class="whitespace-nowrap">{i > 0 && ' · '}{part}</span>)}
                </p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-3 flex gap-4 text-xs text-fi-muted" aria-hidden="true">
          {assetClasses.map(({ name, fill }) => (
            <span class="inline-flex items-center gap-1.5"><span class:list={['w-2.5 h-2.5 rounded-sm', fill]}></span>{name}</span>
          ))}
        </div>
      </div>

      <div class="mt-4 border-t border-dashed border-fi-border pt-4">
        <p class="font-mono text-caption uppercase text-fi-muted mb-3">{pointsLabel}</p>
        <ul class="space-y-2.5">
          {points.map((point) => (
            <li class="flex items-baseline gap-3">
              <span class:list={[valueWidth, 'shrink-0 text-heading-sm tabular-nums whitespace-nowrap']}>{point.value}</span>
              <span class="text-body-sm">{point.text}</span>
            </li>
          ))}
        </ul>
      </div>
      {variant === 'review' && (
        <div class="mt-4 border-t border-dashed border-fi-border pt-4">
          <p class="text-body-sm text-fi-muted">In this example, the share invested in stocks is 17 percentage points above the target.</p>
        </div>
      )}
    </div>
  </div>
  <figcaption class:list={['mt-6 text-body-sm text-center', look.caption]}>
    {caption}
  </figcaption>
</figure>
