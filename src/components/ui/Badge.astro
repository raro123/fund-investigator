---
/**
 * Badge Component
 *
 * A small label component for categories, tags, and status indicators.
 *
 * @example
 * <!-- Default cream badge -->
 * <Badge>Fund Analysis</Badge>
 *
 * <!-- Primary navy badge -->
 * <Badge variant="primary">Active</Badge>
 *
 * <!-- Success badge -->
 * <Badge variant="success" size="sm">Completed</Badge>
 */

interface Props {
  /** Badge color variant */
  variant?: 'default' | 'dark' | 'primary' | 'success' | 'error';
  /** Badge size */
  size?: 'sm' | 'md' | 'lg';
  /** Use rounded corners instead of pill shape */
  rounded?: boolean;
  /** Additional CSS classes */
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  rounded = true,
  class: className = '',
} = Astro.props;

// Variant styles
const variantStyles = {
  default:   'bg-white border border-fi-border text-fi-muted',            // light sections (white or fi-light)
  dark:      'bg-fi-mid border border-fi-border-dark text-fi-muted-inv',  // dark sections
  primary:   'bg-fi-dark text-fi-ink-inv',
  success:   'bg-white border border-fi-positive/30 text-fi-positive',    // light sections only
  error:     'bg-white border border-fi-negative/30 text-fi-negative',    // light sections only
};

// Size styles
const sizeStyles = {
  sm: 'px-2 py-0.5 text-caption',
  md: 'px-3 py-1.5 text-caption',
  lg: 'px-4 py-1.5 text-xs',
};

// Border radius
const roundedStyles = rounded ? 'rounded-full' : 'rounded';

// Base styles — uppercase + tracking per spec
const baseStyles = 'inline-block font-bold uppercase tracking-fi-label';

// Combined classes
const classes = `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${roundedStyles} ${className}`.trim();
---

<span class={classes}>
  <slot />
</span>
