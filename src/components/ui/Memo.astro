---
/**
 * Memo Component
 *
 * A short typed note: a mono label over a dashed rule, a bold sans title, then
 * the body typed in Courier Prime and an optional typed sign-off at the bottom
 * right. For a fact the reader should see in writing, such as how we are paid.
 * No paper clip: the homepage keeps one clipped sheet (the "Your case" Dossier).
 * Light surfaces only.
 *
 * Put `data-reveal` on the memo (or a wrapper). When it reveals on scroll
 * (Layout.astro), a `Highlight` in the body draws in. Memos visible at load,
 * and readers who prefer reduced motion, see it finished.
 *
 * @example
 * <Memo label="Memo · Our fee" title="No separate fee from you." signoff="Fund Investigator · ARN-370951">
 *   Our commission is … We disclose it <Highlight>in writing</Highlight>.
 * </Memo>
 *
 * @param label - mono caption at the top, e.g. 'Memo · Our fee'
 * @param title - the one-line point of the memo
 * @param signoff - optional typed sign-off, e.g. the registered name and ARN
 * @param class - extra classes for the memo
 */

interface Props {
  label: string;
  title: string;
  signoff?: string;
  class?: string;
}

const { label, title, signoff, class: className = '' } = Astro.props;
---

<article class:list={['mx-auto max-w-2xl rounded-lg border border-fi-border bg-white shadow-fi-card px-6 pt-7 pb-6 lg:px-10 lg:pt-8 lg:pb-8 text-left', className]}>
  <p class="font-mono text-caption uppercase text-fi-muted pb-3 mb-5 border-b border-dashed border-fi-border">{label}</p>
  <h3 class="text-heading-sm font-bold text-fi-ink mb-3">{title}</h3>
  <div class="font-typewriter text-body-md sm:text-body-lg text-fi-ink leading-relaxed">
    <slot />
  </div>
  {signoff && <p class="mt-6 text-right font-typewriter text-body-sm text-fi-muted">&mdash; {signoff}</p>}
</article>
