---
/**
 * Memo Component
 *
 * A short typed note clipped to the page: a grey (fi-muted) paper clip over
 * the top edge, like metal, so gold stays for the highlight and the booking
 * button. Then a mono label over a dashed rule, a bold sans title, then the body typed in Courier Prime
 * and an optional typed sign-off at the bottom right. For a fact the reader
 * should see in writing, such as how we are paid. Light surfaces only.
 *
 * Put `data-reveal` on the memo (or a wrapper). When it reveals on scroll
 * (Layout.astro), a `Highlight` in the body draws in and the clip slides on.
 * Memos visible at load, and readers who prefer reduced motion, see it finished.
 *
 * @example
 * <Memo label="Memo · Our fee" title="No separate fee from you." signoff="Fund Investigator · ARN-370951">
 *   Our commission is … We disclose it <Highlight>in writing</Highlight>.
 * </Memo>
 *
 * @param label - mono caption at the top, e.g. 'Memo · Our fee'
 * @param title - the one-line point of the memo
 * @param signoff - optional typed sign-off, e.g. the registered name and ARN
 * @param class - extra classes for the memo
 */

interface Props {
  label: string;
  title: string;
  signoff?: string;
  class?: string;
}

const { label, title, signoff, class: className = '' } = Astro.props;
---

<article class:list={['relative mx-auto max-w-2xl rounded-lg border border-fi-border bg-white shadow-fi-card px-6 pt-9 pb-6 lg:px-10 lg:pt-10 lg:pb-8 text-left', className]}>
  <!-- The clip sits over the top edge, half on the paper and half off. -->
  <svg class="fi-clip absolute -top-6 left-8 w-6 h-12 text-fi-muted" fill="none" stroke="currentColor" viewBox="0 0 24 56" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M17 18v24a5 5 0 0 1-10 0V12a8 8 0 0 1 16 0v30a11 11 0 0 1-22 0V20" />
  </svg>

  <p class="font-mono text-caption uppercase text-fi-muted pb-3 mb-5 border-b border-dashed border-fi-border">{label}</p>
  <h3 class="text-heading-sm font-bold text-fi-ink mb-3">{title}</h3>
  <div class="font-typewriter text-body-md sm:text-body-lg text-fi-ink leading-relaxed">
    <slot />
  </div>
  {signoff && <p class="mt-6 text-right font-typewriter text-body-sm text-fi-muted">&mdash; {signoff}</p>}
</article>

<style>
  /* After the memo rises (fi-rise, 0.65s) and its highlight draws (0.4s), the clip slides on. */
  :global(.animate-fi-rise) .fi-clip {
    animation: fi-clip 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) 1s backwards;
  }

  @keyframes fi-clip {
    from { opacity: 0; transform: translateY(-14px) rotate(-12deg); }
  }
</style>
