---
/**
 * ProblemAnswer Component
 *
 * Rows of paired cards on a light surface: a flat problem card, an arrow, and a
 * raised white answer card. The answer always carries more weight than the
 * problem. Stacks vertically (arrow pointing down) below md.
 *
 * Each side renders one of two densities:
 *   - short: no `title` → the tag is the heading, `body` is one line (homepage)
 *   - long:  `title` set → the tag is a small lead-in above the title (/invest/)
 *
 * @example
 * import { shortPairs } from '../lib/who-we-help';
 * <ProblemAnswer pairs={shortPairs} reveal />
 *
 * @param pairs - [{ problem: { icon, tag, title?, body }, answer: { … } }]
 * @param reveal - mark each row for the reveal-on-scroll animation (Layout.astro)
 * @param class - extra classes for the wrapper
 */

export interface ProblemAnswerSide {
  /** SVG inner markup on a 24×24 stroke grid */
  icon: string;
  /** Short name; the heading in the short version, a lead-in in the long one */
  tag: string;
  /** Optional headline; switches the side to the long version */
  title?: string;
  body: string;
}

interface Props {
  pairs: { problem: ProblemAnswerSide; answer: ProblemAnswerSide }[];
  reveal?: boolean;
  class?: string;
}

const { pairs, reveal = false, class: className = '' } = Astro.props;

const cardBase = 'rounded-lg border border-fi-border p-6 lg:p-8';
const cardStyles = {
  problem: `${cardBase} bg-transparent`,
  answer: `${cardBase} bg-white shadow-fi-card`,
};
const iconColour = { problem: 'text-fi-muted', answer: 'text-fi-link' };
const shortHeading = {
  problem: 'text-body-lg font-semibold text-fi-muted',
  answer: 'text-heading-sm text-fi-ink',
};
---

<div class:list={['grid gap-5', className]}>
  {pairs.map((pair, rowIndex) => (
    <div class="grid gap-2 md:grid-cols-fi-pair md:gap-0" data-reveal={reveal ? rowIndex : undefined}>
      {(['problem', 'answer'] as const).map((role) => {
        const side = pair[role];
        const icon = (size: string) => (
          <svg class:list={[size, 'shrink-0', iconColour[role]]} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={side.icon} />
        );
        return (
          <Fragment>
            {role === 'answer' && (
              <div class="flex items-center justify-center text-fi-link" aria-hidden="true">
                <svg class="w-5 h-5 rotate-90 md:rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </div>
            )}
            <article class={cardStyles[role]}>
              {side.title ? (
                <Fragment>
                  <p class:list={['flex items-center gap-2 text-body-sm font-semibold mb-3', iconColour[role]]}>{icon('w-5 h-5')}{side.tag}</p>
                  <h3 class="text-heading-sm text-fi-ink mb-3">{side.title}</h3>
                </Fragment>
              ) : (
                <h3 class:list={['flex items-center gap-2.5 leading-snug mb-2', shortHeading[role]]}>{icon('w-fi-icon h-fi-icon')}{side.tag}</h3>
              )}
              <p class="text-body-sm text-fi-muted leading-relaxed">{side.body}</p>
            </article>
          </Fragment>
        );
      })}
    </div>
  ))}
</div>
