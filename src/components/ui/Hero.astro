---
/**
 * Hero Component
 *
 * A specialized section component for page headers and hero sections.
 *
 * @example
 * <!-- Default centered hero -->
 * <Hero>
 *   <h1 class="text-display-md mb-4">Page Title</h1>
 *   <p class="text-body-lg">Subtitle or description</p>
 * </Hero>
 *
 * <!-- Small hero with cream background -->
 * <Hero size="sm" background="cream">
 *   <h1>Compact Header</h1>
 * </Hero>
 *
 * <!-- Left-aligned hero -->
 * <Hero centered={false}>
 *   <h1>Left-Aligned Title</h1>
 *   <p>Supporting text</p>
 * </Hero>
 */

interface Props {
  /** Hero height variant */
  size?: 'sm' | 'md' | 'lg' | 'xl';
  /** Center align content */
  centered?: boolean;
  /** Background color variant */
  background?: 'white' | 'light' | 'dark';
  /** Additional CSS classes for section */
  class?: string;
  /** Additional CSS classes for container */
  containerClass?: string;
}

const {
  size = 'lg',
  centered = true,
  background = 'white',
  class: className = '',
  containerClass = '',
} = Astro.props;

// Size styles (vertical padding) — responsive: smaller on mobile, larger on desktop
const sizeStyles = {
  sm: 'pt-24 pb-12 md:pt-28 md:pb-16',
  md: 'pt-28 pb-16 md:pt-36 md:pb-24',
  // Top padding includes the fixed header's height, so bottom is smaller in
  // value but optically balanced against it.
  lg: 'pt-28 pb-12 md:pt-36 md:pb-16 lg:pt-44 lg:pb-20',
  // For a hero with little content that must match the height of a fuller
  // hero (the homepage against /invest/). Same header offset as lg.
  xl: 'pt-52 pb-36 md:pt-52 md:pb-40 lg:pt-60 lg:pb-56',
};

// Background styles
const backgroundStyles = {
  white: 'bg-white',
  light: 'bg-fi-light',
  dark:  'bg-fi-dark text-fi-ink-inv',
};

// Alignment styles
const alignStyles = centered ? 'text-center' : '';

// Combined classes
const sectionClasses = `relative overflow-hidden ${backgroundStyles[background]} ${sizeStyles[size]} px-4 sm:px-6 lg:px-10 ${className}`.trim();
const containerClasses = `relative z-10 max-w-5xl mx-auto min-w-0 max-w-full ${alignStyles} ${containerClass}`.trim();
---

<section class={sectionClasses}>
  {background === 'dark' && <div class="fi-hero-glow pointer-events-none" aria-hidden="true"></div>}
  <div class={containerClasses}>
    <slot />
  </div>
</section>

<style>
  /* Warm atmosphere behind the headline, so dark heroes read as editorial, not as a dev template.
     Centred because the heroes are stacked and centred; spec: style_spec.md §10. */
  .fi-hero-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 30%, rgba(251, 191, 36, 0.08) 0%, transparent 55%);
  }
</style>
