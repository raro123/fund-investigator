---
/**
 * RiskDisclosures Component
 *
 * The mandatory warnings for every product we promote, in one quiet card above
 * the footer on every page: AMFI's mutual-fund warning and SEBI's SIF warning
 * (COM-015), one paragraph each. Placed by Layout.astro, so no page adds or
 * drops it, and never under each button (owner review, 2026-10-19).
 *
 * The wording comes from `src/lib/distributor.ts` and cannot be passed in, so
 * no page can reword a regulator's text. No links: the fuller notes are on
 * /disclosures/, linked from the footer.
 *
 * @example
 * <RiskDisclosures />
 */
import Section from './Section.astro';
import { RISK_WARNING, SIF_WARNING } from '../../lib/distributor';
---

<Section background="light" spacing="xs" class="border-t border-fi-border">
  <aside class="rounded-lg border border-dashed border-fi-border bg-white px-6 py-4 text-left" aria-label="Risk disclosures">
    <p class="font-mono text-caption uppercase text-fi-muted pb-2 mb-3 border-b border-dashed border-fi-border">Risk disclosures</p>
    <div class="space-y-2 text-body-sm leading-relaxed text-fi-ink">
      <p>{RISK_WARNING}</p>
      <p>{SIF_WARNING}</p>
    </div>
  </aside>
</Section>
