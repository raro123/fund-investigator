---
import SubscribeForm from './ui/SubscribeForm.astro';
import { responsive } from '../lib/responsive';

interface Props {
  action: string;
  method?: 'GET' | 'POST';
  emailFieldName?: string;
  hiddenFields?: Record<string, string>;
}

const {
  action,
  method = 'POST',
  emailFieldName = 'email',
  hiddenFields = {},
} = Astro.props;
---

<button
  type="button"
  class="text-fi-gold underline decoration-fi-gold/50 transition-opacity hover:opacity-80"
  data-guide-signup-trigger
  aria-haspopup="dialog"
  aria-controls="guide-signup-modal"
>
  Start with our first five checks
</button>

<div
  id="guide-signup-modal"
  class="fixed inset-0 z-fi-overlay hidden items-center justify-center bg-fi-dark/80 px-4 py-6 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="guide-signup-title"
  data-guide-signup-modal
>
  <button
    type="button"
    class="absolute inset-0 cursor-default"
    aria-label="Close beginner guide signup"
    data-guide-signup-backdrop
  ></button>

  <div class="relative z-10 w-full max-w-lg rounded-lg border border-fi-border bg-white p-6 shadow-fi-card sm:p-8">
    <button
      type="button"
      class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-fi-btn border border-fi-border text-fi-muted transition-colors hover:border-fi-gold hover:text-fi-ink focus:outline-none focus:ring-2 focus:ring-fi-gold/30"
      aria-label="Close beginner guide signup"
      data-guide-signup-close
    >
      <svg class="h-fi-icon w-fi-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-6 pr-10">
      <p class="mb-3 text-caption font-bold uppercase tracking-widest text-fi-gold">The Five Checks</p>
      <h2 id="guide-signup-title" class:list={[responsive.h3, 'font-bold text-fi-ink']}>
        Where every investigation starts
      </h2>
      <p class="mt-3 text-body-md leading-relaxed text-fi-muted">
        Before we deep-dive a fund, these five checks tell us if it's worth the time. The guide illustrates each with examples.
      </p>
    </div>

    <!-- The checks are listed before the form: the reader sees what they are
         getting before handing over an email. -->
    <ol class="mb-6 space-y-2.5 border-t border-fi-border pt-5">
      {[
        'Did it beat a fair benchmark?',
        'Was it consistent, or one lucky year?',
        'Did the extra return justify the extra risk?',
        'How far did it fall when the market turned?',
        'How long did it take to recover?',
      ].map((check, i) => (
        <li class="flex items-start gap-3 text-body-sm text-fi-muted">
          <span class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-fi-icon-bg text-caption font-bold text-fi-ink tabular-nums">
            {i + 1}
          </span>
          {check}
        </li>
      ))}
    </ol>

    <SubscribeForm
      action={action}
      method={method}
      emailFieldName={emailFieldName}
      inputId="guide-signup-email"
      hiddenFields={hiddenFields}
      ajaxSubmit
      successMessage="Thanks — the link is on its way to your inbox."
      successHref="/reports/five-checks-mutual-fund/"
      successLinkText="Or read it now"
      errorMessage="We could not add that email. Please try again."
      placeholder="your@email.com"
      buttonText="Send Me the Five Checks"
      formClass="sm:flex-col"
    />
  </div>
</div>

<script>
  const trigger = document.querySelector('[data-guide-signup-trigger]');
  const modal = document.querySelector('[data-guide-signup-modal]');
  const closeButton = document.querySelector('[data-guide-signup-close]');
  const backdrop = document.querySelector('[data-guide-signup-backdrop]');
  const emailInput = document.querySelector('#guide-signup-email');

  if (
    trigger instanceof HTMLElement &&
    modal instanceof HTMLElement &&
    closeButton instanceof HTMLElement &&
    backdrop instanceof HTMLElement
  ) {
    let lastFocusedElement = null;

    const openModal = () => {
      lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';

      window.setTimeout(() => {
        if (emailInput instanceof HTMLInputElement) {
          emailInput.focus();
        } else {
          closeButton.focus();
        }
      }, 0);
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocusedElement?.focus();
    };

    trigger.addEventListener('click', openModal);
    closeButton.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }
</script>
