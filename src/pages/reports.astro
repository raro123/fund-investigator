---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ui/Hero.astro';
import ReportCard from '../components/ReportCard.astro';
import { getCollection } from 'astro:content';
import { responsive } from '../lib/responsive';

const allReports = await getCollection('reports');
const sortedReports = allReports
  .filter(report => !report.id.startsWith('_'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// value → display label, in display order (source of truth for labels/order)
const categoryLabels: Record<string, string> = {
  'Fund Analysis': 'Fund Analysis',
  'Category Comparison': 'Comparisons',
  'Methodology': 'Methodology',
};

// Only surface categories that actually have reports (no dead pills)
const presentCategories = new Set(sortedReports.map(report => report.data.category));
const filterTabs = [
  { label: 'All Files', value: 'all' },
  ...Object.entries(categoryLabels)
    .filter(([value]) => presentCategories.has(value))
    .map(([value, label]) => ({ label, value })),
];

// Hide the filter strip until there's more than one real category to choose between
const showFilters = presentCategories.size > 1;
---

<Layout title="Investigation Reports - Fund Investigator" description="Fact-based analysis of mutual funds and investment categories.">

  <!-- Single Hero section: clears fixed header, owns all vertical rhythm -->
  <Hero size="sm" background="dark" centered={false} containerClass="max-w-6xl mx-auto">

    <!-- Title block: centered -->
    <div class="text-center mb-10 md:mb-12">
      <h1 class:list={[responsive.h2Large, 'font-bold text-fi-ink-inv mb-6 break-words']}>
        The Investigation Archive
      </h1>
      <p class="text-body-md text-fi-muted-inv leading-relaxed max-w-2xl mx-auto">
        Fact-based analysis of mutual funds and investment categories. Evidence before opinion. No marketing fluff, just the raw data and our verdict.
      </p>
    </div>

    <!-- Category pill strip: single row, horizontal scroll, edge-fade cue -->
    {showFilters && (
      <div class="relative mb-10">
        <div
          class="flex gap-2 overflow-x-auto scrollbar-hide pb-1 pr-10"
          role="group"
          aria-label="Filter reports by category"
        >
          {filterTabs.map((tab, i) => (
            <button
              class:list={[
                'filter-btn flex-shrink-0 whitespace-nowrap rounded-full px-4 py-2',
                'text-caption uppercase tracking-widest transition-all duration-200',
                'bg-fi-icon-bg-inv text-fi-muted-inv hover:text-fi-ink-inv',
                'data-[active=true]:bg-fi-gold data-[active=true]:text-fi-dark',
                'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fi-gold',
              ]}
              data-filter={tab.value}
              data-active={i === 0 ? 'true' : 'false'}
            >
              {tab.label}
            </button>
          ))}
        </div>
        <!-- right-edge fade: signals more chips without a raw scrollbar -->
        <div class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-fi-dark to-transparent"></div>
      </div>
    )}

    <!-- Card grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" id="reports-grid">
      {sortedReports.map((report) => (
        <div
          class="report-item"
          data-category={report.data.category}
        >
          <ReportCard report={report} href={`/reports/${report.slug}/`} />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden py-16 text-center">
      <p class="text-heading-sm font-semibold text-fi-ink-inv mb-2">No investigations in this category yet.</p>
      <p class="text-body-md text-fi-muted-inv">Check back soon — more are in progress.</p>
    </div>

  </Hero>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.report-item');
    const emptyState = document.getElementById('empty-state');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => (b.dataset.active = 'false'));
        btn.dataset.active = 'true';

        const filter = btn.getAttribute('data-filter') ?? 'all';
        let visible = 0;

        items.forEach(item => {
          const match = filter === 'all' || item.getAttribute('data-category') === filter;
          item.classList.toggle('hidden', !match);
          if (match) visible++;
        });

        if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
      });
    });
  });
</script>
