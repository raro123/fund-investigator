---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ui/Hero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import SplitRows from '../components/ui/SplitRows.astro';
import StepMemos from '../components/ui/StepMemos.astro';
import Memo from '../components/ui/Memo.astro';
import Highlight from '../components/ui/Highlight.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FaqList from '../components/ui/FaqList.astro';
import { investFaqGroups } from '../lib/faq';
import { responsive } from '../lib/responsive';
import { trackAttrs } from '../lib/analytics';
import { whatsappUrl, type WhatsappPlacement } from '../lib/whatsapp';
import Credentials from '../components/ui/Credentials.astro';
import { BOOKING_URL } from '../lib/distributor';

// This page names no fund, so it may link to booking and WhatsApp (handoff §2, Links).
// Every contact button is tracked: Zoho and WhatsApp report no placement back.
const booking = (placement: string) => ({
  href: BOOKING_URL,
  target: '_blank' as const,
  rel: 'noopener noreferrer',
  icon: 'external' as const,
  track: { event: 'review_booking_click' as const, placement },
});
const whatsapp = (placement: WhatsappPlacement) => ({
  href: whatsappUrl(placement),
  target: '_blank' as const,
  rel: 'noopener noreferrer',
  icon: 'whatsapp' as const,
  track: { event: 'conversation_request' as const, placement, channel: 'whatsapp' },
});

// What happens after you book, in four steps: we listen, we analyse, we explain,
// we support. Plain investing words, no detective terms. Each fact line answers
// the reader's worry at that step: cost and pressure, opinion or numbers, control,
// what ongoing help costs. "No extra fee", never "no fee": the fund house pays our
// commission from the expense ratio (legal limit, as the fee memo's "No separate
// fee"). Booking is not a step (the buttons cover it; the reply time sits under
// the buttons below). No approval method is named (OTP, email link, e-mandate),
// as on the homepage. Our commission is in writing before the client chooses
// (step 03): the disclosure rule.
const steps = [
  {
    title: 'We listen',
    body: 'We get to know you and your goals, and explain how we work. Then you decide whether to work with us.',
    fact: 'No charge · No obligation',
  },
  {
    title: 'We analyse',
    // "Funds", not "options": options are derivatives in investing. SIF and GIFT City
    // minimums are in the FAQ below.
    body: 'We analyse your goals, risk profile and any funds you already hold, then shortlist suitable funds.',
    fact: 'Backed by the numbers',
  },
  {
    title: 'We explain',
    body: 'We walk you through the written brief. We explain the evidence for any changes, discuss the alternatives and disclose our commission in writing.',
    fact: 'You decide, you approve',
  },
  {
    title: 'We support',
    body: 'We set up your investments; you approve and pay the fund house directly. We review your portfolio at agreed intervals.',
    fact: 'No extra fee for support',
  },
];

// Direct vs regular: the same fund bought two ways. The right column promotes
// what we do; the left stays fair fact (no fear). The cost row keeps "No
// separate fee" with the commission explanation (legal limit).
const routes = [
  {
    name: 'Cost',
    left: 'Lower yearly expense ratio. No commission.',
    right: 'Higher yearly expense ratio. The fund house pays our commission from it. No separate fee from you.',
  },
  {
    name: 'Choosing funds',
    left: 'You research and shortlist on your own.',
    right: 'We shortlist funds that fit your goals, with the reasons and the alternatives. Our commission in writing.',
  },
  {
    name: 'Transactions',
    left: 'You place each one on a platform.',
    right: 'We handle the admin, from KYC to each SIP, with your approval.',
  },
  {
    name: 'Reviews',
    left: 'You track benchmarks, overlap and costs yourself.',
    right: 'We check your funds against fair benchmarks, for overlap and for costs, at regular intervals.',
  },
  {
    name: 'When markets fall',
    left: 'You decide on your own.',
    right: 'You talk to a person before you act.',
  },
  {
    name: 'Suits',
    left: 'Investors with the time and interest to manage their own funds.',
    right: 'Investors who want an expert to check and help, from a first SIP to a large portfolio.',
  },
];

const callDetails = '30-minute call · No charge · No obligation';
const ctaRow = 'flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 w-full max-w-80 sm:max-w-none mx-auto';
const lightLink = 'font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link';
---

<Layout
  title="Invest with support - Fund Investigator"
  description="How investing with support works: a 30-minute first call, a portfolio review, and help to choose and invest in mutual funds, SIFs and GIFT City funds."
  trackView="invest_view"
>
  <!-- 1. Hero: short, because most visitors come from the homepage pitch; the header still brings cold visitors, so the main action stays here -->
  <Hero size="md" background="dark">
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-8 leading-fi-display tracking-fi-display break-words max-w-4xl mx-auto']}>
      We do the investigation.
      <span class="block text-fi-gold">You make the call.</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed']}>
      We help you choose your funds, and we explain their risk, suitability and costs. Then we review them with you at regular intervals.
    </p>

    <div class="flex flex-col items-center gap-4 mt-10">
      <div class={ctaRow}>
        <Button {...booking('invest_hero')} size="lg">Book a first call</Button>
        <Button {...whatsapp('invest_hero')} variant="secondary" surface="dark" size="lg">Contact on WhatsApp</Button>
      </div>
      <p class="text-body-sm text-fi-subtle">{callDetails}</p>
    </div>
  </Hero>

  <!-- 2. The journey comes straight after the hero: most visitors arrive from the homepage to
       learn how it works. The situation route cards were removed (2026-10-19): they sent warm
       visitors away before the answer; the footer and the sitemap link the landing pages.
       Preserve the invest_review placements so earlier analytics stay comparable. -->
  <Section id="how-it-works" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="What happens after you book." lead="We do the work to help you invest. Every decision stays with you." />
    <StepMemos steps={steps} />

    <div class:list={[ctaRow, 'mt-12']}>
      <Button {...booking('invest_review')} size="lg">Book a first call</Button>
      <Button {...whatsapp('invest_review')} variant="secondary" surface="light" size="lg">Contact on WhatsApp</Button>
    </div>
    <p class="mt-4 text-center text-body-sm text-fi-muted">We confirm your booking at once, and reply on WhatsApp within 1 business day.</p>
  </Section>

  <!-- 3. Direct vs regular, then the booking: the comparison answers the cost question, so the
       action follows at once. Owns #costs (the /about/ "See the costs" link lands here). Under the
       buttons, the light Credentials card: the person (service pages may name them), the
       registration with the ARN to verify on AMFI, and the email. The full story stays on /about/. -->
  <Section id="costs" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Same fund. More support." lead="Every fund has a direct plan and a regular plan. Here we compare managing a direct plan yourself with a regular plan through us. Direct investors can also separately pay a registered investment adviser." />
    <SplitRows
      rows={routes}
      rowLabel=""
      columns={[{ label: 'DIY direct plan', short: 'DIY direct' }, { label: 'Regular plan, with us', short: 'With us' }]}
      emphasis="right"
    />
    <!-- The note for direct-plan holders, as a typed memo addressed to them: it is the main
         reassurance for this group, and something we would put in writing. One highlight, on
         the reassurance itself. -->
    <div data-reveal={0} class="mt-10">
      <Memo label="For direct-plan investors" title="Already in direct plans, but want an expert opinion?">
        We discuss them on the first call and review the details after you share your holdings. <Highlight>You can keep them direct</Highlight>. If you invest through us, we can only use regular plans. Nothing moves without your approval.
      </Memo>
    </div>

    <div class="text-center mt-14">
      <div class={ctaRow}>
        <Button {...booking('invest_cta')} size="lg">Book a first call</Button>
        <Button {...whatsapp('invest_cta')} variant="secondary" surface="light" size="lg">Contact on WhatsApp</Button>
      </div>
    </div>
    <Credentials surface="light" detailed class="mt-10 mx-auto w-full max-w-2xl" />
  </Section>

  <!-- 4. FAQ last: it is reference material and will grow. The WhatsApp line gives the page an action at its end. -->
  <Section id="faq" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions before you start" />
    <div class="space-y-10">
      {investFaqGroups.map((group, index) => (
        <div class="max-w-3xl mx-auto text-left">
          <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{group.title}</h3>
          <FaqList items={group.items} openFirst={index === 0} />
        </div>
      ))}
    </div>
    <p class="text-center text-body-sm text-fi-muted mt-10">
      Another question?
      <a href={whatsappUrl('invest_faq')} target="_blank" rel="noopener noreferrer" class={lightLink} {...trackAttrs('conversation_request', 'invest_faq', 'whatsapp')}>Ask us on WhatsApp ↗</a>
    </p>
  </Section>

</Layout>
