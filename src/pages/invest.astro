---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ui/Hero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import SplitRows from '../components/ui/SplitRows.astro';
import DistributorIdentity from '../components/ui/DistributorIdentity.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FaqList from '../components/ui/FaqList.astro';
import { services } from '../lib/services';
import { products } from '../lib/products';
import { investFaqGroups } from '../lib/faq';
import { responsive } from '../lib/responsive';
import { trackAttrs } from '../lib/analytics';
import { whatsappUrl, type WhatsappPlacement } from '../lib/whatsapp';
import { BOOKING_URL, CONTACT_EMAIL, FIRST_NAME } from '../lib/distributor';

// This page names no fund, so it may link to booking and WhatsApp (handoff §2, Links).
// Every contact button is tracked: Zoho and WhatsApp report no placement back.
const booking = (placement: string) => ({
  href: BOOKING_URL,
  target: '_blank' as const,
  rel: 'noopener noreferrer',
  icon: 'external' as const,
  track: { event: 'review_booking_click' as const, placement },
});
const whatsapp = (placement: WhatsappPlacement) => ({
  href: whatsappUrl(placement),
  target: '_blank' as const,
  rel: 'noopener noreferrer',
  icon: 'external' as const,
  track: { event: 'conversation_request' as const, placement, channel: 'whatsapp' },
});

// One client journey: what the client does beside what we do, at each stage.
// Each cell continues its column label ("You" pick a time, "We" reply…), so no
// cell repeats the label.
// Stages 3–6 take the service names from src/lib/services.ts, so this page and
// the homepage cards use the same words. Timings are agreed on the call.
const [review, curation, execution, ongoing] = services;
const journey = [
  {
    name: 'Book a call',
    left: 'Pick a time, or message us on WhatsApp.',
    right: 'Confirm your booking at once. Reply on WhatsApp within 1 business day.',
  },
  {
    name: 'The first call',
    left: 'Tell us your goals, your time frame and your risk profile.',
    right: 'Look at the funds you hold. New to funds? Explain the main categories, and SIP or lump sum.',
  },
  {
    name: review.title,
    left: 'Share your Consolidated Account Statement (CAS) after the call.',
    right: 'Help you download your CAS. Check suitability, benchmark, overlap and costs. Then send you a short brief.',
  },
  {
    name: curation.title,
    left: 'Decide what to keep and what to buy. Nothing moves without your approval.',
    right: 'Shortlist suitable funds, with the reasons, the alternatives and our commission in writing.',
  },
  {
    name: execution.title,
    left: 'Approve each transaction by OTP. Pay the fund house directly.',
    right: 'Handle KYC, SIPs and lump sums.',
  },
  {
    name: ongoing.title,
    left: 'Tell us when your plans change.',
    right: 'Review your funds at regular intervals. Help with rebalancing, SIP changes, switches and redemptions.',
  },
];

// Direct vs regular: the same fund bought two ways. The right column promotes
// what we do; the left stays fair fact (no fear). The cost row keeps "No
// separate fee" with the commission explanation (legal limit).
const routes = [
  {
    name: 'Cost',
    left: 'Lower yearly expense ratio. No commission.',
    right: 'Higher yearly expense ratio. The fund house pays our commission from it. No separate fee from you.',
  },
  {
    name: 'Choosing funds',
    left: 'You research and shortlist on your own.',
    right: 'We shortlist funds that fit your goals, with the reasons and the alternatives. Our commission in writing.',
  },
  {
    name: 'Transactions',
    left: 'You place each one on a platform.',
    right: 'We do the setup, from KYC to each SIP. You approve each one by OTP.',
  },
  {
    name: 'Reviews',
    left: 'You track benchmarks, overlap and costs yourself.',
    right: 'We check your funds against fair benchmarks, for overlap and for costs, at regular intervals.',
  },
  {
    name: 'When markets fall',
    left: 'You decide on your own.',
    right: 'You talk to a person before you act.',
  },
  {
    name: 'Suits',
    left: 'Investors with the time and interest to manage their own funds.',
    right: 'Investors who want an expert to check and help, from a first SIP to a large portfolio.',
  },
];

// Each product is shown by fit, not as a catalogue (src/lib/products.ts).
const productFacts = [
  { label: 'Suits', key: 'suits' },
  { label: 'Minimum', key: 'minimum' },
  { label: 'Main risk', key: 'mainRisk' },
] as const;

const callDetails = '30-minute first call · No charge for the call · No obligation';
const ctaRow = 'flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 w-full max-w-80 sm:max-w-none mx-auto';
const lightLink = 'font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link';
---

<Layout
  title="Invest with support - Fund Investigator"
  description="How investing with support works: a 30-minute first call, a portfolio review, and help to choose and invest in mutual funds, SIFs and GIFT City funds."
  trackView="invest_view"
>
  <!-- 1. Hero: short, because most visitors come from the homepage pitch; the header still brings cold visitors, so the main action stays here -->
  <Hero size="md" background="dark">
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-8 leading-fi-display tracking-fi-display break-words max-w-4xl mx-auto']}>
      We do the investigation.
      <span class="block text-fi-gold">You make the call.</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed']}>
      We help you choose your funds, and we explain their risk, suitability and costs. Then we review them with you at regular intervals.
    </p>

    <div class="flex flex-col items-center gap-4 mt-10">
      <div class={ctaRow}>
        <Button {...booking('invest_hero')} size="lg">Book a first call</Button>
        <Button {...whatsapp('invest_hero')} variant="secondary" surface="dark" size="lg">Contact on WhatsApp</Button>
      </div>
      <p class="text-body-sm text-fi-subtle">{callDetails}</p>
    </div>
  </Hero>

  <!-- 2. Client journey: You beside We at each stage, so every row repeats the hero promise.
       Placements keep the "invest_review" name so earlier analytics stay comparable. -->
  <Section id="how-it-works" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="From the first call to every review." lead="What you do, and what we do, at each stage." />
    <SplitRows rows={journey} rowLabel="Stage" columns={[{ label: 'You' }, { label: 'We' }]} numbered />

    <div class:list={[ctaRow, 'mt-12']}>
      <Button {...booking('invest_review')} size="lg">Book a first call</Button>
      <Button {...whatsapp('invest_review')} variant="secondary" surface="light" size="lg">Contact on WhatsApp</Button>
    </div>
  </Section>

  <!-- 3. Products: what clients can invest in, each framed by fit. No buttons: the reader is still learning. -->
  <Section id="products" background="light" spacing="md" maxWidth="2xl">
    <SectionHeading title="What you can invest in." lead="Most clients start with mutual funds. We discuss SIFs and GIFT City funds only when your amount and risk profile suit them." />
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 text-left">
      {products.map((product) => (
        <li>
          <Card padding="lg" hover={false} class="h-full">
            <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{product.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed mb-5">{product.intro}</p>
            <dl class="space-y-3 text-body-sm leading-relaxed">
              {productFacts.map((fact) => (
                <div>
                  <dt class="font-semibold text-fi-ink">{fact.label}</dt>
                  <dd class="text-fi-muted">{product[fact.key]}</dd>
                </div>
              ))}
            </dl>
          </Card>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 4. Direct vs regular: the cost question, answered with what the client gets. Owns #costs
       (the /about/ "See the costs" link lands here). -->
  <Section id="costs" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Same fund. More support." lead="Every fund has a direct plan and a regular plan. Here is what the regular plan gets you with us." />
    <SplitRows
      rows={routes}
      rowLabel=""
      columns={[{ label: 'Direct plan, on your own', short: 'Direct' }, { label: 'Regular plan, with us', short: 'With us' }]}
      emphasis="right"
    />
    <p class="max-w-3xl mx-auto text-center text-body-sm text-fi-muted leading-relaxed mt-8">
      Already in direct plans? We review them on the first call. You keep them direct if you prefer. Nothing moves without your approval.
      <a href="/disclaimer/#distribution" class={lightLink}>Full disclosures →</a>
    </p>
  </Section>

  <!-- 5. Ready to start? The registration sits next to the buttons: the last check before a booking. -->
  <Section background="light" spacing="md" maxWidth="sm">
    <div class="text-center">
      <SectionHeading
        title="Ready to start?"
        lead="Booking confirms your time at once. On WhatsApp, we reply within 1 business day. We never ask for KYC documents, statements or passwords on WhatsApp."
        class="lg:mb-10"
      />
      <Card padding="md" hover={false} class="max-w-md mx-auto text-left mb-10">
        <h3 class="text-heading-sm font-bold text-fi-ink mb-3">Our registration</h3>
        <DistributorIdentity variant="block" surface="light" />
      </Card>
      <div class={ctaRow}>
        <Button {...booking('invest_cta')} size="lg">Book a first call</Button>
        <Button {...whatsapp('invest_cta')} variant="secondary" surface="light" size="lg">Contact on WhatsApp</Button>
      </div>
      <p class="text-body-sm text-fi-muted mt-6">
        Prefer email? <a href={`mailto:${CONTACT_EMAIL}`} class={lightLink}>{CONTACT_EMAIL}</a>
      </p>
      <p class="text-body-sm text-fi-muted mt-3">
        You work with {FIRST_NAME}, from the first call to every review. <a href="/about/" class={lightLink}>About {FIRST_NAME} →</a>
      </p>
    </div>
  </Section>

  <!-- 6. FAQ last: it is reference material and will grow. The WhatsApp line gives the page an action at its end. -->
  <Section id="faq" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions before you start" />
    <div class="space-y-10">
      {investFaqGroups.map((group, index) => (
        <div class="max-w-3xl mx-auto text-left">
          <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{group.title}</h3>
          <FaqList items={group.items} openFirst={index === 0} />
        </div>
      ))}
    </div>
    <p class="text-center text-body-sm text-fi-muted mt-10">
      Another question?
      <a href={whatsappUrl('invest_faq')} target="_blank" rel="noopener noreferrer" class={lightLink} {...trackAttrs('conversation_request', 'invest_faq', 'whatsapp')}>Ask us on WhatsApp ↗</a>
    </p>
  </Section>

</Layout>
