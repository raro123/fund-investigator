---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/ui/Hero.astro';
import { responsive } from '../lib/responsive';
---

<Layout
  title="Terms of Service - Fund Investigator"
  description="Terms of Service for Fund Investigator"
>
  <Hero size="sm" centered={false}>
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink mb-4 leading-tight']}>
      Terms of Service
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted']}>
      Last updated: January 2, 2026
    </p>
  </Hero>

  <Section background="white" spacing="md" maxWidth="md">
    <div class="prose prose-lg max-w-none text-fi-muted space-y-8">

      <section class="space-y-4">
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mb-6']}>1. Acceptance of Terms</h2>
        <p>
          By accessing and using Fund Investigator, you accept and agree to be bound by the terms and provisions of this agreement.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mt-12 mb-6']}>2. Use of Service</h2>
        <p>
          Fund Investigator provides analytical tools and information about mutual funds. The service is provided for informational purposes only and does not constitute financial advice.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mt-12 mb-6']}>3. Data and Information</h2>
        <p>
          All fund data is sourced from AMFI (Association of Mutual Funds in India). While we strive for accuracy, we make no warranties about the completeness, reliability, or accuracy of this information.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mt-12 mb-6']}>4. Disclaimer</h2>
        <p>
          The analysis and metrics provided are for informational purposes only. They should not be considered as investment advice or recommendations. Past performance does not guarantee future results.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mt-12 mb-6']}>5. Limitation of Liability</h2>
        <p>
          Fund Investigator shall not be liable for any investment decisions made based on the information provided through this service.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mt-12 mb-6']}>6. Changes to Terms</h2>
        <p>
          We reserve the right to modify these terms at any time. Continued use of the service after changes constitutes acceptance of the modified terms.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mt-12 mb-6']}>7. Contact</h2>
        <p>
          For questions about these Terms of Service, please contact us at <a href="mailto:contact@fundinvestigator.com" class="text-fi-ink hover:text-fi-gold font-medium">contact@fundinvestigator.com</a>
        </p>
      </section>

    </div>
  </Section>
</Layout>
