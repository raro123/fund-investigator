---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import ReportCard from '../components/ReportCard.astro';
import DeepdiveSnapshot from '../components/DeepdiveSnapshot.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/ui/Hero.astro';
import { getCollection } from 'astro:content';
import { responsive } from '../lib/responsive';
import { HOME_DESCRIPTION, HOME_TITLE, homeSchemaGraph } from '../lib/schema';
import { substackWelcomeUrl } from '../lib/substack';
import { deepdiveUrl } from '../lib/deepdive';
import { ARN, BOOKING_URL, TAGLINE } from '../lib/distributor';
import { whatsappUrl } from '../lib/whatsapp';

// Featured by slug, not "latest": only guides whose card text names no fund may
// sit on a page that promotes the service (handoff §2, Links). Replace these
// with the decision guides once they are published (log #74).
const featuredGuideSlugs = ['five-checks-mutual-fund', 'mutual-fund-categories-explained'];
const allReports = await getCollection('reports');
const featuredGuides = featuredGuideSlugs
  .map((slug) => allReports.find((report) => report.slug === slug))
  .filter((report) => report !== undefined);

// Each "Who we help" card states one part of the heading, in order; the
// matching "How we help" card answers it (handoff §4).
const situations = [
  {
    title: 'Looking to invest, but not sure how?',
    body: 'You want to invest, but there are thousands of funds. You do not know which of them suit your goals and your risk profile, or how to start.',
  },
  {
    title: 'Many funds, little clarity?',
    body: 'Your funds may hold the same stocks. You cannot easily tell how they perform, or how your money is spread across equity, debt and gold.',
  },
  {
    title: 'Invested, but alone when markets move?',
    body: 'No one follows up after you invest. When markets rise or fall, you have no one to look at the facts with before you act.',
  },
];

const services = [
  {
    title: 'Evidence-backed fund selection',
    body: 'We curate a shortlist that fits your portfolio and your risk profile. Our investigations make the risk, returns and costs of each fund clear before you choose.',
    icon: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M8 13l2-2 2 2 3-3"/>',
  },
  {
    title: 'Portfolio first',
    body: 'Before any new fund, we review the ones you hold. You see how diversified you really are, and how each fund performs against a fair benchmark. Then you decide what to keep.',
    icon: '<path d="M21 12a9 9 0 1 1-9-9v9z"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15z"/>',
  },
  {
    title: 'Your investigator, from review to action',
    body: 'After you invest, we stay in touch and review your portfolio at regular intervals. When markets move or your plans change, we look at the facts together, and help you carry out what you decide.',
    icon: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M9 15l2 2 4-4"/>',
  },
];

// The fee sits next to the service: "No separate fee" is always explained in
// the same place (handoff §2, Fees). Rates are disclosed per client only.
const payPoints = [
  {
    title: 'No separate fee from you',
    body: "Our commission is built into the regular plan's expense ratio, which the fund house deducts from the scheme's assets.",
    icon: '<path d="M7 5h10M7 9h10M13 5c3 0 3 8-2 8H7l7 6"/>',
  },
  {
    title: '40+ fund houses',
    body: 'Our shortlist is not tied to any one of them.',
    icon: '<path d="M3 21h18M5 21V10M19 21V10M9 21v-6h6v6M2 10l10-7 10 7z"/>',
  },
  {
    title: 'Transparency first',
    body: 'Before you decide, we show you in writing what we earn on each suggested fund, and on the other funds we considered.',
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  },
];

const deepdiveFeatures = [
  'Compare your fund against a fair benchmark',
  'See how it held up when markets fell',
  'Check if the return was worth the risk',
];

// The third card spans both columns at sm so the 2-column row leaves no orphan.
const lastCardSpan = (index: number, length: number) =>
  index === length - 1 ? 'sm:col-span-2 lg:col-span-1' : '';
---

<Layout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  graph={homeSchemaGraph(Astro.site)}
>
  <!-- 1. Hero: one promise, one concrete offer -->
  <Hero size="xl" background="dark" class="fi-investigation-hero">
    <div class="fi-hero-grid pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 mb-10">
      <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-8 leading-fi-display tracking-fi-display break-words']}>
        We investigate, so you can
        <span class="text-fi-gold">invest.</span>
      </h1>

      <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed px-1']}>
        Investing is complex, and often emotional. Our analysis brings clarity, our support keeps you on course, and our transparency earns your trust.
      </p>
    </div>

    <!-- Ready visitors book directly; the secondary action explains the service. -->
    <div class="relative z-10 flex flex-col sm:flex-row justify-center items-stretch sm:items-center gap-4 w-full max-w-72 sm:max-w-none mx-auto">
      <Button
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        size="lg"
        icon="external"
        track={{ event: 'review_booking_click', placement: 'homepage_hero' }}
        class="w-full sm:w-auto min-w-0"
      >
        Book a portfolio review
      </Button>
      <Button href="/invest/" variant="secondary" surface="dark" size="lg" class="w-full sm:w-auto min-w-0">
        How support works
      </Button>
    </div>
  </Hero>

  <!-- 2. Who we help, then How we help -->
  <Section background="light" spacing="md" maxWidth="2xl">
    <div class="mb-16 lg:mb-20">
      <div class="text-center mb-10">
        <Badge class="mb-6">Who we help</Badge>
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mb-4 leading-tight tracking-tight max-w-72 sm:max-w-4xl mx-auto']}>
          More choices. More clutter. More confusion.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-8">
        {situations.map((situation, index) => (
          <Card padding="lg" hover={false} class:list={['w-full max-w-72 sm:max-w-none mx-auto', lastCardSpan(index, situations.length)]}>
            <h3 class="text-heading-sm font-bold text-fi-ink mb-3">{situation.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed">{situation.body}</p>
          </Card>
        ))}
      </div>
    </div>

    <div class="text-center mb-12 lg:mb-16">
      <Badge class="mb-6">How we help</Badge>
      <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mb-6 leading-tight tracking-tight max-w-72 sm:max-w-4xl mx-auto']}>
        Clearer choices. Less clutter. More confidence.
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-8">
      {services.map((service, index) => (
        <Card padding="lg" hover={false} class:list={['w-full max-w-72 sm:max-w-none mx-auto', lastCardSpan(index, services.length)]}>
          <div class="w-11 h-11 bg-fi-icon-bg rounded-lg flex items-center justify-center mb-5">
            <svg class="w-fi-icon h-fi-icon text-fi-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={service.icon} />
          </div>
          <h3 class="text-heading-sm font-bold text-fi-ink mb-3">{service.title}</h3>
          <p class="text-body-sm text-fi-muted leading-relaxed">{service.body}</p>
        </Card>
      ))}
    </div>
    <!-- The homepage's only route to /about/: answers "who is behind this?" where the service is described. -->
    <p class="text-center mt-10">
      <a href="/about/" class="text-body-sm font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link">Why Fund Investigator exists →</a>
    </p>

    <!-- How we are paid: lighter than the service cards, so it does not compete. -->
    <div class="mt-16 lg:mt-20 pt-12 lg:pt-16 border-t border-fi-border">
      <div class="text-center mb-10">
        <Badge class="mb-6">How we are paid</Badge>
        <h2 class:list={[responsive.h3, 'font-bold text-fi-ink leading-tight tracking-tight']}>So, what do you pay?</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-72 sm:max-w-none mx-auto">
        {payPoints.map((point, index) => (
          <div class:list={['flex gap-4', lastCardSpan(index, payPoints.length)]}>
            <svg class="shrink-0 w-fi-icon h-fi-icon text-fi-muted mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={point.icon} />
            <div>
              <h3 class="text-body-md font-bold text-fi-ink mb-1">{point.title}</h3>
              <p class="text-body-sm text-fi-muted leading-relaxed">{point.body}</p>
            </div>
          </div>
        ))}
      </div>
      <!-- The point of highest intent on the page, so it asks for the booking. -->
      <div class="text-center mt-10">
        <p class="mb-8">
          <a href="/invest/#costs" class="text-body-sm font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link">See the costs →</a>
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-stretch sm:items-center gap-4 w-full max-w-72 sm:max-w-none mx-auto">
          <Button
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            icon="external"
            track={{ event: 'review_booking_click', placement: 'homepage_pricing' }}
            class="w-full sm:w-auto min-w-0"
          >
            Book a portfolio review
          </Button>
          <Button
            href={whatsappUrl('homepage_pricing')}
            variant="secondary"
            surface="light"
            icon="external"
            target="_blank"
            rel="noopener noreferrer"
            track={{ event: 'conversation_request', placement: 'homepage_pricing', channel: 'whatsapp' }}
            class="w-full sm:w-auto min-w-0"
          >
            Ask a question on WhatsApp
          </Button>
        </div>
        <p class="text-body-sm text-fi-muted mt-6">{TAGLINE} · <span class="whitespace-nowrap">{ARN}</span></p>
      </div>
    </div>
  </Section>

  <!-- 3. Investigations, then Subscribe after the value -->
  <Section background="white" spacing="md" maxWidth="2xl">
    <div class="text-center mb-10 lg:mb-12">
      <Badge class="mb-6">Investigations</Badge>
      <h2 class:list={[responsive.h2Large, 'font-bold text-fi-ink break-words']}>The basics, investigated.</h2>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="grid sm:grid-cols-2 gap-5">
        {featuredGuides.map((report) => (
          <ReportCard report={report} href={`/reports/${report.slug}/`} />
        ))}
      </div>

      <!-- Subscribe follows the value, as one line, not a full card. -->
      <div class="flex flex-col sm:flex-row justify-center items-stretch sm:items-center gap-4 mt-8 w-full max-w-72 sm:max-w-none mx-auto">
        <Button href="/reports/" variant="secondary" surface="light" class="w-full sm:w-auto min-w-0">View all investigations</Button>
        <Button
          href={substackWelcomeUrl('homepage_bottom')}
          target="_blank"
          rel="noopener noreferrer"
          icon="external"
          track={{ event: 'subscribe_click', placement: 'homepage_bottom' }}
          class="w-full sm:w-auto min-w-0"
        >
          Get new guides by email
        </Button>
      </div>
    </div>
  </Section>

  <!-- 4. Deepdive: the do-it-yourself route, so no gold button -->
  <Section background="light" spacing="md" maxWidth="2xl">
    <DeepdiveSnapshot>
      <Badge class="mb-6">Deepdive</Badge>
      <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mb-4 leading-tight tracking-tight']}>Prefer to invest on your own?</h2>
      <p class="text-body-md text-fi-muted leading-relaxed mb-6">
        Use Deepdive, our free fund analysis app, to check any fund yourself. Choose direct plans and keep every decision.
      </p>
      <ul class="space-y-3 text-left max-w-md mx-auto lg:mx-0 mb-8">
        {deepdiveFeatures.map((feature) => (
          <li class="flex gap-3 text-body-sm text-fi-ink">
            <span class="text-fi-positive font-bold" aria-hidden="true">✓</span>{feature}
          </li>
        ))}
      </ul>
      <Button
        href={deepdiveUrl('homepage_deepdive')}
        variant="secondary"
        surface="light"
        icon="external"
        target="_blank"
        rel="noopener noreferrer"
        track={{ event: 'deepdive_click', placement: 'homepage_deepdive' }}
      >
        Open Deepdive
      </Button>
    </DeepdiveSnapshot>
  </Section>
</Layout>

<style>
  .fi-investigation-hero {
    isolation: isolate;
  }

  .fi-hero-grid {
    position: absolute;
    inset: var(--fi-header-h) 0 0;
    z-index: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(203, 213, 225, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(203, 213, 225, 0.16) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 58%, transparent 84%);
  }

  @media (max-width: 640px) {
    .fi-hero-grid {
      background-size: 48px 48px;
      opacity: 0.14;
    }
  }
</style>
