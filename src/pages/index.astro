---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import ReportCard from '../components/ReportCard.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/ui/Hero.astro';
import CredibilityStrip from '../components/ui/CredibilityStrip.astro';
import { getCollection } from 'astro:content';
import { responsive } from '../lib/responsive';
import { deepdiveSchema, organizationSchema, websiteSchema } from '../lib/schema';
import { substackWelcomeUrl } from '../lib/substack';

// Fetch featured articles for homepage
const allReports = await getCollection('reports');
const featuredReports = allReports
  .filter(report => !report.id.startsWith('_')) // Exclude template files
  .filter(report => report.data.featured === true)
  .filter(report => report.data.status !== 'archived')
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3);
---

<Layout
  title="Fund Investigator - Comprehensive Mutual Fund Analysis"
  description="Detailed performance metrics and risk analysis for AMFI-registered funds. Data-driven insights to support your investment decisions."
  jsonLd={[
    organizationSchema(Astro.site),
    websiteSchema(Astro.site),
    deepdiveSchema(Astro.site),
  ]}
>
  <!-- Hero Section -->
  <Hero size="lg" background="dark" class="fi-investigation-hero">
    <div class="fi-hero-grid pointer-events-none" aria-hidden="true"></div>

    <!-- Oversized heading with breathing room -->
    <div class="mb-12 md:mb-14">
      <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-8 leading-[1.08] tracking-[-0.02em] break-words']}>
        Fund Performance,
        <span class="text-fi-gold">Investigated</span>
      </h1>

      <p class="text-body-md sm:text-body-lg text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed px-1">
        Your SIP returns rarely match the fund's headline number. We help you look past it and judge whether the fund beat a fair benchmark, stayed consistent, and was worth the risk.
      </p>
    </div>

    <!-- CTAs -->
    <div class="relative z-10 flex flex-col sm:flex-row justify-center items-stretch sm:items-center gap-4 mb-6 w-full max-w-72 sm:max-w-none mx-auto">
      <Button href="https://deepdive.fundinvestigator.com" size="lg" icon="external" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto min-w-0">
        Investigate Your Fund
      </Button>
      <Button href="/reports" variant="secondary" size="lg" class="w-full sm:w-auto min-w-0">
        Read our Investigations
      </Button>
    </div>

    <!-- Third intent tier: readers not ready for the app or a report. Framed by
         the knowledge gap, not skill level — investors who already hold funds
         won't click anything labelled "beginner". Links straight to the public
         guide; the subscribe ask lives at the end of the article, after the
         reader has seen the value. -->
    <div class="relative z-10 text-body-sm text-fi-muted-inv text-center mb-0">
      Already investing, but unsure how to evaluate a fund?
      <a
        href="/reports/five-checks-mutual-fund/"
        class="text-fi-gold underline decoration-fi-gold/50 transition-opacity hover:opacity-80"
      >
        Start with our first five checks
      </a>
    </div>
  </Hero>

  <!-- Credibility markers close the hero without extending it into another
       content panel. Responsive layout and separator behavior are component-owned. -->
  <Section background="dark" spacing="none" maxWidth="2xl" class="!bg-fi-mid border-t border-fi-border-dark">
    <CredibilityStrip
      markers={['Data-backed', 'Reproducible', 'No commissions']}
      attributionPrefix="Analysis powered by"
      attributionLabel="Deepdive"
      attributionHref="https://deepdive.fundinvestigator.com"
    />
  </Section>

  <!-- Problem Section: The Sales Trap -->
  <Section background="light" spacing="md" maxWidth="2xl">

      <!-- Section Header -->
      <div class="text-center mb-12 lg:mb-16">
        <Badge class="mb-6">The Sales Trap</Badge>
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mb-6 leading-tight tracking-tight max-w-72 sm:max-w-5xl mx-auto']}>
          Funds are marketed on their best returns.<br class="hidden sm:block" />
          <span class="text-fi-muted">Your SIP statement tells a different story.</span>
        </h2>
      </div>

      <!-- Problem Cards Grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-8">

        <!-- Card 1: Returns are marketed -->
        <div class="bg-white rounded-lg p-6 lg:p-8 border border-fi-border w-full max-w-72 sm:max-w-none mx-auto">
          <div class="w-11 h-11 bg-fi-icon-bg rounded-lg flex items-center justify-center mb-5">
            <svg class="w-fi-icon h-fi-icon text-fi-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <h3 class="text-heading-sm font-bold text-fi-ink mb-3">Returns are marketed. Risk is footnoted.</h3>
          <p class="text-body-sm text-fi-muted leading-relaxed">
            Past returns are marketed everywhere. Rolling returns and risk-adjusted metrics are hard to find. What you don't see is exactly what you need to make an informed decision.
          </p>
        </div>

        <!-- Card 2: Today's winner -->
        <div class="bg-white rounded-lg p-6 lg:p-8 border border-fi-border w-full max-w-72 sm:max-w-none mx-auto">
          <div class="w-11 h-11 bg-fi-icon-bg rounded-lg flex items-center justify-center mb-5">
            <svg class="w-fi-icon h-fi-icon text-fi-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
          </div>
          <h3 class="text-heading-sm font-bold text-fi-ink mb-3">Today's winner is tomorrow's trap.</h3>
          <p class="text-body-sm text-fi-muted leading-relaxed">
            Rankings reward recent performance. A fund that topped last year's charts may have simply caught a rising market. Past returns, without context, are a trap disguised as a signal.
          </p>
        </div>

        <!-- Card 3: Transparency (spans full width on tablet 2-col, reverts to single span on desktop 3-col) -->
        <div class="bg-white rounded-lg p-6 lg:p-8 border border-fi-border w-full max-w-72 sm:max-w-none mx-auto sm:col-span-2 lg:col-span-1">
          <div class="w-11 h-11 bg-fi-icon-bg rounded-lg flex items-center justify-center mb-5">
            <svg class="w-fi-icon h-fi-icon text-fi-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"/>
            </svg>
          </div>
          <h3 class="text-heading-sm font-bold text-fi-ink mb-3">Transparency doesn't earn commissions.</h3>
          <p class="text-body-sm text-fi-muted leading-relaxed">
            Commissions create misselling incentives. The fund you're sold is rarely the one that deserves it. It's the one that pays the most to be recommended.
          </p>
        </div>

      </div>
  </Section>

  <!-- Deepdive Showcase Section -->
  <Section background="dark" spacing="md" maxWidth="2xl">

      <!-- Header -->
      <div class="max-w-2xl mx-auto text-center mb-10">
        <Badge variant="dark" class="mb-4">Deepdive</Badge>
        <h2 class:list={[responsive.h2Large, 'font-bold text-fi-ink-inv mb-4']}>Analyze a Fund Like an Investigator</h2>
        <p class="text-body-md text-fi-muted-inv leading-relaxed">
          Select your fund on our app and judge the performance yourself.
        </p>
      </div>

      <!-- Stacked layout: the reel takes a full-width row of its own, with the
           analytical lens cards as a strip beneath it. The reel carries readable
           captions, so it needs the width — in a side-by-side split the frame is
           only ~370px wide from 768px down, which renders the captions unusably
           small. -->
      <div class="flex flex-col gap-8">

        <!-- App showcase reel. The captions sit in a lower third, so the frame's
             aspect ratio is matched to each rendition (9:16 / 3:4 / 16:9) and
             object-contain is used — any cover crop would cut off the text that
             carries the message.
             The frame's width is set in the style block below, where it is
             bounded by viewport height as well as width while portrait. From md
             the cap is 4xl: the landscape cut at the full 1280px container reads
             as an embedded app rather than a showcase.
             Playback is started lazily by the script at the foot of this file;
             users who prefer reduced motion get the static poster and no video
             bytes at all. -->
        <div class="showcase-frame relative mx-auto md:max-w-4xl bg-white rounded-lg overflow-hidden border border-fi-border-dark shadow-fi-card-dark aspect-[9/16] sm:aspect-[3/4] md:aspect-video">
          <video
            class="showcase-video absolute inset-0 w-full h-full object-contain"
            muted
            loop
            playsinline
            preload="none"
            aria-label="Silent walkthrough of the Deepdive app: starting from a fund, returns and risk at a glance, SIP performance against a fair benchmark, drawdowns in falling markets, year-by-year consistency, and rolling-period analysis."
          >
            <!-- Ordered by breakpoint first, then by codec (smallest first).
                 The browser takes the first source whose media query matches and
                 whose codec it can decode. -->
            <source media="(min-width: 768px)" src="/videos/promo-desktop.av1.webm" type='video/webm; codecs="av01.0.08M.08"' />
            <source media="(min-width: 768px)" src="/videos/promo-desktop.webm" type='video/webm; codecs="vp9"' />
            <source media="(min-width: 768px)" src="/videos/promo-desktop.mp4" type="video/mp4" />

            <source media="(min-width: 640px)" src="/videos/promo-ipad.av1.webm" type='video/webm; codecs="av01.0.08M.08"' />
            <source media="(min-width: 640px)" src="/videos/promo-ipad.webm" type='video/webm; codecs="vp9"' />
            <source media="(min-width: 640px)" src="/videos/promo-ipad.mp4" type="video/mp4" />

            <source src="/videos/promo-mobile.av1.webm" type='video/webm; codecs="av01.0.08M.08"' />
            <source src="/videos/promo-mobile.webm" type='video/webm; codecs="vp9"' />
            <source src="/videos/promo-mobile.mp4" type="video/mp4" />
          </video>

          <!-- Shown until playback actually starts, and permanently under
               prefers-reduced-motion. A <picture> is used rather than the video's
               poster attribute because that attribute cannot vary by breakpoint. -->
          <picture class="showcase-poster absolute inset-0">
            <source media="(min-width: 768px)" srcset="/videos/promo-desktop-poster.webp" />
            <source media="(min-width: 640px)" srcset="/videos/promo-ipad-poster.webp" />
            <img
              class="w-full h-full object-contain"
              src="/videos/promo-mobile-poster.webp"
              alt="The Deepdive app home screen, where an investigation starts by typing a fund name."
              loading="lazy"
            />
          </picture>

          <button
            type="button"
            class="showcase-toggle absolute bottom-3 right-3 w-fi-icon-lg h-fi-icon-lg flex items-center justify-center rounded-full bg-fi-dark/80 text-fi-ink-inv border border-fi-border-dark backdrop-blur-sm transition-opacity hover:bg-fi-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fi-gold"
            aria-label="Pause the walkthrough"
            aria-pressed="false"
            hidden
          >
            <svg class="showcase-icon-pause w-fi-icon h-fi-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5h3v14H8zM13 5h3v14h-3z" />
            </svg>
            <svg class="showcase-icon-play w-fi-icon h-fi-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5l11 7-11 7z" />
            </svg>
          </button>
        </div>

        <!-- Analytical lens cards. Card 3 spans both columns at sm so the row
             never leaves a lone orphan card. -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

          <!-- Card 1: Returns -->
          <div class="bg-fi-mid rounded-lg p-6 border border-fi-border-dark">
            <div class="w-11 h-11 bg-fi-dark rounded-lg flex items-center justify-center mb-4">
              <svg class="w-fi-icon h-fi-icon text-fi-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                <polyline points="16 7 22 7 22 13"/>
              </svg>
            </div>
            <p class="text-heading-sm font-bold text-fi-ink-inv mb-2">Did your fund actually outperform?</p>
            <p class="text-body-sm text-fi-muted-inv">Easily compare your fund's performance against the benchmark, and see how it holds up across time periods and recent trends.</p>
          </div>

          <!-- Card 2: Risk -->
          <div class="bg-fi-mid rounded-lg p-6 border border-fi-border-dark">
            <div class="w-11 h-11 bg-fi-dark rounded-lg flex items-center justify-center mb-4">
              <svg class="w-fi-icon h-fi-icon text-fi-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </div>
            <p class="text-heading-sm font-bold text-fi-ink-inv mb-2">What happens when markets fall?</p>
            <p class="text-body-sm text-fi-muted-inv">See how your fund handles falling markets. Know what to expect, so a downturn doesn't catch you off guard.</p>
          </div>

          <!-- Card 3: Risk-Adjusted (spans full width on the sm 2-col row) -->
          <div class="bg-fi-mid rounded-lg p-6 border border-fi-border-dark sm:col-span-2 lg:col-span-1">
            <div class="w-11 h-11 bg-fi-dark rounded-lg flex items-center justify-center mb-4">
              <svg class="w-fi-icon h-fi-icon text-fi-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                <path d="M7 21H17"/>
                <path d="M12 3v18"/>
                <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
              </svg>
            </div>
            <p class="text-heading-sm font-bold text-fi-ink-inv mb-2">Is the return worth the risk?</p>
            <p class="text-body-sm text-fi-muted-inv">Higher returns often come with higher risk. Know your fund's risk-return tradeoff and check if it suits your risk tolerance.</p>
          </div>

        </div>

      </div>

      <!-- CTA -->
      <div class="text-center mt-8">
        <Button href="https://deepdive.fundinvestigator.com" variant="primary" size="md" icon="external" target="_blank" rel="noopener noreferrer">Investigate Your Fund</Button>
      </div>

  </Section>

  <!-- Investigations Section -->
  <Section background="light" spacing="md" maxWidth="2xl">
      <!-- Centered header -->
      <div class="text-center mb-10 lg:mb-12">
        <Badge class="mb-6">Investigations</Badge>
        <h2 class:list={[responsive.h2Large, 'font-bold text-fi-ink mb-6 break-words']}>What the Data Actually Says</h2>
        <p class="text-body-md text-fi-muted leading-relaxed max-w-2xl mx-auto">
          Every fund investigated through three lenses: returns, risk, and risk-adjusted performance. Measured against its benchmark across multiple time periods.
        </p>
      </div>

      <!-- Featured investigation cards: 2-column grid -->
      <div class="max-w-4xl mx-auto">
        {featuredReports.length > 0 ? (
          <div class="grid sm:grid-cols-2 gap-5">
            {featuredReports.slice(0, 2).map((report) => (
              <ReportCard report={report} href={`/reports/${report.slug}/`} />
            ))}
          </div>
        ) : (
          <div class="bg-white rounded-lg p-6 sm:p-8 text-center border border-fi-border">
            <p class="text-body-md text-fi-muted">No featured investigations yet. Check back soon.</p>
          </div>
        )}

        <!-- CTA below cards -->
        <div class="text-center mt-8">
          <Button href="/reports" variant="primary" size="md">Read our Investigations</Button>
        </div>
      </div>
  </Section>

  <!-- About Teaser Section -->
  <Section id="about" background="dark" spacing="md" maxWidth="lg" class="scroll-mt-20">
      <div class="text-center">
        <Badge variant="dark" class="mb-6">Why Fund Investigator</Badge>
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink-inv mb-6 leading-tight tracking-tight']}>
          Because Indian mutual fund investors deserve analysis that improves their portfolio.
          <span class="text-fi-muted-inv">Not mis-selling that increases someone else's commission.</span>
        </h2>
        <p class="text-body-md text-fi-muted-inv leading-relaxed max-w-2xl mx-auto mb-8">
          Fund platforms often compress research into returns, ratings, and buy flows. We built Fund Investigator to inspect the evidence behind performance before forming a view.
        </p>
        <a href="/about" class="text-fi-gold underline decoration-fi-gold/40 hover:decoration-fi-gold transition-colors text-body-sm font-medium">
          Read why Fund Investigator exists
        </a>
      </div>
  </Section>

  <!-- Email Capture Section -->
  <Section background="light" spacing="md">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class:list={[responsive.h2Large, 'font-bold text-fi-ink mb-4']}>
        New Investigation Published? We'll Tell You.
      </h2>
      <p class="text-body-lg text-fi-muted mb-8">
        Subscribe and get notified when a new fund investigation goes live.
      </p>
      <Button
        href={substackWelcomeUrl('homepage_bottom')}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="lg"
        icon="external"
      >
        Subscribe to Fund Investigator
      </Button>
    </div>
  </Section>
</Layout>

<style>
  .fi-investigation-hero {
    isolation: isolate;
  }

  .fi-hero-grid {
    position: absolute;
    inset: var(--fi-header-h) 0 0;
    z-index: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(203, 213, 225, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(203, 213, 225, 0.16) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 58%, transparent 84%);
  }

  @media (max-width: 640px) {
    .fi-hero-grid {
      background-size: 48px 48px;
      opacity: 0.14;
    }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* While the frame is portrait, bound it by viewport height as well as width.
     A full-width 9:16 frame takes ~90% of the screen on a short handset
     (343x610 on a 375x667 phone) while a tall phone sits nearer 75%. Deriving
     the width from whichever constraint binds keeps the frame's aspect exact,
     so object-contain never has to letterbox — capping height alone would
     leave white bars down the sides. Tall phones are unaffected. */
  .showcase-frame {
    width: min(100%, 24rem, calc(80vh * 9 / 16));
    width: min(100%, 24rem, calc(80svh * 9 / 16));
  }

  @media (min-width: 640px) {
    .showcase-frame {
      width: min(100%, 28rem, calc(80vh * 3 / 4));
      width: min(100%, 28rem, calc(80svh * 3 / 4));
    }
  }

  /* From md the cut is landscape and height is never the binding constraint. */
  @media (min-width: 768px) {
    .showcase-frame {
      width: 100%;
    }
  }

  /* App showcase: the poster covers the video until playback actually starts,
     then fades out. Kept in the flow (rather than display:none) so the frame
     never flashes empty while the first video frames decode. */
  .showcase-poster {
    opacity: 1;
    transition: opacity 400ms ease;
  }

  .showcase-frame.is-playing .showcase-poster {
    opacity: 0;
  }

  /* The toggle swaps glyphs rather than nodes, so the button keeps focus. */
  .showcase-toggle .showcase-icon-play {
    display: none;
  }

  .showcase-frame.is-paused .showcase-toggle .showcase-icon-play {
    display: block;
  }

  .showcase-frame.is-paused .showcase-toggle .showcase-icon-pause {
    display: none;
  }

  /* No motion means no video element and no control to operate it — the
     script also bails out early, so no video bytes are ever requested. */
  @media (prefers-reduced-motion: reduce) {
    .showcase-video,
    .showcase-toggle {
      display: none;
    }
    .showcase-poster {
      opacity: 1;
    }
  }
</style>

<script>
  // Deepdive showcase reel. The section sits below the fold, so nothing is
  // fetched until it scrolls into view — the video ships with preload="none"
  // and no autoplay attribute, and this script is the only thing that starts it.
  const frame = document.querySelector<HTMLElement>('.showcase-frame');
  const video = frame?.querySelector<HTMLVideoElement>('.showcase-video');
  const toggle = frame?.querySelector<HTMLButtonElement>('.showcase-toggle');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Bail out entirely when motion is unwanted: the poster is already visible and
  // this keeps the video cost at exactly zero bytes.
  if (frame && video && toggle && !reducedMotion.matches) {
    let userPaused = false;

    const play = () => {
      // play() rejects when autoplay is blocked; surface the play glyph so the
      // reel is still reachable by hand instead of sitting silently stalled.
      video.play().then(
        () => frame.classList.remove('is-paused'),
        () => frame.classList.add('is-paused'),
      );
    };

    video.addEventListener('playing', () => frame.classList.add('is-playing'));

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) {
        video.pause();
        frame.classList.add('is-paused');
      } else {
        play();
      }
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.setAttribute(
        'aria-label',
        userPaused ? 'Play the walkthrough' : 'Pause the walkthrough',
      );
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (!userPaused) play();
          } else if (!video.paused) {
            // Pause off-screen without touching userPaused, so an explicit
            // pause survives scrolling away and back.
            video.pause();
          }
        }
      },
      { threshold: 0.25 },
    );
    observer.observe(frame);

    // <source media> is evaluated once at load time and never re-evaluated, so a
    // desktop window resized across a breakpoint would keep the wrong rendition.
    // Reload only after something has already been fetched — reloading a
    // preload="none" video would defeat the lazy start.
    for (const query of ['(min-width: 640px)', '(min-width: 768px)']) {
      window.matchMedia(query).addEventListener('change', () => {
        if (video.currentSrc) {
          video.load();
          if (!userPaused) play();
        }
      });
    }
  }
</script>
