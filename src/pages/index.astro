---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import ReportCard from '../components/ReportCard.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Hero from '../components/ui/Hero.astro';
import SampleBrief from '../components/ui/SampleBrief.astro';
import CredibilityStrip from '../components/ui/CredibilityStrip.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import CheckList from '../components/ui/CheckList.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import { getCollection } from 'astro:content';
import { responsive } from '../lib/responsive';
import { HOME_DESCRIPTION, HOME_TITLE, homeSchemaGraph } from '../lib/schema';
import { substackWelcomeUrl } from '../lib/substack';
import { ARN, BOOKING_URL, CONTACT_EMAIL, CREDENTIALS, FIRST_NAME, OWNER_PHOTO, REGISTERED_NAME, TAGLINE } from '../lib/distributor';
import { whatsappUrl, type WhatsappPlacement } from '../lib/whatsapp';
import { services } from '../lib/services';

// Featured by slug, not "latest": only guides whose card text names no fund may
// sit on a page that promotes the service (handoff §2, Links). Replace these
// with the decision guides once they are published (log #74).
const featuredGuideSlugs = ['five-checks-mutual-fund', 'mutual-fund-categories-explained'];
const allReports = await getCollection('reports');
const featuredGuides = featuredGuideSlugs
  .map((slug) => allReports.find((report) => report.slug === slug))
  .filter((report) => report !== undefined);

// Each section's buttons are tracked by placement: Zoho and WhatsApp report no
// placement back, so the click event is the only record of which button worked.
const booking = (placement: string) => ({
  href: BOOKING_URL,
  target: '_blank' as const,
  rel: 'noopener noreferrer',
  icon: 'external' as const,
  track: { event: 'review_booking_click' as const, placement },
});
const whatsapp = (placement: WhatsappPlacement) => ({
  href: whatsappUrl(placement),
  target: '_blank' as const,
  rel: 'noopener noreferrer',
  icon: 'external' as const,
  track: { event: 'conversation_request' as const, placement, channel: 'whatsapp' },
});

// Three differences, in the order of the section's lead line (evidence, then portfolio first).
const differences = [
  {
    title: 'Analysis and evidence',
    body: 'Every fund is checked against a fair benchmark, with the analysis tool we built.',
  },
  {
    title: 'Portfolio first',
    body: 'New or existing investor, we plan your whole mix first, then the funds. Fewer funds can be the right result.',
  },
  {
    title: 'Transparent and personal',
    body: 'Our commission in writing before you choose, and one person from the first call to every review.',
  },
];

const subscribeBenefits = [
  { title: 'Every new investigation', body: 'Fund checks and guides, by email.', icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' },
  { title: 'Access to Deepdive', body: 'Our fund analysis app.', icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>' },
];

const lightLink = 'text-body-md font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link';
const ctaRow = 'flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 w-full max-w-80 sm:max-w-none mx-auto';
---

<Layout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  graph={homeSchemaGraph(Astro.site)}
>
  <!-- 1. Hero: stacked and centred at every width — promise, actions, the sample brief, then trust.
       The brief comes before the trust strip so its mix bars show on the first screen. -->
  <Hero size="md" background="dark">
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words']}>
      We investigate,<br />
      so you can <span class="text-fi-gold">invest.</span>
    </h1>

    <!-- Tagline says what the company does; "build" speaks to beginners, "improve" to existing investors. -->
    <p class="text-body-lg text-fi-ink-inv font-semibold max-w-sm sm:max-w-xl mx-auto leading-relaxed text-balance mb-8">
      Build and improve your portfolio with our help and expertise in mutual funds and SIFs.
    </p>

    <div class:list={[ctaRow, 'mb-4']}>
      <Button {...booking('homepage_hero')} size="lg" class="w-full sm:w-auto min-w-0">Book a first call</Button>
      <Button {...whatsapp('homepage_hero')} variant="secondary" surface="dark" size="lg" class="w-full sm:w-auto min-w-0">Contact on WhatsApp</Button>
    </div>
    <!-- "No charge" is scoped to the call so the service never reads as free. -->
    <p class="text-body-sm text-fi-subtle text-balance">
      30-minute call · No charge · No obligation
    </p>

    <div class="mt-8">
      <SampleBrief />
    </div>

    <!-- The ARN stays in the hero, directly after the proof. -->
    <div class="mt-10 border-t border-fi-border-dark">
      <CredibilityStrip markers={[`AMFI-registered (${ARN})`, '40+ fund houses empanelled', 'Transparent disclosures']} />
    </div>
  </Hero>

  <!-- 2. Problems → services: each problem leads to the service that solves it, then the fee -->
  <Section background="light" spacing="md" maxWidth="2xl">
    <SectionHeading
      title="Clearer choices. Less clutter. More confidence."
      lead="Four common problems, and the service that solves each one. You approve every transaction."
    />

    <ol class="grid sm:grid-cols-2 gap-5">
      {services.map((service, index) => (
        <li data-reveal={index}>
          <ServiceCard {...service} />
        </li>
      ))}
    </ol>

    <!-- "No separate fee" is always explained in the same place (handoff §2, Fees).
         The direct vs regular comparison lives in the /invest/ FAQ. -->
    <Card hover={false} padding="md" class="mt-5 flex items-start gap-3 text-left">
      <svg class="w-fi-icon h-fi-icon shrink-0 text-fi-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 5h10M7 9h10M13 5c3 0 3 8-2 8H7l7 6"/></svg>
      <p class="text-body-sm text-fi-muted leading-relaxed">
        <strong class="text-fi-ink">No separate fee from you.</strong>
        Our commission is part of the fund's yearly expense ratio, and we disclose it transparently before you select your funds.
      </p>
    </Card>

    <div class:list={[ctaRow, 'mt-10']}>
      <Button {...booking('homepage_services')} class="w-full sm:w-auto min-w-0">Book a first call</Button>
      <Button {...whatsapp('homepage_services')} variant="secondary" surface="light" class="w-full sm:w-auto min-w-0">Contact on WhatsApp</Button>
    </div>
  </Section>

  <!-- 3. The Fund Investigator way: why us, without the person (the final section reveals them) -->
  <Section background="white" spacing="md" maxWidth="2xl">
    <SectionHeading
      title="The Fund Investigator way."
      lead="Because Indian fund investors deserve fund choices backed by evidence and a portfolio-first approach."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {differences.map((difference, index) => (
        <div data-reveal={index}>
          <Card hover={false} padding="md" class="h-full text-left">
            <h3 class="text-body-lg font-bold text-fi-ink mb-2">{difference.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed">{difference.body}</p>
          </Card>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      <Button href="/invest/" variant="secondary" surface="light" icon="arrow-right">How support works</Button>
      <a href="/about/" class={lightLink}>Read our story →</a>
    </div>
  </Section>

  <!-- 4. Investigations and tools: value first (guides), then the ask (subscribe) -->
  <Section background="light" spacing="md" maxWidth="2xl">
    <SectionHeading
      title="Our investigations and tools."
      lead="Read our analysis, see our methods and try our tools."
    />

    <div class="grid sm:grid-cols-2 gap-5 text-left">
      {featuredGuides.map((report, index) => (
        <div data-reveal={index}>
          <ReportCard report={report} href={`/reports/${report.slug}/`} surface="light" />
        </div>
      ))}
    </div>

    <p class="mt-8 text-center">
      <a href="/reports/" class={lightLink}>View all investigations →</a>
    </p>

    <!-- Gold stays for booking; the subscription is this section's only button. -->
    <Card variant="bordered" hover={false} padding="lg" class="mt-10 grid gap-6 text-left lg:grid-cols-fi-subscribe lg:items-center lg:gap-8">
      <h3 class="text-heading-sm font-bold text-fi-ink">Subscribe for free</h3>
      <ul class="grid sm:grid-cols-2 gap-5">
        {subscribeBenefits.map((benefit) => (
          <li class="flex gap-3">
            <span class="w-10 h-10 shrink-0 rounded-lg bg-fi-icon-bg flex items-center justify-center">
              <svg class="w-5 h-5 text-fi-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={benefit.icon} />
            </span>
            <span>
              <strong class="block text-body-sm text-fi-ink">{benefit.title}</strong>
              <span class="text-body-sm text-fi-muted">{benefit.body}</span>
            </span>
          </li>
        ))}
      </ul>
      <Button
        href={substackWelcomeUrl('homepage_bottom')}
        variant="secondary"
        surface="light"
        target="_blank"
        rel="noopener noreferrer"
        icon="external"
        track={{ event: 'subscribe_click', placement: 'homepage_bottom' }}
        class="w-full sm:w-auto min-w-0 justify-self-start"
      >
        Subscribe
      </Button>
    </Card>
  </Section>

  <!-- 5. Final call: the reveal — who the visitor speaks with. Stacked and centred like the hero. -->
  <Section background="white" spacing="md" maxWidth="lg">
    <div class="text-center">
      {OWNER_PHOTO && (
        <OptimizedImage
          src={OWNER_PHOTO}
          alt={REGISTERED_NAME}
          preset="inline"
          class="w-40 h-40 lg:w-56 lg:h-56 mx-auto mb-8 rounded-full object-cover"
        />
      )}
      <h2 class:list={[responsive.h2, 'font-bold text-fi-ink leading-tight tracking-tight text-balance mb-3']}>
        Start with a 30-minute call with {FIRST_NAME}.
      </h2>
      <p class="text-body-md text-fi-muted mb-4">{TAGLINE} · <span class="whitespace-nowrap">{ARN}</span></p>
      {CREDENTIALS.length > 0 && <CheckList items={CREDENTIALS.map((credential) => credential.text)} layout="inline" class="mb-6" />}
      <p class="text-body-md text-fi-muted leading-relaxed max-w-xl mx-auto mb-8 text-balance">
        Tell me your goals. Show me your funds, or the amount you plan to invest. I reply to messages within 1 business day.
      </p>
      <div class={ctaRow}>
        <Button {...booking('homepage_final')} size="lg" class="w-full sm:w-auto min-w-0">Book a call with {FIRST_NAME}</Button>
        <Button {...whatsapp('homepage_final')} variant="secondary" surface="light" size="lg" class="w-full sm:w-auto min-w-0">Contact on WhatsApp</Button>
      </div>
      <p class="mt-6 text-body-sm text-fi-muted">
        Prefer email? <a href={`mailto:${CONTACT_EMAIL}`} class={lightLink}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </Section>
</Layout>
