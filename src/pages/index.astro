---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import ReportCard from '../components/ReportCard.astro';
import DeepdiveSnapshot from '../components/DeepdiveSnapshot.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/ui/Hero.astro';
import { getCollection } from 'astro:content';
import { responsive } from '../lib/responsive';
import { HOME_DESCRIPTION, HOME_TITLE, homeSchemaGraph } from '../lib/schema';
import { substackWelcomeUrl } from '../lib/substack';
import { deepdiveUrl } from '../lib/deepdive';

// Featured by slug, not "latest": only guides whose card text names no fund may
// sit on a page that promotes the service (handoff §2, Links). Replace these
// with the decision guides once they are published (log #74).
const featuredGuideSlugs = ['five-checks-mutual-fund', 'mutual-fund-categories-explained'];
const allReports = await getCollection('reports');
const featuredGuides = featuredGuideSlugs
  .map((slug) => allReports.find((report) => report.slug === slug))
  .filter((report) => report !== undefined);

// Situations a ₹10 lakh+ investor recognises; copy to be reworked (handoff §4).
const situations = [
  {
    title: 'Too many funds',
    body: 'Ten or more funds, bought over the years from different apps and banks. Many of them hold the same stocks.',
  },
  {
    title: 'A large sum to invest',
    body: 'A bonus, ESOP sale or property sale. You want a plan for when and where to invest it, not a tip.',
  },
  {
    title: 'No time to check',
    body: 'You know some funds may lag their benchmark. You have not had the time to find out which ones.',
  },
];

const services = [
  {
    title: 'Funds chosen through research',
    body: 'We help you choose from funds that pass our research. We test each fund against a fair benchmark, and for risk and cost.',
    icon: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M8 13l2-2 2 2 3-3"/>',
  },
  {
    title: 'Matched to your risk profile',
    body: 'We start with your goals, your time frame and your risk profile. We help you choose only funds that are suitable for you.',
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/>',
  },
  {
    title: 'Support after you invest',
    body: 'We review your funds at regular intervals. We help with SIP changes, switches and paperwork. When markets fall, we look at the evidence with you.',
    icon: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M9 15l2 2 4-4"/>',
  },
];

const deepdiveFeatures = [
  'Compare your fund against a fair benchmark',
  'See how it held up when markets fell',
  'Check if the return was worth the risk',
];

// The third card spans both columns at sm so the 2-column row leaves no orphan.
const lastCardSpan = (index: number, length: number) =>
  index === length - 1 ? 'sm:col-span-2 lg:col-span-1' : '';
---

<Layout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  graph={homeSchemaGraph(Astro.site)}
>
  <!-- 1. Hero: one promise, one concrete offer -->
  <Hero size="lg" background="dark" class="fi-investigation-hero">
    <div class="fi-hero-grid pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 mb-10">
      <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-8 leading-fi-display tracking-fi-display break-words']}>
        We investigate, so you can
        <span class="text-fi-gold">invest.</span>
      </h1>

      <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed px-1']}>
        Investing is complex, and often emotional. Our analysis brings clarity, our support keeps you on course, and our transparency earns your trust.
      </p>
    </div>

    <!-- The review call is on-site (/invest/#review), so it gets an arrow, not ↗. -->
    <div class="relative z-10 flex flex-col sm:flex-row justify-center items-stretch sm:items-center gap-4 w-full max-w-72 sm:max-w-none mx-auto">
      <Button
        href="/invest/#review"
        size="lg"
        icon="arrow-right"
        track={{ event: 'review_booking_click', placement: 'homepage_hero' }}
        class="w-full sm:w-auto min-w-0"
      >
        Book a portfolio review
      </Button>
      <Button href="/invest/" variant="secondary" surface="dark" size="lg" class="w-full sm:w-auto min-w-0">
        How support works
      </Button>
    </div>
  </Hero>

  <!-- 2. Who we help, then How we help -->
  <Section background="light" spacing="md" maxWidth="2xl">
    <div class="mb-16 lg:mb-20">
      <div class="text-center mb-10">
        <Badge class="mb-6">Who we help</Badge>
        <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mb-4 leading-tight tracking-tight max-w-72 sm:max-w-4xl mx-auto']}>
          You have built real savings.
          <span class="text-fi-muted">You do not have time to manage them.</span>
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-8">
        {situations.map((situation, index) => (
          <Card padding="lg" hover={false} class:list={['w-full max-w-72 sm:max-w-none mx-auto', lastCardSpan(index, situations.length)]}>
            <h3 class="text-heading-sm font-bold text-fi-ink mb-3">{situation.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed">{situation.body}</p>
          </Card>
        ))}
      </div>
    </div>

    <div class="text-center mb-12 lg:mb-16">
      <Badge class="mb-6">How we help</Badge>
      <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mb-6 leading-tight tracking-tight max-w-72 sm:max-w-4xl mx-auto']}>
        Support from your first SIP to every review.<br class="hidden sm:block" />
        <span class="text-fi-muted">Help to choose, to invest, and to stay on course.</span>
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-8">
      {services.map((service, index) => (
        <Card padding="lg" hover={false} class:list={['w-full max-w-72 sm:max-w-none mx-auto', lastCardSpan(index, services.length)]}>
          <div class="w-11 h-11 bg-fi-icon-bg rounded-lg flex items-center justify-center mb-5">
            <svg class="w-fi-icon h-fi-icon text-fi-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={service.icon} />
          </div>
          <h3 class="text-heading-sm font-bold text-fi-ink mb-3">{service.title}</h3>
          <p class="text-body-sm text-fi-muted leading-relaxed">{service.body}</p>
        </Card>
      ))}
    </div>

    <!-- The hero carries no disclosure, so the fee line sits next to the service. -->
    <div class="text-center mt-10">
      <p class="text-body-sm text-fi-muted max-w-2xl mx-auto mb-6">
        You pay us no separate fee. We earn a commission from the fund house on regular plans, so regular plans cost more than direct plans.
        <a href="/invest/#costs" class="font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link">See the costs →</a>
      </p>
      <Button href="/invest/">See how support works</Button>
    </div>
  </Section>

  <!-- 3. Investigations, then Subscribe after the value -->
  <Section background="white" spacing="md" maxWidth="2xl">
    <div class="text-center mb-10 lg:mb-12">
      <Badge class="mb-6">Investigations</Badge>
      <h2 class:list={[responsive.h2Large, 'font-bold text-fi-ink mb-6 break-words']}>The basics, investigated.</h2>
      <p class="text-body-md text-fi-muted leading-relaxed max-w-2xl mx-auto">
        Guides and fund investigations that help you ask better questions before you invest.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="grid sm:grid-cols-2 gap-5">
        {featuredGuides.map((report) => (
          <ReportCard report={report} href={`/reports/${report.slug}/`} />
        ))}
      </div>

      <div class="text-center mt-8">
        <Button href="/reports/" variant="secondary" surface="light">View all investigations</Button>
      </div>

      <Card variant="elevated" padding="lg" hover={false} class="max-w-2xl mx-auto mt-12 text-center">
        <h3 class="text-heading-sm font-bold text-fi-ink mb-2">New guide published? We'll tell you.</h3>
        <p class="text-body-md text-fi-muted mb-6">
          Subscribe and get each new guide and investigation by email.
        </p>
        <Button
          href={substackWelcomeUrl('homepage_bottom')}
          target="_blank"
          rel="noopener noreferrer"
          icon="external"
          track={{ event: 'subscribe_click', placement: 'homepage_bottom' }}
        >
          Subscribe
        </Button>
      </Card>
    </div>
  </Section>

  <!-- 4. Deepdive: the do-it-yourself route, so no gold button -->
  <Section background="light" spacing="md" maxWidth="2xl">
    <DeepdiveSnapshot>
      <Badge class="mb-6">Deepdive</Badge>
      <h2 class:list={[responsive.h2, 'font-bold text-fi-ink mb-4 leading-tight tracking-tight']}>Prefer to invest on your own?</h2>
      <p class="text-body-md text-fi-muted leading-relaxed mb-6">
        Use Deepdive, our free fund analysis app, to check any fund yourself. Choose direct plans and keep every decision.
      </p>
      <ul class="space-y-3 text-left max-w-md mx-auto lg:mx-0 mb-8">
        {deepdiveFeatures.map((feature) => (
          <li class="flex gap-3 text-body-sm text-fi-ink">
            <span class="text-fi-positive font-bold" aria-hidden="true">✓</span>{feature}
          </li>
        ))}
      </ul>
      <Button
        href={deepdiveUrl('homepage_deepdive')}
        variant="secondary"
        surface="light"
        icon="external"
        target="_blank"
        rel="noopener noreferrer"
        track={{ event: 'deepdive_click', placement: 'homepage_deepdive' }}
      >
        Open Deepdive
      </Button>
    </DeepdiveSnapshot>
  </Section>
</Layout>

<style>
  .fi-investigation-hero {
    isolation: isolate;
  }

  .fi-hero-grid {
    position: absolute;
    inset: var(--fi-header-h) 0 0;
    z-index: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(203, 213, 225, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(203, 213, 225, 0.16) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 58%, transparent 84%);
  }

  @media (max-width: 640px) {
    .fi-hero-grid {
      background-size: 48px 48px;
      opacity: 0.14;
    }
  }
</style>
