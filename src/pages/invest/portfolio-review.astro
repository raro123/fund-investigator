---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import CheckList from '../../components/ui/CheckList.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import OwnerIntro from '../../components/ui/OwnerIntro.astro';
import SampleBrief from '../../components/ui/SampleBrief.astro';
import CredibilityStrip from '../../components/ui/CredibilityStrip.astro';
import SplitRows from '../../components/ui/SplitRows.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { reviewFaq } from '../../lib/faq';
import { responsive } from '../../lib/responsive';
import { ARN } from '../../lib/distributor';

// Landing page 1 of 4 (docs/landing_pages_plan.md): for readers who already
// invest and are unsure their funds make sense together. Content that sends
// readers here is a generic guide that names no fund, so this page may link to
// booking and WhatsApp (handoff §2, Links). Draft copy: the owner checks it (log item 107).
// Placements start with `lp_review_`, so PostHog can split this page from /invest/.

// The reader's situation, in their words: each sign is something they can
// recognise without knowing the metric behind it.
const signs = [
  'You hold several funds, but are unsure what each adds.',
  'You want to understand overlap, performance and yearly costs.',
  'Your goals or income changed, but your funds did not.',
];

// The four checks match the sample brief in the hero and the review bullets in
// src/lib/services.ts (suitability, performance, overlap, costs).
const checks = [
  { title: 'Overlap', body: 'How many of your stocks repeat across your funds. Several funds can hold the same companies.' },
  { title: 'Benchmark', body: 'Whether each fund has beaten a fair market index over time, not only funds like it.' },
  { title: 'Costs', body: 'What your funds cost each year, on average, and what the costs mean for your money.' },
  { title: 'Fit', body: 'Whether your mix of equity, debt and gold suits your goals, time frame and risk profile.' },
];

// The review path only: from booking to the client's decision. The full
// client journey, with ongoing reviews, lives on /invest/#how-it-works.
const steps = [
  {
    name: 'First conversation',
    left: 'Tell us your goals, time frame and a rough idea of your funds.',
    right: 'Discuss your risk profile and explain what the review checks.',
  },
  {
    name: 'Assessment and brief',
    left: 'Share your Consolidated Account Statement (CAS) after the call. Read the brief and ask questions.',
    right: 'Help you download your CAS. Check your holdings and explain what to keep, watch or change, with reasons.',
  },
  {
    name: 'Your decision and support',
    left: 'Choose any changes. Approve each transaction by OTP and pay the fund house directly.',
    right: 'Explain suitable options and our commission in writing. Help with setup and review your funds at regular intervals.',
  },
];

const callDetails = '30-minute call · No charge · No obligation';
const lightLink = 'font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link';
---

<Layout
  title="Mutual fund portfolio review - Fund Investigator"
  description="Do your mutual funds work together? A 30-minute call, then a review of overlap, benchmarks, costs and fit, from an AMFI-registered distributor."
  trackView="landing_view"
  trackLanding="review"
>
  <Hero size="md" background="dark">
    <p class="text-body-sm text-fi-muted-inv mb-4">Mutual fund portfolio review</p>
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words max-w-4xl mx-auto']}>
      Do your funds still
      <span class="block text-fi-gold">make sense together?</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed mb-8']}>
      Understand what to keep, what needs attention, and why. We review how your mutual funds fit together, what they cost and whether they suit your goals, then explain the findings in a short written brief.
    </p>
    <p class="text-body-sm text-fi-subtle mb-6">You do not need to move your existing holdings to start a review.</p>
    <ContactActions placement="lp_review_hero" surface="dark" note={callDetails} />

    <div class="mt-8">
      <SampleBrief />
    </div>

    <div class="mt-10 border-t border-fi-border-dark">
      <CredibilityStrip markers={[`AMFI-registered (${ARN})`, '40+ fund houses empanelled', 'Transparent disclosures']} />
    </div>
  </Hero>

  <Section background="white" spacing="md" maxWidth="lg">
    <OwnerIntro class="mb-10" />
    <SectionHeading title="When the whole mix needs a closer look." lead="You already invest, but want the reasons and costs before changing anything." />
    <Card variant="subtle" padding="lg" hover={false} class="max-w-2xl mx-auto">
      <CheckList items={signs} />
    </Card>
  </Section>

  <Section id="checks" background="light" spacing="md" maxWidth="2xl">
    <SectionHeading title="Four checks on every portfolio." lead="The checks we use in our investigations, run on the funds you hold." />
    <ol class="grid sm:grid-cols-2 gap-5 text-left">
      {checks.map((check, index) => (
        <li data-reveal={index}>
          <Card padding="lg" hover={false} class="h-full">
            <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{check.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed">{check.body}</p>
          </Card>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="costs" background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="How we are paid."
      lead="No separate fee from you. The fund house pays our commission from the regular plan's yearly expense ratio. You get our commission on each fund, in writing, before you decide."
    />
    <!-- The main reassurance for existing investors who hold direct plans. -->
    <Card variant="subtle" padding="md" hover={false} class="max-w-2xl mx-auto text-left">
      <h3 class="text-body-md font-bold text-fi-ink mb-1">Already in direct plans?</h3>
      <p class="text-body-sm text-fi-muted leading-relaxed">
        We discuss them on the first call, then review the details after you share your holdings. You can keep them direct. If you invest through us, we can only use regular plans. Nothing moves without your approval.
      </p>
    </Card>
    <p class="text-center text-body-sm mt-6">
      <a href="/invest/#costs" class={lightLink}>Compare direct and regular plans →</a>
    </p>
    <ContactActions placement="lp_review_cta" surface="light" identity class="mt-12" />
  </Section>

  <Section id="how-it-works" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="From the first call to your brief." lead="What you do, and what we do, at each stage." />
    <SplitRows rows={steps} rowLabel="Stage" columns={[{ label: 'You' }, { label: 'We' }]} numbered />
  </Section>

  <Section id="faq" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions before your review" />
    <div class="max-w-3xl mx-auto text-left">
      <FaqList items={reviewFaq} />
    </div>
  </Section>

  <Section background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="Start with a 30-minute call."
      lead="Tell us what you hold and what worries you about it. We explain what the review will check, and you decide what happens next."
    />
    <ContactActions placement="lp_review_final" surface="light" />

  </Section>
</Layout>
