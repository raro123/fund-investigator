---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import FitCards from '../../components/ui/FitCards.astro';
import CredibilityStrip from '../../components/ui/CredibilityStrip.astro';
import SplitRows from '../../components/ui/SplitRows.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { giftCityFaq } from '../../lib/faq';
import { products } from '../../lib/products';
import { responsive } from '../../lib/responsive';
import { ARN } from '../../lib/distributor';

// Landing page 4 of 4 (docs/landing_pages_plan.md): for residents who want
// part of their money in US dollars, and for NRIs. The "things to know" section
// (LRS, TCS, currency, tax) comes before the process, because those rules
// decide whether the product suits the reader. Tax stays general and points to
// the client's tax adviser. Names no fund house or fund; no return claims.
// noindex until the tax, LRS and transaction points are checked (log item 110).
// Placements start with `lp_gift_city_`.

const giftCity = products.find((product) => product.title === 'GIFT City funds')!;
const facts = [
  { label: 'Suits', value: giftCity.suits },
  { label: 'Minimum', value: giftCity.minimum },
  { label: 'Main risk', value: giftCity.mainRisk },
];

// Why people look at these funds, in their words.
const reasons = [
  { title: 'Spending in dollars later', body: 'Studies abroad, travel, or a life partly outside India. Part of the money can be in the currency you will spend.' },
  { title: 'Beyond Indian markets', body: 'Part of your money in markets outside India, through a fund based in India\'s international financial centre.' },
  { title: 'NRIs', body: 'Invest in US dollars through a fund in GIFT City, without converting to rupees.' },
];

// The rules that decide fit, stated as facts.
const rules = [
  { title: 'The LRS limit', body: 'Residents send money under the Liberalised Remittance Scheme: up to USD 250,000 per person in a financial year, across all uses.' },
  { title: 'TCS on remittances', body: 'Tax collected at source can apply when you send money abroad above a yearly threshold. You can adjust it against your income tax.' },
  { title: 'The rupee–dollar rate', body: 'Your value in rupees moves with the exchange rate, both ways.' },
  { title: 'Tax and reporting', body: 'The rules differ from rupee funds. We explain them before you decide; please confirm them with your tax adviser.' },
];

const suits = [
  'Part of your future spending will be in US dollars.',
  'You already have a base of Indian investments.',
  'You are comfortable with the rupee–dollar rate moving your value.',
];
const notFor = [
  'You will need the money in rupees within the next few years.',
  'You do not want the extra tax and reporting steps.',
  'You are new to investing. Start with mutual funds.',
];

const steps = [
  {
    name: 'Book a call',
    left: 'Pick a time, or message us on WhatsApp.',
    right: 'Confirm your booking at once. Reply on WhatsApp within 1 business day.',
  },
  {
    name: 'The first call',
    left: 'Tell us your goals, where you will spend the money, and whether you live in India.',
    right: 'Agree your risk profile with you. Explain how GIFT City funds, the LRS and TCS work.',
  },
  {
    name: 'The fit check',
    left: 'Share your Consolidated Account Statement (CAS) after the call, and read the brief.',
    right: 'Say whether dollar assets suit your goals and how much. If they do: which fund, its risks and costs, and the tax points, in writing.',
  },
  {
    name: 'Set up',
    left: 'Send the money through your bank under the LRS. Approve each step.',
    right: 'Handle the fund\'s KYC and the investment.',
  },
  {
    name: 'Stay with it',
    left: 'Tell us when your plans change.',
    right: 'Review the fund with the rest of your portfolio at regular intervals.',
  },
];

const callDetails = '30-minute call · No charge · No obligation';
const lightLink = 'font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link';
---

<Layout
  title="GIFT City funds: invest in US dollars - Fund Investigator"
  description="Want part of your money in US dollars? GIFT City funds for residents under the LRS and for NRIs. We check fit and explain the tax points first."
  trackView="landing_view"
  trackLanding="gift_city"
  noindex
>
  <!-- 1. Hero: the reader's wish, what the product is, the action -->
  <Hero size="md" background="dark">
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words max-w-4xl mx-auto']}>
      Want part of your money
      <span class="block text-fi-gold">in US dollars?</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed mb-8']}>
      GIFT City funds are based in India's international financial centre and held in US dollars. Residents invest under the LRS, and NRIs can invest too. We check whether they suit you, and explain the rules first.
    </p>
    <ContactActions placement="lp_gift_city_hero" surface="dark" note={callDetails} />

    <div class="mt-10 border-t border-fi-border-dark">
      <CredibilityStrip markers={[`AMFI-registered (${ARN})`, '40+ fund houses empanelled', 'Transparent disclosures']} />
    </div>
  </Hero>

  <!-- 2. Why people look at these funds, then the facts by fit (src/lib/products.ts) -->
  <Section id="why" background="white" spacing="md" maxWidth="2xl">
    <SectionHeading title="Why investors look at GIFT City funds." />
    <ul class="grid sm:grid-cols-3 gap-5 text-left">
      {reasons.map((reason, index) => (
        <li data-reveal={index}>
          <Card variant="subtle" padding="lg" hover={false} class="h-full">
            <h3 class="text-body-lg font-bold text-fi-ink mb-2">{reason.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed">{reason.body}</p>
          </Card>
        </li>
      ))}
    </ul>
    <dl class="grid sm:grid-cols-3 gap-5 text-left mt-5">
      {facts.map((fact) => (
        <Card padding="lg" hover={false} class="h-full">
          <dt class="text-caption uppercase text-fi-muted mb-2">{fact.label}</dt>
          <dd class="text-body-md text-fi-ink leading-relaxed">{fact.value}</dd>
        </Card>
      ))}
    </dl>
  </Section>

  <!-- 3. The rules that decide fit, before any process -->
  <Section id="rules" background="light" spacing="md" maxWidth="2xl">
    <SectionHeading title="Four things to know first." lead="These rules decide whether GIFT City funds suit you. We go through each one on the call." />
    <ul class="grid sm:grid-cols-2 gap-5 text-left">
      {rules.map((rule, index) => (
        <li data-reveal={index}>
          <Card padding="lg" hover={false} class="h-full">
            <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{rule.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed">{rule.body}</p>
          </Card>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 4. Fit: who should consider these funds and who should skip them -->
  <Section background="white" spacing="md" maxWidth="2xl">
    <SectionHeading title="Are GIFT City funds for you?" />
    <FitCards suits={suits} notFor={notFor} suitsTitle="Consider them if" notForTitle="Skip them if" />
  </Section>

  <!-- 5. What happens next: You beside We -->
  <Section id="how-it-works" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="From the first call to your first dollar investment." lead="What you do, and what we do, at each stage." />
    <SplitRows rows={steps} rowLabel="Stage" columns={[{ label: 'You' }, { label: 'We' }]} numbered />
  </Section>

  <!-- 6. How we are paid, then the action. "No separate fee" sits with the commission explanation. -->
  <Section id="costs" background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="How we are paid."
      lead="No separate fee from you. The fund house pays our commission from the fund's yearly expenses. You get our commission in writing before you decide."
    />
    <ContactActions placement="lp_gift_city_cta" surface="light" identity class="mt-4" />
  </Section>

  <!-- 7. Questions before investing in US dollars; shared answers come from src/lib/faq.ts -->
  <Section id="faq" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions about GIFT City funds" />
    <div class="max-w-3xl mx-auto text-left">
      <FaqList items={giftCityFaq} />
    </div>
  </Section>

  <!-- 8. Final call, then the routes to the other pages -->
  <Section background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="Ask whether GIFT City funds suit you."
      lead="A 30-minute call. We look at your goals and what you hold first, and you decide what happens next."
    />
    <ContactActions placement="lp_gift_city_final" surface="light" />
    <p class="mt-8 text-center text-body-sm text-fi-muted">
      Experienced investor? See whether <a href="/invest/sif/" class={lightLink}>a SIF suits you →</a>
    </p>
  </Section>
</Layout>
