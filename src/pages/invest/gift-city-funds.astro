---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import OwnerIntro from '../../components/ui/OwnerIntro.astro';
import AssessmentPreview from '../../components/ui/AssessmentPreview.astro';
import CredibilityStrip from '../../components/ui/CredibilityStrip.astro';
import SplitRows from '../../components/ui/SplitRows.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { giftCityFaqGroups } from '../../lib/faq';
import { products } from '../../lib/products';
import { responsive } from '../../lib/responsive';
import { ARN, CREDENTIALS } from '../../lib/distributor';

// Landing page 4 of 4 (docs/landing_pages_plan.md): for residents who want
// part of their money in US dollars, and for NRIs. Same order as the SIF page:
// the facts and the assessment preview first, then the two residence routes
// (LRS, TCS, eligibility), then costs. Tax stays general and points to the
// client's tax adviser. Names no fund house or fund; no return claims.
// Indexed on dev; the tax, LRS and transaction points are checked before
// release (log item 110). Placements start with `lp_gift_city_`.

const giftCity = products.find((product) => product.title === 'GIFT City funds')!;
// Labels match "A SIF at a glance", so the two product pages read alike.
const facts = [
  { label: 'Consider it if', value: 'You want part of your portfolio in US dollars, for future dollar spending or exposure beyond Indian markets, and can accept currency risk.' },
  { label: 'Minimum', value: giftCity.minimum },
  { label: 'Main risks', value: 'The underlying investments can lose value. Your rupee value also moves with the exchange rate. Liquidity, tax and reporting depend on the fund and your residence.' },
];

// Residence changes the setup questions; neither route assumes eligibility.
const residenceRoutes = [
  { title: 'Resident in India', body: 'You invest under the Liberalised Remittance Scheme (LRS): up to USD 250,000 per person in a financial year, across all uses. TCS can apply above a yearly threshold and can be adjusted against your income tax.' },
  { title: 'NRI', body: 'We confirm whether the fund accepts investors from your country of residence, and which funding route and documents apply. The resident LRS route is not the NRI route.' },
];

const steps = [
  {
    name: 'First conversation',
    left: 'Tell us your goals, where you live and where you expect to spend the money.',
    right: 'Discuss your risk profile and whether dollar investments have a role in your portfolio.',
  },
  {
    name: 'Assessment and brief',
    left: 'Share your holdings after the call. Read the brief and confirm tax questions with your tax adviser.',
    right: 'Explain the fit, fund risks, costs and liquidity. Confirm eligibility and the funding route for your residence and selected fund.',
  },
  {
    name: 'Your decision and support',
    left: 'Approve each step and pay the provider directly. Residents use the applicable LRS route; NRIs use the confirmed funding route.',
    right: 'Disclose our commission, help with KYC and setup, and review the investment with your wider portfolio.',
  },
];

const callDetails = '30-minute call · No charge · No obligation';
---

<Layout
  title="GIFT City funds: invest in US dollars - Fund Investigator"
  description="Want part of your money in US dollars? GIFT City funds for residents under the LRS and for NRIs. We check fit and explain the tax points first."
  trackView="landing_view"
  trackLanding="gift_city"
>
  <Hero size="md" background="dark">
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words max-w-4xl mx-auto']}>
      Want part of your money
      <span class="block text-fi-gold">in US dollars?</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed mb-8']}>
      GIFT City funds are based in India's international financial centre and held in US dollars. They carry investment risk and currency risk. We check the fit and the route for residents in India and NRIs before you decide.
    </p>
    <ContactActions placement="lp_gift_city_hero" surface="dark" note={callDetails} />

    <div class="mt-10 border-t border-fi-border-dark">
      <!-- "40+ fund houses empanelled" is a mutual fund credential, so it stays off this page. -->
      <CredibilityStrip markers={[`AMFI-registered (${ARN})`, CREDENTIALS[0].text, 'Transparent disclosures']} />
    </div>
  </Hero>

  <Section id="what-are-gift-city-funds" background="white" spacing="md" maxWidth="2xl">
    <OwnerIntro class="mb-10" />
    <SectionHeading
      title="GIFT City funds at a glance."
      lead="Funds based in GIFT City (IFSC), regulated by the International Financial Services Centres Authority (IFSCA) and held in US dollars. They differ from Indian mutual funds in currency, tax and reporting."
    />
    <dl class="grid sm:grid-cols-3 gap-5 text-left">
      {facts.map((fact) => (
        <Card padding="lg" hover={false} class="h-full">
          <dt class="text-caption uppercase text-fi-muted mb-2">{fact.label}</dt>
          <dd class="text-body-md text-fi-ink leading-relaxed">{fact.value}</dd>
        </Card>
      ))}
    </dl>
    <AssessmentPreview variant="gift-city" class="mt-8" />
  </Section>

  <Section id="routes" background="light" spacing="md" maxWidth="2xl">
    <SectionHeading title="Two routes. Start with where you live." lead="Your residence decides how you invest, which documents apply and how the money moves." />
    <div class="grid sm:grid-cols-2 gap-5 text-left">
      {residenceRoutes.map((route) => (
        <Card padding="lg" hover={false} class="h-full">
          <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{route.title}</h3>
          <p class="text-body-sm text-fi-muted leading-relaxed">{route.body}</p>
        </Card>
      ))}
    </div>
    <p class="text-body-sm text-fi-muted leading-relaxed text-center max-w-2xl mx-auto mt-6">Tax and reporting differ from rupee funds. Confirm the points that apply to your residence and chosen fund with your tax adviser before investing.</p>
  </Section>

  <Section id="costs" background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="How we are paid."
      lead="No separate fee from you. The fund house pays our commission from the fund's yearly expenses. You get our commission in writing before you decide."
    />
    <Card variant="subtle" padding="md" hover={false} class="max-w-2xl mx-auto text-left">
      <h3 class="text-body-md font-bold text-fi-ink mb-1">Everything in writing first</h3>
      <p class="text-body-sm text-fi-muted leading-relaxed">
        Before you invest, you get the fund's risks, costs, liquidity and our commission in writing. You pay the provider directly, and nothing moves without your approval.
      </p>
    </Card>
    <ContactActions placement="lp_gift_city_cta" surface="light" identity class="mt-12" />
  </Section>

  <Section id="how-it-works" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="Your portfolio first. Then decide whether dollar funds fit." lead="What you do, and what we do, at each stage." />
    <SplitRows rows={steps} rowLabel="Stage" columns={[{ label: 'You' }, { label: 'We' }]} numbered />
  </Section>

  <Section id="faq" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions about GIFT City funds" />
    <div class="max-w-3xl mx-auto text-left">
      {giftCityFaqGroups.map((group, index) => (
        <div class={index > 0 ? 'mt-8' : ''}>
          <h3 class="text-heading-sm font-bold text-fi-ink mb-3">{group.title}</h3>
          <FaqList items={group.items} openFirst={index === 0} />
        </div>
      ))}
    </div>
  </Section>

  <Section background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="Ask whether GIFT City funds suit you."
      lead="A 30-minute call. We look at your goals and what you hold first, and you decide what happens next."
    />
    <ContactActions placement="lp_gift_city_final" surface="light" />
  </Section>
</Layout>
