---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import CheckList from '../../components/ui/CheckList.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import OwnerIntro from '../../components/ui/OwnerIntro.astro';
import SampleBrief from '../../components/ui/SampleBrief.astro';
import CredibilityStrip from '../../components/ui/CredibilityStrip.astro';
import SplitRows from '../../components/ui/SplitRows.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { startFaq } from '../../lib/faq';
import { responsive } from '../../lib/responsive';
import { ARN } from '../../lib/distributor';

// Landing page 2 of 4 (docs/landing_pages_plan.md): for readers with savings
// who want to start investing and are new to mutual funds. The page
// never runs down FDs or other savings (they can stay; the call decides how
// much, if any, goes into funds, and when). Their main worry is losing money or
// getting the timing wrong, so the page shows a careful process (safety net,
// a suitable mix and investment route), never a return.
// Draft copy: the owner checks it (S56). Placements start with `lp_start_`.

// The reader's situation, in their words.
const signs = [
  'How much should I invest, and what should I keep aside?',
  'Which types of funds suit me, and how much could they fall?',
  'Should I invest at once or spread it over time?',
];

// How we start a first-time investor: four steps of the process, in order.
const approach = [
  { title: 'Goals first', body: 'What the money is for, when you need it, and how much risk you can live with. The funds come after.' },
  { title: 'A safety net', body: 'Keep an accessible emergency reserve separate from the money you plan to invest. We discuss what you may need before choosing funds.' },
  { title: 'A simple mix', body: 'A few funds that suit your risk profile, each with the reasons and the costs in writing.' },
  { title: 'A suitable way in', body: 'SIP, lump sum or investing in stages: we discuss the options based on your circumstances. A staged approach does not remove market risk.' },
];

// From booking to the first investment, then the reviews.
const steps = [
  {
    name: 'First conversation',
    left: 'Tell us what your savings are for and when you may need them.',
    right: 'Discuss your risk profile, emergency reserve and the main fund categories.',
  },
  {
    name: 'Your starting brief',
    left: 'Read the brief and ask questions before choosing.',
    right: 'Explain what stays aside, a suitable mix and how to invest. Give you the reasons, costs and our commission in writing.',
  },
  {
    name: 'Setup and support',
    left: 'Complete KYC with our help. Approve transactions by OTP and pay the fund house directly.',
    right: 'Help set up your investments and review them at regular intervals. Your units stay in your name.',
  },
];

const callDetails = '30-minute call · No charge · No obligation';
const lightLink = 'font-semibold text-fi-link underline decoration-fi-link/40 hover:decoration-fi-link';
---

<Layout
  title="Start investing in mutual funds - Fund Investigator"
  description="Start investing in mutual funds with support. Begin with a 30-minute call about your goals, followed by a starting brief, costs and setup help."
  trackView="landing_view"
  trackLanding="start"
>
  <Hero size="md" background="dark">
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words max-w-4xl mx-auto']}>
      Have savings?
      <span class="block text-fi-gold">Start with mutual funds.</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed mb-8']}>
      Start with what your money is for and when you need it. We help you choose a suitable mix of mutual funds, explain the costs, and support you through the setup.
    </p>
    <ContactActions placement="lp_start_hero" surface="dark" note={callDetails} />

    <div class="mt-8">
      <SampleBrief variant="start" />
    </div>

    <div class="mt-10 border-t border-fi-border-dark">
      <CredibilityStrip markers={[`AMFI-registered (${ARN})`, '40+ fund houses empanelled', 'Transparent disclosures']} />
    </div>
  </Hero>

  <Section background="white" spacing="md" maxWidth="lg">
    <OwnerIntro class="mb-10" />
    <SectionHeading title="Start with your questions." lead="Questions you may have before starting." />
    <Card variant="subtle" padding="lg" hover={false} class="max-w-2xl mx-auto">
      <CheckList items={signs} />
    </Card>
  </Section>

  <Section id="approach" background="light" spacing="md" maxWidth="2xl">
    <SectionHeading title="How we help you start." lead="A careful process, so your first investment is not a guess." />
    <ol class="grid sm:grid-cols-2 gap-5 text-left">
      {approach.map((item, index) => (
        <li data-reveal={index}>
          <Card padding="lg" hover={false} class="h-full">
            <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{item.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed">{item.body}</p>
          </Card>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="costs" background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="How we are paid."
      lead="No separate fee from you. The fund house pays our commission from the regular plan's yearly expense ratio. You get our commission on each fund, in writing, before you decide."
    />
    <!-- The main reassurance for a first-time investor: we never hold the money. -->
    <Card variant="subtle" padding="md" hover={false} class="max-w-2xl mx-auto text-left">
      <h3 class="text-body-md font-bold text-fi-ink mb-1">Your money goes to the fund house</h3>
      <p class="text-body-sm text-fi-muted leading-relaxed">
        You pay each fund house directly, and the units are in your name. We never receive your money, and nothing moves without your approval.
      </p>
    </Card>
    <p class="text-center text-body-sm mt-6">
      <a href="/invest/#costs" class={lightLink}>Compare direct and regular plans →</a>
    </p>
    <ContactActions placement="lp_start_cta" surface="light" identity class="mt-12" />
  </Section>

  <Section id="how-it-works" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="From the first call to your first investment." lead="What you do, and what we do, at each stage." />
    <SplitRows rows={steps} rowLabel="Stage" columns={[{ label: 'You' }, { label: 'We' }]} numbered />
  </Section>

  <Section id="faq" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions before you start" />
    <div class="max-w-3xl mx-auto text-left">
      <FaqList items={startFaq} />
    </div>
  </Section>

  <Section background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="Start with a 30-minute call."
      lead="Tell us what you have saved and what it is for. We explain how we would start, and you decide what happens next."
    />
    <ContactActions placement="lp_start_final" surface="light" />
    <p class="mt-8 text-center text-body-sm text-fi-muted">
      Already hold some funds? <a href="/invest/portfolio-review/" class={lightLink}>Start with a portfolio review →</a>
    </p>
  </Section>
</Layout>
