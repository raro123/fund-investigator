---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Kicker from '../../components/ui/Kicker.astro';
import Memo from '../../components/ui/Memo.astro';
import Highlight from '../../components/ui/Highlight.astro';
import SampleSifBrief from '../../components/ui/SampleSifBrief.astro';
import RiskDisclosures from '../../components/ui/RiskDisclosures.astro';
import StepMemos from '../../components/ui/StepMemos.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import Button from '../../components/ui/Button.astro';
import IdCard from '../../components/ui/IdCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { sifFaq } from '../../lib/faq';
import { responsive } from '../../lib/responsive';
import { trackAttrs } from '../../lib/analytics';
import { whatsappUrl } from '../../lib/whatsapp';
import { SUBSCRIBE_PAGE } from '../../lib/substack';
import { ARN, CONTACT_EMAIL, CREDENTIALS, REGISTERED_NAME, TAGLINE } from '../../lib/distributor';
import { servicePageSchemaGraph } from '../../lib/schema';

// Service page C (/invest/sif/): brand-led ("we" by default, writing_rules §3),
// with the owner's name in the mandatory R-01 identity line and a brief signed
// personal note inside the Section 5 IdCard. WhatsApp stays primary (gold),
// paired with a secondary "Book a first call" option and email fallback for
// desktop and privacy-conscious ₹10L+ readers. SIF promotional copy: needs the
// compliance officer's H-08 PASS before release. Risk disclosures sit inline at
// body size in Section 3 so warnings show once and the white FAQ band stays
// separated from the dark footer. Names no fund house, SIF brand or SEBI
// strategy category (H-05), makes no PMS/AIF comparison (decision 88), makes no
// return or safety claims (R-10, R-13), avoids H-01 banned terms, and cites the
// SEBI circular inline next to regulatory figures (H-10). Placements: `lp_sif_`.

const pageTitle = 'Specialized Investment Funds (SIF)';
const pageDescription = 'Specialized Investment Funds (SIF) start at ₹10 lakh and carry higher risk. See the rules most investors miss and how Fund Investigator helps you decide.';
const whatsappLabel = 'Ask us on WhatsApp';

// Block 2: USP first — cross-fund-house comparison, portfolio fit & sizing, written clarity.
const helps = [
  {
    eyebrow: 'Cross-fund-house view',
    title: 'Compare across fund houses',
    body: "Each fund house explains only its own SIF. We are not tied to one — we shortlist options across fund houses and lay out each strategy's risks, redemption terms and costs side by side.",
  },
  {
    eyebrow: 'Portfolio fit & sizing',
    title: 'Check fit against what you hold',
    body: "We measure stock and sector overlap with your existing mutual funds and check whether ₹10 lakh is a sensible slice of your overall portfolio. If a SIF doesn't fit, we say why.",
  },
  {
    eyebrow: 'Everything in writing',
    title: 'See every trade-off upfront',
    body: 'How the strategy uses derivatives, how it can make and lose money, its SEBI Risk-Band, tax structure and our commission — all shared in writing before you decide.',
  },
];

// Block 3a: elevated first so already-interested ₹10L+ investors immediately see the
// non-obvious regulatory and portfolio fine print that separates careful analysis from hype.
const finePrintChecks = [
  {
    number: '1',
    title: 'The ₹10 lakh breach and 30-day freeze rule',
    points: [
      "The ₹10 lakh minimum is tracked per investor (PAN) across one fund house's SIF strategies — regular mutual funds do not count towards it.",
      'If a withdrawal takes you below ₹10 lakh, remaining units are frozen and redeemed after 30 days unless you top up.',
      'If market falls take you below ₹10 lakh, you can only redeem everything — not a part.',
    ],
  },
  {
    number: '2',
    title: 'Restricted redemption windows and notice periods',
    points: [
      'Unlike standard open-ended mutual funds, a SIF strategy may allow redemptions only on set days, require advance notice, or carry lock-ins and exit loads.',
      'Checking exit terms before committing ₹10 lakh prevents surprises when you need liquidity.',
    ],
  },
  {
    number: '3',
    title: 'Overlap and sizing inside your existing portfolio',
    points: [
      'A SIF rarely replaces your core mutual funds. If its long book holds the same stocks or sectors you already own — or if ₹10 lakh is too large a share of your portfolio — it can add concentration instead of diversification.',
    ],
  },
];

// Block 3b: compact 2x2 factual differences from regular mutual funds. No return,
// protection or safety claims, no PMS/AIF comparison (decision 88), no SEBI
// strategy category names (H-05), and no H-01 "independent" wording.
const features = [
  {
    title: 'Unhedged short positions (up to 25%)',
    body: 'Regular mutual funds use derivatives mainly to hedge or rebalance. A SIF can take unhedged short positions up to 25% of its value when the manager expects a stock or sector to fall.',
  },
  {
    title: 'Bond strategies can short too',
    body: 'In a debt strategy, the manager can short bond derivatives — for example, when expecting interest rates to rise and bond prices to fall.',
  },
  {
    title: 'Multi-asset and commodity derivatives',
    body: 'Some strategies spread across equity, bonds, REITs and InvITs, and use derivatives across those assets and commodities.',
  },
  {
    title: 'Mutual fund custody under SEBI rules',
    body: "A SIF is run by a mutual fund house under SEBI's framework, with assets held by a separate custodian.",
  },
];

// Block 4: four clear steps separating zero-paperwork Q&A (Step 1) from optional
// portfolio overlap analysis (Step 2).
const steps = [
  {
    title: 'Ask anything first',
    body: 'Message us on WhatsApp or book a short call. We answer your questions on SIF rules, strategy structures and how we are paid — without needing your portfolio data.',
    fact: 'No sign-up · No follow-up spam',
  },
  {
    title: 'Optional portfolio fit check',
    body: 'Only if you want an overlap and sizing check, you complete a quick onboarding (no fee, no lock-in) and, with your consent, we fetch your mutual fund holdings. Your existing direct or regular funds stay untouched.',
    fact: 'Direct funds stay untouched',
  },
  {
    title: 'Written shortlist and costs',
    body: 'You get a written brief comparing suitable strategies across fund houses — covering risk band, redemption terms, tax structure and our commission — or clear reasons to wait.',
    fact: 'Shortlist + commission in writing',
  },
  {
    title: 'You approve every transaction',
    body: 'You pay the fund house directly, units stay in your name, and nothing moves without your approval. If you invest through us, we keep reviewing the SIF alongside your other funds.',
    fact: 'Paid to fund house · Units in your name',
  },
];

// Concrete starter prompts so visitors never face a blank chat box.
const starterPrompts = [
  'Check a specific SIF strategy you are considering',
  'Ask how notice periods, lock-ins or the ₹10 lakh rule work',
  'See whether a SIF overlaps with the mutual funds you already own',
];

const credentialSummary = CREDENTIALS.map((item) => item.text).join(' · ');
const darkLink = 'font-semibold text-fi-gold underline underline-offset-4 decoration-fi-gold/40 hover:decoration-fi-gold';
const lightLink = 'font-semibold text-fi-link underline underline-offset-4 decoration-fi-link/40 hover:decoration-fi-link';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogPage="sif"
  graph={servicePageSchemaGraph({
    path: '/invest/sif/',
    name: pageTitle,
    description: pageDescription,
    breadcrumbName: 'SIF',
    serviceName: 'SIF distribution',
    serviceType: 'Specialized Investment Fund (SIF) distribution by a registered SIF Distributor',
    faq: sifFaq,
  }, Astro.site)}
  trackView="landing_view"
  trackLanding="sif"
  riskDisclosures={false}
>
  <!-- 1. Hero: split. Question, qualification, WhatsApp-primary + call-booking option on the left;
       concrete illustrative SIF fit assessment on the right. Mandatory R-01 identity line plus
       compact credentials span the footer slot so expertise is visible above the fold. -->
  <Hero size="md" background="dark">
    <Kicker class="mb-6">Specialized Investment Funds (SIF)</Kicker>
    <h1 class:list={[responsive.displaySplit, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words text-balance']}>
      Is a SIF right for
      <span class="block text-fi-gold">your portfolio?</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-xl mx-auto lg:mx-0 font-light leading-relaxed text-pretty mb-8']}>
      A SIF requires at least ₹10 lakh and carries higher risk than a regular mutual fund. We compare strategies across fund houses, check how one fits what you already hold, and tell you when it makes more sense to wait.
    </p>
    <ContactActions
      placement="lp_sif_hero"
      surface="dark"
      align="split"
      whatsappPrimary
      whatsappLabel={whatsappLabel}
      note="Personal reply within 1 business day · No sign-up · No unsolicited follow-ups"
    />

    <!-- pr-2: room for the tilted back sheet on phones -->
    <div slot="aside" id="sample" class="pr-2 sm:pr-0">
      <SampleSifBrief />
    </div>

    <!-- Exact R-01 identity line + compact background credentials above the fold. -->
    <div slot="footer" class="mt-12 pt-6 border-t border-fi-border-dark max-w-4xl mx-auto text-center space-y-1.5">
      <p class="text-caption text-fi-subtle text-balance">
        <a href="/about/" class:list={[darkLink, 'inline-block py-1']}>{REGISTERED_NAME}</a> · {TAGLINE} · {ARN}
      </p>
      <p class="text-caption text-fi-muted-inv text-balance">
        {credentialSummary}
      </p>
    </div>
  </Hero>

  <!-- 2. How we help: USP first (cross-fund-house comparison, portfolio fit & sizing, written clarity). -->
  <Section id="how-we-help" background="white" spacing="md" maxWidth="xl">
    <SectionHeading
      title="How Fund Investigator helps you decide on a SIF"
      lead="As a registered SIF Distributor, we evaluate SIF strategies across fund houses against the portfolio you already hold."
    />
    <ul role="list" class="grid lg:grid-cols-3 gap-5 text-left max-w-5xl mx-auto">
      {helps.map((help, index) => (
        <li data-reveal={index}>
          <Card padding="lg" hover={false} class="h-full">
            <p class="font-mono text-caption uppercase text-fi-muted mb-2">{help.eyebrow}</p>
            <h3 class="text-heading-sm font-bold text-fi-ink mb-2 text-balance">{help.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed text-pretty">{help.body}</p>
          </Card>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-center text-body-sm">
      <a href="/reports/" class:list={[lightLink, 'inline-block py-2']}>See how we analyse funds →</a>
    </p>
  </Section>

  <!-- 3. Before you commit ₹10 lakh: high-value fine-print rules elevated first, followed by
       compact 2x2 strategy differences and inline body-size risk disclosures. -->
  <Section id="what-is-a-sif" background="light" spacing="md" maxWidth="xl">
    <SectionHeading
      title="Before you commit ₹10 lakh: what a SIF changes"
      lead="A Specialized Investment Fund (SIF) is a SEBI category run by mutual fund houses. It allows more flexible strategies than regular mutual funds — along with higher risk and stricter liquidity rules."
    />
    <div class="space-y-8 max-w-4xl mx-auto">
      <div data-reveal={0}>
        <Card variant="elevated" padding="lg" hover={false} class="text-left">
          <p class="text-body-sm font-semibold text-fi-link mb-2">
            The fine print
          </p>
          <h3 class="text-heading-md font-bold text-fi-ink text-balance mb-6">
            Three rules most investors miss about SIFs
          </h3>
          <ol role="list" class="divide-y divide-fi-border">
            {finePrintChecks.map((check) => (
              <li class="py-5 first:pt-0 last:pb-0 flex items-start gap-4">
                <span class="w-7 h-7 rounded-full bg-fi-light text-fi-ink text-body-sm font-bold flex items-center justify-center shrink-0 tabular-nums" aria-hidden="true">{check.number}</span>
                <div class="min-w-0 max-w-fi-content">
                  <h4 class="text-body-md font-bold text-fi-ink mb-2 text-balance">{check.title}</h4>
                  <div class="space-y-2">
                    {check.points.map((point) => (
                      <p class="text-body-sm text-fi-muted leading-relaxed text-pretty">{point}</p>
                    ))}
                  </div>
                </div>
              </li>
            ))}
          </ol>
          <p class="mt-6 pt-4 border-t border-fi-border text-body-sm text-fi-muted max-w-fi-content text-pretty">
            <strong class="font-semibold text-fi-ink">Source:</strong> SEBI circular on Specialized Investment Funds, 27 February 2025 (₹10 lakh PAN-level minimum per fund house, breach and 30-day freeze rule, and 25% unhedged short-exposure limit).
          </p>
        </Card>
      </div>

      <div>
        <h3 class:list={[responsive.h3, 'font-bold text-fi-ink text-center text-balance mb-5']}>
          How SIF strategies differ from regular mutual funds
        </h3>
        <ul role="list" class="grid sm:grid-cols-2 gap-5 text-left">
          {features.map((feature, index) => (
            <li data-reveal={index}>
              <Card padding="lg" hover={false} class="h-full">
                <h4 class="text-heading-sm font-bold text-fi-ink mb-2 text-balance">{feature.title}</h4>
                <p class="text-body-sm text-fi-muted leading-relaxed text-pretty">{feature.body}</p>
              </Card>
            </li>
          ))}
        </ul>
      </div>

      <RiskDisclosures inline class="max-w-4xl" />
    </div>
  </Section>

  <!-- 4. What happens after you reach out: clear boundary between zero-paperwork Q&A (Step 1)
       and optional portfolio fit check (Step 2), flowing directly into Section 5. -->
  <Section id="how-it-works" background="white" spacing="md" maxWidth="xl">
    <SectionHeading
      title="What happens after you reach out?"
      lead="Start with a quick question — zero paperwork unless you want a full portfolio fit check."
    />
    <StepMemos steps={steps} layout="pairs" bodyFont="sans" />
  </Section>

  <!-- 5. Who you work with, Direct vs Regular fee clarity, and main dual-path CTA. -->
  <Section id="who" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="Who you work with, and how we are paid" />
    <div data-reveal={0}>
      <IdCard class="mx-auto w-full max-w-2xl">
        <p>You work directly with me from your first message to every portfolio review. I walk you through the numbers, the liquidity fine print and the trade-offs — and tell you plainly if a SIF does not fit what you already hold.</p>
      </IdCard>
    </div>
    <div data-reveal={1} class="mt-10">
      <Memo label="How we are paid" title="No separate fee from you." stamp="Disclosed">
        We earn a commission from the fund house on regular plans, and share the rates <Highlight>in writing before you invest</Highlight>. Regular plans carry a higher expense ratio than direct plans, which covers our analysis and ongoing portfolio reviews.
      </Memo>
    </div>

    <div class="mt-12 text-center max-w-2xl mx-auto">
      <h3 class:list={[responsive.h3, 'font-bold text-fi-ink text-balance mb-3']}>Start with a question</h3>
      <p class="text-body-md text-fi-muted leading-relaxed text-pretty mb-5">
        Not sure what to write? Here are three ways most investors start:
      </p>
      <ul role="list" class="mb-8 inline-block text-left space-y-2 text-body-sm text-fi-muted">
        {starterPrompts.map((prompt) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-fi-link shrink-0" aria-hidden="true"></span>
            <span class="text-pretty">{prompt}</span>
          </li>
        ))}
      </ul>
      <ContactActions placement="lp_sif_cta" surface="light" whatsappPrimary whatsappLabel={whatsappLabel} />
      <p class="mt-4 text-body-sm text-fi-muted text-pretty">
        We reply within 1 business day, and only follow up if you ask. Prefer email? <a href={`mailto:${CONTACT_EMAIL}`} class:list={[lightLink, 'inline-block py-1']}>{CONTACT_EMAIL}</a>
      </p>
      <p class="mt-3 text-body-sm">
        <a href={SUBSCRIBE_PAGE} class:list={[lightLink, 'inline-block py-2']} {...trackAttrs('subscribe_click', 'lp_sif_cta')}>Not ready yet? Get the monthly note</a>
      </p>
    </div>
  </Section>

  <!-- 6. FAQ: direct vs regular, taxation, liquidity, existing funds & custody.
       White section stays separated from the dark footer. -->
  <Section id="faq" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions about SIFs" />
    <div class="max-w-3xl mx-auto text-left">
      <FaqList items={sifFaq} />
    </div>
    <div class="mt-12 flex flex-col items-center gap-4 text-center">
      <p class="text-body-md font-semibold text-fi-ink">Still have a question?</p>
      <Button
        href={whatsappUrl('lp_sif_final')}
        target="_blank"
        rel="noopener noreferrer"
        icon="whatsapp"
        variant="secondary"
        surface="light"
        size="lg"
        track={{ event: 'conversation_request', placement: 'lp_sif_final', channel: 'whatsapp' }}
        class="w-full max-w-80 sm:w-auto sm:max-w-none"
      >
        {whatsappLabel}
      </Button>
    </div>
  </Section>
</Layout>
