---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Kicker from '../../components/ui/Kicker.astro';
import Memo from '../../components/ui/Memo.astro';
import Highlight from '../../components/ui/Highlight.astro';
import SampleSifBrief from '../../components/ui/SampleSifBrief.astro';
import RiskDisclosures from '../../components/ui/RiskDisclosures.astro';
import StepMemos from '../../components/ui/StepMemos.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import Button from '../../components/ui/Button.astro';
import IdCard from '../../components/ui/IdCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { sifFaq } from '../../lib/faq';
import { responsive } from '../../lib/responsive';
import { trackAttrs } from '../../lib/analytics';
import { whatsappUrl } from '../../lib/whatsapp';
import { SUBSCRIBE_PAGE } from '../../lib/substack';
import { ARN, CONTACT_EMAIL, REGISTERED_NAME, TAGLINE } from '../../lib/distributor';
import { servicePageSchemaGraph } from '../../lib/schema';

// Service page C (/invest/sif/): goal-first, WhatsApp primary (decision 121),
// with a quiet email fallback near the Section 5 CTA for privacy-conscious
// readers. SIF promotional copy: needs the compliance officer's H-08 PASS
// before release. Risk disclosures sit inline at body size in Section 3 so
// warnings show once and the white FAQ section stays separated from the dark
// footer. Names no fund house, SIF brand or SEBI strategy category (H-05),
// makes no PMS/AIF comparison (decision 88), makes no return or safety claims
// (R-10, R-13), avoids H-01 banned terms, and cites the SEBI circular inline
// next to regulatory figures (H-10). Placements start with `lp_sif_`.

const pageTitle = 'Is a SIF right for your portfolio?';
const pageDescription = 'Specialized Investment Funds (SIF) start at ₹10 lakh and carry higher risk. See the rules most investors miss and how Fund Investigator helps you decide.';
// Every WhatsApp button uses the same label, so the one action reads the same.
const whatsappLabel = 'Ask Ishpreet on WhatsApp';

// Block 2: what we do for you. Three cards; after-care lives in step 4 only.
const helps = [
  {
    title: 'We explain the whole product.',
    body: 'How the strategy uses derivatives, how it can make and lose money, its SEBI Risk-Band, its redemption terms and its costs, including our commission, in writing.',
  },
  {
    title: 'We check how it fits your portfolio.',
    body: "What it adds to the stocks and sectors you already hold, and whether you can keep ₹10 lakh invested for as long as the strategy needs. If a SIF doesn't fit, we say so and tell you why.",
  },
  {
    title: 'We compare across fund houses.',
    body: 'Each fund house explains only its own SIF. We are not tied to one. We compare the options across fund houses, shortlist the strategies that fit you, and show what each one costs.',
  },
];

// Block 3a: four factual features in clean sans cards. No return, protection
// or safety claims, no PMS/AIF comparison (decision 88), no SEBI strategy
// category names (H-05), and no H-01 "independent" wording.
const features = [
  {
    title: 'Can take unhedged short positions (up to 25%)',
    body: 'Unlike a regular mutual fund, which uses derivatives only to hedge or rebalance, a SIF can take unhedged short positions up to 25% of its value when the manager expects a stock or sector to fall.',
  },
  {
    title: 'Bond strategies can short too',
    body: 'In a debt strategy, the fund manager can take short positions in bond derivatives, for example when they expect interest rates to rise and bond prices to fall.',
  },
  {
    title: 'Some strategies mix asset classes',
    body: 'Some strategies spread across equity, bonds, REITs and InvITs, and use derivatives on them and on commodities.',
  },
  {
    title: 'Runs under mutual fund rules',
    body: "A SIF is run by a mutual fund house under SEBI's rules. A separate custodian holds the assets. Each strategy's lock-in, exit load and redemption terms are in its documents.",
  },
];

// Block 3b: the fine-print rules that most ₹10L+ investors miss before buying
// a SIF — surfaced prominently instead of buried in collapsed FAQs. Facts only;
// SEBI circular source sits directly below.
const finePrintChecks = [
  {
    number: '01',
    title: 'The ₹10 lakh breach and 30-day freeze rule',
    body: 'The ₹10 lakh minimum is tracked per investor (PAN) across one fund house’s SIF strategies, and regular mutual funds do not count towards it. If a withdrawal takes you below ₹10 lakh, your remaining units are frozen and sold after 30 days unless you top up. If market falls take you below ₹10 lakh, you can only redeem everything — not a part.',
  },
  {
    number: '02',
    title: 'Restricted redemption windows and notice periods',
    body: 'Unlike standard open-ended mutual funds, a SIF strategy may allow redemptions only on set days, require advance notice, or carry lock-ins and exit loads. Checking exit terms before committing ₹10 lakh prevents surprises when you need liquidity.',
  },
  {
    number: '03',
    title: 'Overlap with the mutual funds you already own',
    body: 'A SIF does not sit in isolation. If its long book holds the same stocks or sectors as your existing mutual funds, putting ₹10 lakh into it can concentrate your portfolio instead of adding something new.',
  },
];

// Block 4: four steps in 2x2 pairs (sans body), each with a mono fact line
// answering the reader's primary objection at that step.
const steps = [
  {
    title: 'Personal reply from Ishpreet',
    body: 'Ishpreet answers your SIF questions and explains how we are paid, with no sign-up.',
    fact: 'No sign-up · No follow-up spam',
  },
  {
    title: 'You choose whether to share your holdings',
    body: 'For a detailed fit check, you complete a short client registration and, with your consent, we fetch your mutual fund holdings. Your existing direct or regular funds stay untouched, and you are not committed to invest.',
    fact: 'Existing direct funds stay untouched',
  },
  {
    title: 'You get the risks and costs in writing',
    body: "If a SIF adds something to your portfolio, you get a shortlist across fund houses with each strategy's risks, redemption terms and costs; if not, we tell you why.",
    fact: 'Shortlist + commission in writing',
  },
  {
    title: 'You approve every investment',
    body: 'You pay the fund house directly, units stay in your name, and nothing moves without your approval. If you invest through us, we review the SIF with your other funds at regular intervals.',
    fact: 'Paid to fund house · Units in your name',
  },
];

const darkLink = 'font-semibold text-fi-gold underline underline-offset-4 decoration-fi-gold/40 hover:decoration-fi-gold';
const lightLink = 'font-semibold text-fi-link underline underline-offset-4 decoration-fi-link/40 hover:decoration-fi-link';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogPage="sif"
  graph={servicePageSchemaGraph({
    path: '/invest/sif/',
    name: pageTitle,
    description: pageDescription,
    breadcrumbName: 'SIF',
    serviceName: 'SIF distribution',
    serviceType: 'Specialized Investment Fund (SIF) distribution by a registered SIF Distributor',
    faq: sifFaq,
  }, Astro.site)}
  trackView="landing_view"
  trackLanding="sif"
  riskDisclosures={false}
>
  <!-- 1. Hero: split, matching /invest/portfolio-review/. Question, qualification and one action
       on the left; the illustrative SIF fit assessment on the right so proof is visible above
       the fold on desktop. Exact identity line (R-01) spans full width in the footer slot. -->
  <Hero size="md" background="dark">
    <Kicker class="mb-6">Specialized Investment Funds (SIF)</Kicker>
    <h1 class:list={[responsive.displaySplit, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words text-balance']}>
      Is a SIF right for
      <span class="block text-fi-gold">your portfolio?</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-xl mx-auto lg:mx-0 font-light leading-relaxed mb-8']}>
      A SIF needs at least ₹10 lakh and carries higher risk than a regular mutual fund. Whether you have a specific SIF in mind or are just exploring, we compare strategies across fund houses, check how one fits your existing portfolio, and tell you when it makes more sense to wait.
    </p>
    <ContactActions
      placement="lp_sif_hero"
      surface="dark"
      align="split"
      whatsappOnly
      whatsappLabel={whatsappLabel}
      note="Ishpreet replies personally · No sign-up · No unsolicited follow-ups"
    />

    <!-- pr-2: room for the tilted back sheet on phones -->
    <div slot="aside" id="sample" class="pr-2 sm:pr-0">
      <SampleSifBrief />
    </div>

    <!-- The identity line, exact (R-01 / L1): name, AMFI tagline, ARN. -->
    <div slot="footer" class="mt-12 pt-6 border-t border-fi-border-dark max-w-3xl mx-auto text-center">
      <p class="text-caption text-fi-subtle text-balance">
        <a href="/about/" class={darkLink}>{REGISTERED_NAME}</a> · {TAGLINE} · {ARN}
      </p>
    </div>
  </Hero>

  <!-- 2. How we help: the USP first. Stacks until lg so three cards never cramp on tablets. -->
  <Section id="how-we-help" background="white" spacing="md" maxWidth="xl">
    <SectionHeading
      title="How does Fund Investigator help you decide on a SIF?"
      lead="As a registered SIF Distributor, we are trained in how SIF strategies work. Here is what that means for you."
    />
    <div class="grid lg:grid-cols-3 gap-5 text-left max-w-5xl mx-auto">
      {helps.map((help, index) => (
        <div data-reveal={index}>
          <Card padding="lg" hover={false} class="h-full">
            <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{help.title}</h3>
            <p class="text-body-sm text-fi-muted leading-relaxed">{help.body}</p>
          </Card>
        </div>
      ))}
    </div>
  </Section>

  <!-- 3. What is a SIF: crisp definition, 2x2 sans features, the 3 fine-print rules most
       investors miss, SEBI circular source, and the inline regulators' warnings at body size. -->
  <Section id="what-is-a-sif" background="light" spacing="md" maxWidth="xl">
    <SectionHeading
      title="What is a SIF?"
      lead="A Specialized Investment Fund (SIF) is a SEBI product category run by mutual fund houses. Unlike regular mutual funds, a SIF can take unhedged short positions up to 25% of its value — bringing different return drivers, higher risk and stricter rules."
    />
    <div class="space-y-6 max-w-4xl mx-auto">
      <div class="grid sm:grid-cols-2 gap-5 text-left">
        {features.map((feature, index) => (
          <div data-reveal={index}>
            <Card padding="lg" hover={false} class="h-full">
              <h3 class="text-heading-sm font-bold text-fi-ink mb-2">{feature.title}</h3>
              <p class="text-body-sm text-fi-muted leading-relaxed">{feature.body}</p>
            </Card>
          </div>
        ))}
      </div>

      <!-- High-trust domain proof: the 3 rules investors commonly overlook before committing ₹10L+. -->
      <div data-reveal={0} class="rounded-lg border border-fi-border bg-white shadow-fi-card px-6 py-6 lg:px-10 lg:py-8 text-left">
        <p class="font-mono text-caption uppercase text-fi-muted pb-3 mb-5 border-b border-dashed border-fi-border">
          Before you commit ₹10 lakh
        </p>
        <h3 class="text-heading-md font-bold text-fi-ink mb-5">
          Three rules most investors miss about SIFs
        </h3>
        <ol class="divide-y divide-dashed divide-fi-border">
          {finePrintChecks.map((check) => (
            <li class="py-4 first:pt-0 last:pb-0 flex items-start gap-4">
              <span class="font-mono text-caption font-bold text-fi-link pt-1 shrink-0 tabular-nums">{check.number}</span>
              <div>
                <h4 class="text-body-md font-bold text-fi-ink mb-1">{check.title}</h4>
                <p class="text-body-sm text-fi-muted leading-relaxed">{check.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-5 pt-4 border-t border-dashed border-fi-border font-mono text-caption text-fi-muted">
          Source: SEBI circular on Specialized Investment Funds, 27 February 2025 (₹10 lakh PAN-level minimum per fund house, breach/30-day rule, and 25% unhedged short-exposure limit).
        </p>
      </div>

      <RiskDisclosures inline class="max-w-4xl" />
    </div>
  </Section>

  <!-- 4. What happens after you message us: four steps in 2x2 pairs with objection-clearing fact
       lines, followed by a quiet secondary CTA so convinced readers can act right away. -->
  <Section id="how-it-works" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="What happens after you message us?" />
    <StepMemos steps={steps} layout="pairs" bodyFont="sans" />
    <div class="mt-10 flex flex-col items-center gap-3 text-center">
      <Button
        href={whatsappUrl('lp_sif_steps')}
        target="_blank"
        rel="noopener noreferrer"
        icon="whatsapp"
        variant="secondary"
        surface="light"
        size="lg"
        track={{ event: 'conversation_request', placement: 'lp_sif_steps', channel: 'whatsapp' }}
        class="w-full max-w-80 sm:w-auto sm:max-w-none"
      >
        {whatsappLabel}
      </Button>
      <p class="text-body-sm text-fi-muted">Have a SIF in mind, or just exploring? One message is enough.</p>
    </div>
  </Section>

  <!-- 5. Who you speak to, how we are paid, and the primary CTA with a quiet email fallback
       for privacy-conscious investors who prefer not to share WhatsApp first. -->
  <Section id="who" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="Who you speak to, and how we are paid" />
    <div data-reveal={0}>
      <IdCard class="mx-auto w-full max-w-2xl" />
    </div>
    <p class="mt-6 text-center text-body-sm">
      <a href="/reports/" class:list={[lightLink, 'inline-block py-2']}>Read our investigations →</a>
    </p>
    <div data-reveal={1} class="mt-8">
      <Memo label="How we are paid" title="No separate fee from you." stamp="Disclosed">
        We earn a commission from the fund house, and we give you the rates <Highlight>in writing before you invest</Highlight>.
      </Memo>
    </div>

    <div class="mt-12 text-center max-w-2xl mx-auto">
      <h3 class:list={[responsive.h3, 'font-bold text-fi-ink mb-3']}>Ask us about a SIF with one message</h3>
      <p class="text-body-md text-fi-muted leading-relaxed text-balance mb-8">
        Send a message with a SIF you are considering, or simply ask what a SIF would add to the funds you already own. If it helps, we set up a short call at a time that works for you.
      </p>
      <ContactActions placement="lp_sif_cta" surface="light" whatsappOnly whatsappLabel={whatsappLabel} />
      <p class="mt-4 text-body-sm text-fi-muted text-balance">
        We reply within 1 business day, and only follow up if you ask. Prefer email? <a href={`mailto:${CONTACT_EMAIL}`} class={lightLink}>{CONTACT_EMAIL}</a>
      </p>
      <p class="mt-4 text-body-sm">
        <a href={SUBSCRIBE_PAGE} class:list={[lightLink, 'inline-block py-2']} {...trackAttrs('subscribe_click', 'lp_sif_cta')}>Not ready? Get the monthly note</a>
      </p>
    </div>
  </Section>

  <!-- 6. FAQ: the doubts that stop the message. White section stays above the dark footer. -->
  <Section id="faq" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions about SIFs" />
    <div class="max-w-3xl mx-auto text-left">
      <FaqList items={sifFaq} />
    </div>
    <div class="mt-12 flex flex-col items-center gap-4 text-center">
      <p class="text-body-md font-semibold text-fi-ink">Still have a question?</p>
      <Button
        href={whatsappUrl('lp_sif_final')}
        target="_blank"
        rel="noopener noreferrer"
        icon="whatsapp"
        variant="secondary"
        surface="light"
        size="lg"
        track={{ event: 'conversation_request', placement: 'lp_sif_final', channel: 'whatsapp' }}
        class="w-full max-w-80 sm:w-auto sm:max-w-none"
      >
        {whatsappLabel}
      </Button>
    </div>
  </Section>
</Layout>
