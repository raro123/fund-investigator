---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import CheckList from '../../components/ui/CheckList.astro';
import CompareTable from '../../components/ui/CompareTable.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import FirstCallBlock from '../../components/ui/FirstCallBlock.astro';
import AssessmentPreview from '../../components/ui/AssessmentPreview.astro';
import CredibilityStrip from '../../components/ui/CredibilityStrip.astro';
import SplitRows from '../../components/ui/SplitRows.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { sifFaq } from '../../lib/faq';
import { responsive } from '../../lib/responsive';
import { formatDate } from '../../lib/format';
import { ARN } from '../../lib/distributor';
import { servicePageSchemaGraph } from '../../lib/schema';

// Service page C of Phase 2 (T-59; fund_distribution_business strategy/phase2_proposal.md).
// For readers who search "what is SIF in mutual funds" and "SIF vs PMS vs AIF".
// SIF promotional copy: every change needs the compliance officer's PASS (rulebook
// H-08). Copy v2.0, word for word: content/pieces/p2_service_pages/service_pages_copy.md.
// SEBI's SIF warning shows on every page in the site-wide Risk disclosures card
// (decision 25). Names no fund house, SIF brand or strategy (H-05) and makes no
// return claims. Placements start with `lp_sif_`.

const pageTitle = 'What is a SIF? SIF vs PMS vs AIF';
const pageDescription = 'Specialised Investment Funds start at ₹10 lakh and carry higher risks. See how a SIF differs from PMS and AIF, then check your whole portfolio first.';
const factsAsOf = '2026-11-03';
const sifSource = 'source: SEBI circular on Specialised Investment Funds, 27 February 2025';

const glance = [
  { label: 'What it is', value: 'A SEBI product category, run by mutual fund houses. It sits between mutual funds and portfolio management services.' },
  { label: 'Minimum', value: `₹10 lakh per investor, across one fund house's SIF investment strategies (${sifSource}).` },
  { label: 'Main risks', value: 'Derivatives can increase losses. Some SIF investment strategies limit when you can redeem. A SIF can do worse than a plain mutual fund for long periods. You can lose money.' },
];

const compareColumns = ['SIF', 'PMS (portfolio management service)', 'AIF (alternative investment fund)'];
const compareRows = [
  { name: 'Who runs it', cells: ["A mutual fund house, under SEBI's rules for SIFs", 'A SEBI-registered portfolio manager', 'A fund registered with SEBI as an AIF'] },
  { name: 'Minimum', cells: ["₹10 lakh per investor, across one fund house's SIF strategies", '₹50 lakh', '₹1 crore'] },
  { name: 'What you hold', cells: ['Units of a pooled investment strategy', 'Securities in your own name, managed for you', 'Units of a privately pooled fund'] },
  { name: 'Through us', cells: ['Yes. We are a registered SIF Distributor', 'No. We do not offer PMS', 'No. We do not offer AIFs'] },
];
const compareNote = `Sources: SEBI circular on Specialised Investment Funds, 27 February 2025; SEBI (Portfolio Managers) Regulations, 2020; SEBI (Alternative Investment Funds) Regulations, 2012. Minimums for investors who are not accredited investors. As of ${formatDate(factsAsOf)}.`;

const checks = [
  'Is your current portfolio already spread across asset types?',
  'Can you leave ₹10 lakh invested without needing it soon?',
  'Do you understand the strategy, its risks and when you can redeem?',
  'Can you accept long periods of weak results?',
];

const steps = [
  {
    name: 'First conversation',
    left: 'Tell us your goals, time frame and what you hold.',
    right: 'Discuss your risk profile and explain how SIFs work.',
  },
  {
    name: 'Portfolio assessment',
    left: 'Share your holdings or CAS after the call. Read the assessment and ask questions.',
    right: 'Review your portfolio. Then explain whether a SIF adds anything, with the risks, redemption terms and costs in writing.',
  },
  {
    name: 'Your decision and support',
    left: 'Decide whether to go ahead. Approve each transaction by OTP and pay the fund house directly.',
    right: 'Give you our commission in writing before you choose. Help with setup and review any SIF with your other funds.',
  },
];

// Not "No charge · No obligation": next to review wording it reads as a free review (H-03).
const callDetails = '30-minute call · You decide what happens next';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogPage="sif"
  graph={servicePageSchemaGraph({
    path: '/invest/sif/',
    name: pageTitle,
    description: pageDescription,
    breadcrumbName: 'SIF',
    serviceName: 'SIF distribution',
    serviceType: 'Specialised Investment Fund (SIF) distribution by a registered SIF Distributor',
    faq: sifFaq,
  }, Astro.site)}
  trackView="landing_view"
  trackLanding="sif"
>
  <Hero size="md" background="dark">
    <Badge variant="dark" class="mb-6">Specialised Investment Funds (SIF)</Badge>
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words max-w-4xl mx-auto']}>
      Thinking about a SIF?
      <span class="block text-fi-gold">Check your whole portfolio first.</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed mb-8']}>
      A Specialised Investment Fund (SIF) can use strategies that a mutual fund cannot, such as limited short positions through derivatives. The minimum is ₹10 lakh, and the risks are higher. On your request, we review what you already hold before you decide whether a SIF has a place in it.
    </p>
    <ContactActions placement="lp_sif_hero" surface="dark" note={callDetails} />

    <div class="mt-10 border-t border-fi-border-dark">
      <CredibilityStrip markers={[`AMFI-registered (${ARN})`, 'Registered SIF Distributor (NISM Series-XIII)', 'Commission in writing before you choose']} />
    </div>
  </Hero>

  <Section id="what-is-a-sif" background="white" spacing="md" maxWidth="2xl">
    <SectionHeading
      title="What is a SIF in mutual funds?"
      lead="A SIF is a SEBI product category, run by mutual fund houses. It sits between mutual funds and portfolio management services."
    />
    <dl class="grid md:grid-cols-3 gap-5 text-left">
      {glance.map((fact) => (
        <Card padding="lg" hover={false} class="h-full">
          <dt class="text-caption uppercase tracking-fi-label font-bold text-fi-muted mb-2">{fact.label}</dt>
          <dd class="text-body-sm text-fi-ink leading-relaxed">{fact.value}</dd>
        </Card>
      ))}
    </dl>
  </Section>

  <Section id="sif-pms-aif" background="light" spacing="md" maxWidth="2xl">
    <SectionHeading
      title="How is a SIF different from PMS and AIF?"
      lead="The biggest differences are the minimum amount and who runs it. All three are regulated by SEBI."
    />
    <CompareTable caption="SIF, PMS and AIF compared" columns={compareColumns} rows={compareRows} note={compareNote} highlight={0} />
    <p class="mt-6 text-body-sm text-fi-ink text-left">Risk, redemption terms, costs and tax differ between these products. Read each product's documents before you invest.</p>
  </Section>

  <Section id="checks" background="white" spacing="md" maxWidth="lg">
    <SectionHeading title="What should I check before a SIF?" />
    <Card variant="subtle" padding="lg" hover={false} class="max-w-2xl mx-auto">
      <CheckList items={checks} />
    </Card>
    <AssessmentPreview variant="sif" class="mt-8" />
  </Section>

  <Section id="costs" background="light" spacing="md" maxWidth="lg">
    <SectionHeading
      title="How we are paid"
      lead="No separate fee from you. We earn a commission from the fund house, and when you invest through us, and we give you the rate in writing before you invest."
    />
    <Card padding="md" hover={false} class="max-w-2xl mx-auto text-left">
      <h3 class="text-body-md font-bold text-fi-ink mb-1">Everything in writing first</h3>
      <p class="text-body-sm text-fi-muted leading-relaxed">
        Before you invest, you get the strategy, its main risks, when you can redeem and our commission, in writing. Nothing moves without your approval.
      </p>
    </Card>
    <ContactActions placement="lp_sif_cta" surface="light" identity class="mt-12" />
  </Section>

  <Section id="how-it-works" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Your portfolio first. Then the SIF question." lead="What you do, and what we do, at each stage." />
    <SplitRows rows={steps} rowLabel="Stage" columns={[{ label: 'You' }, { label: 'We' }]} numbered />
  </Section>

  <Section id="first-call" background="light" spacing="md" maxWidth="2xl">
    <FirstCallBlock placement="lp_sif_call" />
  </Section>

  <Section id="faq" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions about SIFs" />
    <div class="max-w-3xl mx-auto text-left">
      <FaqList items={sifFaq} />
    </div>
  </Section>

  <Section background="light" spacing="md" maxWidth="lg">
    <SectionHeading
      title="Ask about a SIF on a 30-minute call."
      lead="We look at what you hold first. You decide what happens next."
    />
    <ContactActions placement="lp_sif_final" surface="light" />
    <p class="text-center text-caption text-fi-muted mt-10">Page facts as of {formatDate(factsAsOf)}.</p>
  </Section>
</Layout>
