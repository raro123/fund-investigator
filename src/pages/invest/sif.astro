---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import OwnerIntro from '../../components/ui/OwnerIntro.astro';
import AssessmentPreview from '../../components/ui/AssessmentPreview.astro';
import CredibilityStrip from '../../components/ui/CredibilityStrip.astro';
import SplitRows from '../../components/ui/SplitRows.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { sifFaq } from '../../lib/faq';
import { products } from '../../lib/products';
import { responsive } from '../../lib/responsive';
import { ARN } from '../../lib/distributor';

// Landing page 3 of 4 (docs/landing_pages_plan.md): for experienced investors
// asking whether a SIF suits them. A suitability page, not a sales page: who a
// SIF suits comes before the process, and the minimum and main risks sit in
// "A SIF at a glance". Names no fund house or strategy by name and makes no
// return claims.
// Indexed on dev; the copy is checked against the SIF promotion rules before
// release (log item 110). Placements start with `lp_sif_`.

const sif = products.find((product) => product.title === 'SIFs')!;
const facts = [
  { label: 'Consider it if', value: 'You have a diversified mutual fund portfolio, can commit the minimum without needing it soon, and accept long periods of underperformance.' },
  { label: 'Minimum', value: sif.minimum },
  { label: 'Main risk', value: sif.mainRisk },
];

// Fit first: the whole portfolio, then whether a SIF adds anything.
const steps = [
  {
    name: 'First conversation',
    left: 'Tell us your goals, time frame and what you hold.',
    right: 'Discuss your risk profile and explain how SIFs work.',
  },
  {
    name: 'Portfolio assessment',
    left: 'Share your holdings or CAS after the call. Read the brief and ask questions.',
    right: 'Review the portfolio, then explain whether a SIF adds anything useful, with risks, redemption conditions and costs in writing.',
  },
  {
    name: 'Your decision and support',
    left: 'Decide whether to proceed. Approve transactions by OTP and pay the fund house directly.',
    right: 'Disclose our commission before you choose. Help with setup and review any SIF alongside your other funds.',
  },
];

const callDetails = '30-minute call · No charge · No obligation';
---

<Layout
  title="Is a SIF right for you? - Fund Investigator"
  description="Specialised Investment Funds start at ₹10 lakh and carry higher risks. We check whether a SIF suits your portfolio before you invest anything."
  trackView="landing_view"
  trackLanding="sif"
>
  <Hero size="md" background="dark">
    <h1 class:list={[responsive.display, 'font-bold text-fi-ink-inv mb-6 leading-fi-display tracking-fi-display break-words max-w-4xl mx-auto']}>
      Is a SIF
      <span class="block text-fi-gold">right for you?</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-72 sm:max-w-2xl mx-auto font-light leading-relaxed mb-8']}>
      Specialised Investment Funds can use strategies a mutual fund cannot, such as long-short. They start at ₹10 lakh and carry higher risks. We check whether one suits your portfolio before you invest anything.
    </p>
    <ContactActions placement="lp_sif_hero" surface="dark" note={callDetails} />

    <div class="mt-10 border-t border-fi-border-dark">
      <CredibilityStrip markers={[`AMFI-registered (${ARN})`, 'SIF distributor', 'Transparent disclosures']} />
    </div>
  </Hero>

  <Section id="what-is-a-sif" background="white" spacing="md" maxWidth="2xl">
    <OwnerIntro class="mb-10" />
    <SectionHeading
      title="A SIF at a glance."
      lead="A SEBI category run by mutual fund houses, between mutual funds and portfolio management services. It can take limited short positions through derivatives, which a mutual fund cannot."
    />
    <dl class="grid sm:grid-cols-3 gap-5 text-left">
      {facts.map((fact) => (
        <Card padding="lg" hover={false} class="h-full">
          <dt class="text-caption uppercase text-fi-muted mb-2">{fact.label}</dt>
          <dd class="text-body-md text-fi-ink leading-relaxed">{fact.value}</dd>
        </Card>
      ))}
    </dl>
    <AssessmentPreview variant="sif" class="mt-8" />
  </Section>

  <Section id="costs" background="light" spacing="md" maxWidth="lg">
    <SectionHeading
      title="How we are paid."
      lead="No separate fee from you. The fund house pays our commission from the SIF's yearly expense ratio. You get our commission in writing before you decide."
    />
    <Card padding="md" hover={false} class="max-w-2xl mx-auto text-left">
      <h3 class="text-body-md font-bold text-fi-ink mb-1">Everything in writing first</h3>
      <p class="text-body-sm text-fi-muted leading-relaxed">
        Before you invest, you get the strategy, its main risks, when you can redeem and our commission, in writing. Nothing moves without your approval.
      </p>
    </Card>
    <ContactActions placement="lp_sif_cta" surface="light" identity class="mt-12" />
  </Section>

  <Section id="how-it-works" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Your portfolio first. Then decide whether a SIF fits." lead="What you do, and what we do, at each stage." />
    <SplitRows rows={steps} rowLabel="Stage" columns={[{ label: 'You' }, { label: 'We' }]} numbered />
  </Section>

  <Section id="faq" background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="Questions about SIFs" />
    <div class="max-w-3xl mx-auto text-left">
      <FaqList items={sifFaq} />
    </div>
  </Section>

  <Section background="white" spacing="md" maxWidth="lg">
    <SectionHeading
      title="Ask whether a SIF suits you."
      lead="A 30-minute call. We look at what you hold first, and you decide what happens next."
    />
    <ContactActions placement="lp_sif_final" surface="light" />
  </Section>
</Layout>
