---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Hero from '../components/ui/Hero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Memo from '../components/ui/Memo.astro';
import StepMemos from '../components/ui/StepMemos.astro';
import IdCard from '../components/ui/IdCard.astro';
import Highlight from '../components/ui/Highlight.astro';
import { responsive } from '../lib/responsive';
import { whatsappUrl } from '../lib/whatsapp';
import { ARN, BOOKING_URL, FIRST_NAME, REGISTERED_NAME, TAGLINE } from '../lib/distributor';

// /about/ answers "who am I trusting?": the brand's reason and analytical method
// first, then the person behind it ("Know your distributor"). The brand leads;
// the owner does not overshadow it. It names no fund, so it may link to /invest/,
// the booking page and WhatsApp (handoff §2, Links). Links *to* this page never
// use the owner's name; the page itself does.
const ctaRow = 'flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 w-full max-w-80 sm:max-w-none mx-auto';

// Three analytical principles, in the order we apply them: the portfolio, then
// the numbers, then judgement. Qualitative checks list only what the owner does
// in a review (confirmed 2026-10-15); published investigations stay quantitative.
// Shown as typed memos ("Principle 01"), each with its proof in the foot.
const principles = [
  {
    title: 'Portfolio first',
    body: 'We start with the funds you already hold. Several funds can hold the same stocks. We check overlap and how much of your portfolio depends on a few stocks or sectors. Then we check how the fund mix fits your goals, time frame and risk profile.',
    links: [{ label: 'See our services →', href: '/invest/' }],
  },
  {
    title: 'Quantitative checks',
    body: 'We compare each fund with a benchmark that matches what it invests in. We check if the returns were consistent and if the extra return justified the extra risk. We also check how far the fund fell and how long recovery took. Our investigations show the checks and the data.',
    // No Deepdive link until the tool's outputs are cleared (COM-022, 2026-10-19).
    links: [{ label: 'Read the investigations →', href: '/reports/' }],
  },
  {
    title: 'Qualitative checks',
    body: 'Numbers show what happened, not why. So we check what the fund may invest in and if it holds to its stated strategy. We check who manages the fund and for how long. We also look at the investment process of the fund house.',
    links: [{ label: 'How the review works →', href: '/invest/#how-it-works' }],
  },
];

---

<Layout
  title="About Fund Investigator: Why We Exist"
  description={`Why Fund Investigator exists: evidence-driven mutual fund distribution and portfolio reviews. Run by ${REGISTERED_NAME}, ${ARN}.`}
>
  <!-- 1. Hero: the brand leads. The person comes in section 4, "Know your distributor". -->
  <Hero size="md" background="dark">
    <h1 class:list={[responsive.display, 'font-bold mb-6 leading-fi-display tracking-fi-display']}>
      <span class="text-fi-ink-inv">Why</span>
      <span class="text-fi-gold">Fund Investigator</span>
      <span class="text-fi-ink-inv">Exists</span>
    </h1>
    <p class:list={[responsive.subtitle, 'text-fi-muted-inv max-w-2xl mx-auto font-light leading-relaxed']}>
      We check how funds perform, how much risk they take, and how they fit together. Then we help you choose, invest and review.
    </p>
  </Hero>

  <!-- 2. Story: why we exist (analytical rigour in distribution) and the portfolio-first promise,
       as a typed letter (Memo without a title) under the centred heading. One highlight, on the
       promise itself. "Our story" matches the IdCard link that leads here. -->
  <Section background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Your portfolio first, then the product" />
    <div data-reveal={0}>
      <Memo label="Our story">
        <p>
          Most investors choose a fund by its past returns. Returns alone do not show the risk the fund took. They also do not show how it fits with your other funds. When that is not clear, a normal market fall can come as a surprise.
        </p>
        <p>
          I started Fund Investigator after 12 years in financial services. My aim is to bring analytical rigour to fund distribution. I built Deepdive to compare funds with fair benchmarks. It also checks how funds behaved when markets rose and fell.
        </p>
        <p>
          As an {TAGLINE}, <Highlight>we start with your portfolio, not with a product.</Highlight> We explain what each fund does and the risks it takes. We show how it fits your goals. We tell you what to expect, including the bad years. And we give our commission in writing.
        </p>
      </Memo>
    </div>
  </Section>

  <!-- 3. Our method: the analytical principles as typed memos, each with its proof in the foot. -->
  <Section background="light" spacing="md" maxWidth="xl">
    <SectionHeading title="Our analytical principles." lead="How we look at your portfolio and every fund in it." />
    <StepMemos label="Principle" steps={principles} />
  </Section>

  <!-- 4. Know your distributor: the ID card (as on /invest/, without its link back here) with the
       owner's own words inside, then the booking buttons. The background line
       in the card and the first paragraph both name the credentials (owner-approved 2026-10-19). -->
  <Section id="distributor" background="white" spacing="md" maxWidth="xl">
    <SectionHeading title="Know your distributor." />
    <div data-reveal={0}>
      <IdCard story={false} class="mx-auto w-full max-w-2xl">
        <p>
          I am the AMFI Registered distributor behind Fund Investigator. I have <strong>12 years in financial services</strong> and a <strong>Master's in Economics</strong>. I also hold a specialisation in Financial Technology and Management from <strong>IIT Kanpur</strong>.
        </p>
        <p>
          On our first call, I learn your goals and what you hold, and explain how we work. If you go ahead, I review your current funds, help you choose and invest, and we agree when to review your portfolio. I work with you personally, from the first call to every review.
        </p>
      </IdCard>
    </div>

    <div class="text-center mt-12">
      <div class={ctaRow}>
        <Button
          href={BOOKING_URL}
          target="_blank"
          rel="noopener noreferrer"
          icon="external"
          size="lg"
          track={{ event: 'review_booking_click', placement: 'about' }}
        >Book a call with {FIRST_NAME}</Button>
        <Button
          href={whatsappUrl('about')}
          variant="secondary"
          surface="light"
          target="_blank"
          rel="noopener noreferrer"
          icon="whatsapp"
          size="lg"
          track={{ event: 'conversation_request', placement: 'about', channel: 'whatsapp' }}
        >Contact on WhatsApp</Button>
      </div>
    </div>
  </Section>
</Layout>
