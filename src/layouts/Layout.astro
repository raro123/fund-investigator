---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RiskDisclosures from '../components/ui/RiskDisclosures.astro';
import { absoluteImageUrl, LANGUAGE, OG_LOCALE } from '../lib/schema';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import type { LandingId, TrackView } from '../lib/analytics';

// Self-hosted Inter font (matches Google Fonts weights) — site-wide UI chrome
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';

// Self-hosted Newsreader serif — report article content and brand pull quotes (style_spec.md §2)
import '@fontsource/newsreader/400.css';
// Typewriter face for the homepage typed text only (CaseFile, Memo, Dossier)
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css'; // dossier titles (Dossier)
import '@fontsource/newsreader/700.css';

interface Props {
  title?: string;
  description?: string;
  excerpt?: string;
  firstParagraph?: string;
  ogImage?: string;           // Optional: URL path to OG image
  ogImageAlt?: string;        // Optional: Alt text for OG image
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';  // Optional: defaults to 'website'
  jsonLd?: object[];          // Optional: schema.org entities, built via src/lib/schema.ts
  graph?: Record<string, unknown> | null;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    section?: string;
    tags?: readonly string[];
  };
  noindex?: boolean;
  extraLinks?: ReadonlyArray<Record<string, string>>;
  trackView?: TrackView;      // Optional: PostHog page-view event sent on load
  trackLanding?: LandingId;   // Optional: `landing` property of that event, on landing pages
  /** False only where the page shows the same warnings in its own disclaimer (articles). */
  riskDisclosures?: boolean;
}

const {
  title,
  description,
  excerpt,
  firstParagraph,
  ogImage,
  ogImageAlt,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',  // Default to 'website'
  jsonLd,
  graph: suppliedGraph,
  article,
  noindex = false,
  extraLinks = [],
  trackView,
  trackLanding,
  riskDisclosures = true,
} = Astro.props;

const resolvedTitle = title?.trim() || 'Fund Investigator';
const resolvedDescription =
  description?.trim() ||
  excerpt?.trim() ||
  firstParagraph?.trim() ||
  'Data-driven mutual fund analysis for Indian investors.';
const ogImageUrl = absoluteImageUrl(ogImage, Astro.site);

// Brand suffix in the tab/SERP title, skipped where the title already carries the brand
// (the homepage) so it never reads "Fund Investigator ... | Fund Investigator".
const pageTitle = resolvedTitle.includes('Fund Investigator')
  ? resolvedTitle
  : `${resolvedTitle} | Fund Investigator`;

// Keep the legacy list adapter for any page that has not yet moved to a graph.
// Current homepage and report routes pass a core-built graph directly.
const legacyGraph = jsonLd && jsonLd.length > 0
  ? {
      '@context': 'https://schema.org',
      '@graph': jsonLd.map(({ '@context': _context, ...entity }) => entity),
    }
  : undefined;
const graph = suppliedGraph ?? legacyGraph;

const defaultLinks = [
  { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
  { rel: 'icon', type: 'image/x-icon', href: '/favicon.ico' },
  { rel: 'alternate', type: 'application/rss+xml', href: '/feed.xml', title: 'Fund Investigator RSS feed' },
];
---

<!DOCTYPE html>
<html lang={LANGUAGE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={pageTitle}
      description={resolvedDescription}
      ogType={ogType}
      ogImage={ogImageUrl}
      ogImageAlt={ogImageAlt || resolvedTitle}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      siteName="Fund Investigator"
      locale={OG_LOCALE}
      twitter={{ card: 'summary_large_image' }}
      article={article}
      noindex={noindex}
      graph={graph}
      extraLinks={[...defaultLinks, ...extraLinks]}
    />

  </head>
  <body class="font-sans antialiased" data-track-view={trackView} data-track-landing={trackLanding}>
    <Header />
    <main>
      <slot />
    </main>
    {riskDisclosures && <RiskDisclosures />}
    <Footer />

    <script>
      // Reveal on scroll for elements marked data-reveal="<stagger index>".
      // Only elements that start below the fold animate, and only as they near
      // the viewport, so the first frame (and any thumbnail) is always complete.
      // Without JS, or with reduced motion, everything simply stays visible.
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion && revealItems.length > 0 && 'IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const item = entry.target as HTMLElement;
            revealObserver.unobserve(item);
            item.style.animationDelay = `${(Number(item.dataset.reveal) || 0) * 90}ms`;
            item.classList.add('animate-fi-rise');
          });
        }, { rootMargin: '0px 0px 8% 0px' });

        revealItems.forEach((item) => {
          if (item.getBoundingClientRect().top < window.innerHeight) return;
          revealObserver.observe(item);
        });
      }
    </script>

    <script>
      import posthog from 'posthog-js';

      // PostHog product analytics — same project already used for the Deepdive
      // app, extended here so a visitor's journey (homepage -> CTA click ->
      // Deepdive usage) can be stitched into one funnel instead of two
      // disconnected tools. No-ops cleanly if either env var is unset, so
      // local dev and any environment without them configured doesn't break
      // (mirrors the guard pattern the old Cloudflare beacon script used).
      const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
      const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST;

      if (posthogKey && posthogHost) {
        posthog.init(posthogKey, {
          api_host: posthogHost,
          person_profiles: 'identified_only',
          // Cross-subdomain tracking: fundinvestigator.com and
          // deepdive.fundinvestigator.com share a top-level domain, so
          // identity carries across via a shared top-level cookie. The
          // Deepdive app (separate repo) needs matching config for the
          // stitching to actually work end-to-end — see project_log.md #44.
          cross_subdomain_cookie: true,
          persistence: 'localStorage+cookie',
          // Autocapture (on by default) is intentionally left enabled and
          // undisturbed: every Substack CTA link already carries a
          // distinguishing utm_content in its href (see substack.ts), so autocapture's automatic click/pageview tracking
          // already gives placement-level attribution without hand-written
          // posthog.capture() calls per CTA.
        });

        // Funnel events (src/lib/analytics.ts). Booking and WhatsApp links
        // carry no utm the destination can report back, so these named
        // events are the record of which button started a conversation.
        // The view event also carries the page's utm_* tags, so a landing
        // page funnel can be broken down by the post or video that sent the
        // visitor (docs/landing_pages_plan.md §4).
        const view = document.body.dataset.trackView;
        if (view) {
          const utm = [...new URLSearchParams(window.location.search)].filter(([key]) => key.startsWith('utm_'));
          posthog.capture(view, { landing: document.body.dataset.trackLanding, ...Object.fromEntries(utm) });
        }

        document.addEventListener('click', (event) => {
          const tracked = (event.target as Element | null)?.closest<HTMLElement>('[data-track]');
          if (!tracked?.dataset.track) return;
          posthog.capture(tracked.dataset.track, {
            placement: tracked.dataset.placement,
            channel: tracked.dataset.channel,
          });
        });
      } else if (posthogKey || posthogHost) {
        // One var set without the other is almost certainly a misconfig —
        // PostHog Cloud has separate US/EU regions, so we never guess a host.
        console.warn(
          'PostHog analytics disabled: both PUBLIC_POSTHOG_KEY and PUBLIC_POSTHOG_HOST must be set (e.g. PUBLIC_POSTHOG_HOST=https://us.i.posthog.com or https://eu.i.posthog.com for the matching region).'
        );
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Shared boundary for the fixed header and every element positioned below it. */
    --fi-header-h: 5.25rem;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Cross-page transitions: the browser cross-fades between pages, and a report
     card title moves into the article H1 (shared view-transition-name, see
     ReportCard.astro and ArticleLayout.astro). Browsers without support load
     pages as usual. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  html {
    scroll-behavior: smooth;
    /* In-page anchors (e.g. /invest/#review) land below the fixed header. */
    scroll-padding-top: var(--fi-header-h);
    overflow-x: clip;
  }

  body {
    overflow-x: clip;
    width: 100%;
    min-height: 100vh;
  }

  /* Prevent horizontal overflow from long words */
  h1, h2, h3, h4, h5, h6, p {
    overflow-wrap: break-word;
    word-wrap: break-word;
  }
</style>
