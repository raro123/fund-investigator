---
import Layout from './Layout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import ArchivedReportNotice from '../components/ui/ArchivedReportNotice.astro';
import {
  absoluteImageUrl,
  articleSchema,
  breadcrumbSchema,
  organizationSchema,
  websiteSchema,
} from '../lib/schema';
import { substackWelcomeUrl } from '../lib/substack';

const { frontmatter } = Astro.props;
const formattedDate = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = [
  // Article credits the Organization as author/publisher by @id, so the full
  // Organization (and its WebSite) must be defined on this page for those refs to resolve.
  organizationSchema(Astro.site),
  websiteSchema(Astro.site),
  articleSchema(
    frontmatter,
    pageUrl,
    absoluteImageUrl(frontmatter.coverImage?.src, Astro.site),
    Astro.site
  ),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Investigations', path: '/reports/' },
    { name: frontmatter.title, path: Astro.url.pathname },
  ], Astro.site),
];
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  ogImage={frontmatter.coverImage?.src}
  ogImageAlt={frontmatter.coverImageAlt || frontmatter.title}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="fixed top-0 left-0 right-0 h-1 bg-fi-border z-50">
    <div class="h-full bg-fi-gold scroll-progress origin-left scale-x-0"></div>
  </div>

  <header class="bg-fi-dark pt-24 pb-14 sm:pt-32 sm:pb-20 px-4 sm:px-6 text-center">
    <div class="max-w-3xl mx-auto space-y-6">
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-fi-subtle">
        <time datetime={frontmatter.date}>{formattedDate}</time>
        <span>•</span>
        <span>{frontmatter.readTime}</span>
        {frontmatter.category && (
          <><span>•</span><span class="text-fi-gold uppercase tracking-wider text-xs font-bold">{frontmatter.category}</span></>
        )}
        {frontmatter.status === 'archived' && (
          <><span>•</span><Badge variant="dark" size="sm">Historical</Badge></>
        )}
      </div>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-fi-ink-inv leading-tight">{frontmatter.title}</h1>
      <p class="font-serif text-xl text-fi-muted-inv leading-relaxed max-w-2xl mx-auto">{frontmatter.hook ?? frontmatter.description}</p>
    </div>
  </header>

  <article class="relative bg-white px-4 sm:px-6 py-16 md:py-24">
    <div class="max-w-fi-content mx-auto">
      {frontmatter.status === 'archived' && frontmatter.analysisThrough && frontmatter.supersededBy && (
        <div class="mb-12">
          <ArchivedReportNotice
            analysisThrough={frontmatter.analysisThrough}
            supersededBy={frontmatter.supersededBy}
          />
        </div>
      )}

      <div class="article-prose prose prose-lg prose-slate prose-headings:text-fi-ink prose-headings:font-bold prose-headings:font-serif prose-p:font-serif prose-p:text-fi-muted prose-p:leading-loose prose-a:text-fi-ink prose-a:font-semibold prose-a:no-underline prose-a:border-b-2 prose-a:border-fi-gold/30 hover:prose-a:border-fi-gold hover:prose-a:text-fi-gold prose-a:transition-colors prose-blockquote:font-serif prose-blockquote:italic prose-blockquote:border-l-fi-gold prose-blockquote:bg-fi-light prose-blockquote:py-2 prose-blockquote:px-6 prose-img:rounded-lg prose-img:border prose-img:border-fi-border prose-img:shadow-fi-card prose-li:font-serif prose-li:marker:text-fi-muted prose-table:font-serif prose-td:tabular-nums">
        <slot />
      </div>

      <div class="mt-16 pt-8 border-t border-fi-border">
        <!-- One clear parting action after the report has delivered its evidence.
             Deepdive remains linked contextually inside each investigation. -->
        <div class="bg-fi-dark rounded-lg p-8 flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
          <div class="flex-1">
            <h3 class="text-xl font-bold text-fi-ink-inv mb-2">Subscribe for Investigation Briefs</h3>
            <p class="text-fi-muted-inv">Get notified when we publish new fund research or update an existing investigation.</p>
          </div>
          <Button href={substackWelcomeUrl('article_end')} variant="primary" size="md" icon="external">Subscribe</Button>
        </div>
      </div>

      <div class="mt-12 pt-8 border-t border-fi-border">
        <div class="text-sm text-fi-muted leading-relaxed max-w-[60ch] mx-auto">
          <h4 class="font-semibold text-fi-ink mb-3">Disclaimer</h4>
          <p class="mb-3">
            This analysis is based on historical performance data, sourced from Fund Investigator's Mutual Fund Deepdive platform. Past performance does not guarantee future results. This report is for informational purposes only and does not constitute investment advice or a recommendation to buy or sell.
          </p>
          <p>
            Before investing, review the fund's prospectus, consult with a qualified financial advisor, and ensure the investment aligns with your financial goals and risk tolerance. All equity mutual funds carry investment risk, including potential loss of principal.
          </p>
        </div>
      </div>
    </div>
  </article>

  <div
    id="image-lightbox"
    class="fixed inset-0 z-fi-header hidden items-center justify-center bg-fi-dark/95 p-4 cursor-zoom-out"
    role="dialog"
    aria-modal="true"
    aria-label="Enlarged image"
  >
    <button
      type="button"
      id="image-lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 text-fi-ink-inv/80 hover:text-fi-ink-inv transition-colors cursor-pointer"
      aria-label="Close enlarged image"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-fi-icon h-fi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <img
      id="image-lightbox-img"
      src=""
      alt=""
      class="max-h-[90vh] max-w-[92vw] object-contain rounded-lg shadow-fi-card-dark cursor-zoom-out"
    />
  </div>
</Layout>

<style>
  body { animation: scroll-progress linear; animation-timeline: scroll(); }
  @keyframes scroll-progress { from { --scroll: 0%; } to { --scroll: 100%; } }
  .scroll-progress { width: 100%; transform: scaleX(var(--scroll)); }

  #image-lightbox.flex { display: flex; }

  .article-prose :global(img) {
    display: block;
    width: min(92vw, 56rem);
    max-width: min(92vw, 56rem);
    margin-inline: calc((100% - min(92vw, 56rem)) / 2);
    cursor: zoom-in;
  }

  @media (max-width: 640px) {
    .article-prose :global(img) {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
    }
  }

  .article-prose :global(a[data-footnote-ref]) {
    @apply border-b-0 font-bold text-fi-muted no-underline;
  }

  .article-prose :global(.footnotes) {
    @apply mt-10 border-t border-fi-border pt-6 text-sm text-fi-muted;
  }

  .article-prose :global(.footnotes ol) {
    @apply mt-4;
  }

  .article-prose :global(.footnotes li) {
    @apply my-3 pl-1;
  }

  .article-prose :global(.data-footnote-backref) {
    @apply border-b-0 font-bold text-fi-muted no-underline;
  }

  .article-prose :global(#investigation-settings + ul li) {
    @apply marker:text-fi-muted;
  }
</style>

<script>
  // Safari fallback for scroll animation
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const bar = document.querySelector('.scroll-progress');
    if (bar) bar.style.transform = `scaleX(${scrolled / 100})`;
  });

  // Click-to-zoom lightbox for in-article images
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('image-lightbox-img');
  const closeButton = document.getElementById('image-lightbox-close');

  function openLightbox(img) {
    if (!(lightbox instanceof HTMLElement) || !(lightboxImg instanceof HTMLImageElement)) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!(lightbox instanceof HTMLElement)) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.article-prose img').forEach((img) => {
    img.addEventListener('click', () => openLightbox(img));
  });

  closeButton?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
  });
</script>
