---
import Layout from './Layout.astro';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Button from '../components/ui/Button.astro';
import ArchivedReportNotice from '../components/ui/ArchivedReportNotice.astro';
import ArticleBreadcrumbs from '../components/ui/ArticleBreadcrumbs.astro';
import ArticleMetadata from '../components/ui/ArticleMetadata.astro';
import ArticleTableOfContents from '../components/ui/ArticleTableOfContents.astro';
import ArticleServiceInvite from '../components/ui/ArticleServiceInvite.astro';
import {
  reportSchemaGraph,
  resolveArticleMetadata,
  resolveReportImage,
} from '../lib/schema';
import { SUBSCRIBE_PAGE } from '../lib/substack';

interface Props {
  frontmatter: CollectionEntry<'reports'>['data'];
  headings: MarkdownHeading[];
  articleBody: string;
  reportSlug: string;
  /** The report's footnotes, lifted out of the body by rehype-split-footnotes. */
  footnotesHtml?: string;
}

const { frontmatter, headings, articleBody, reportSlug, footnotesHtml } = Astro.props;
// Shared by the article body and its notes, which render apart so the service
// invite can sit between them.
const proseClasses = 'article-prose prose prose-lg prose-slate prose-headings:text-fi-ink prose-headings:font-bold prose-headings:font-serif prose-p:font-serif prose-p:text-fi-muted prose-p:leading-loose prose-a:text-fi-ink prose-a:font-semibold prose-a:no-underline prose-a:border-b-2 prose-a:border-fi-gold/30 hover:prose-a:border-fi-gold hover:prose-a:text-fi-link prose-a:transition-colors prose-blockquote:font-serif prose-blockquote:italic prose-blockquote:border-l-fi-gold prose-blockquote:bg-fi-light prose-blockquote:py-2 prose-blockquote:px-6 prose-img:rounded-lg prose-img:border prose-img:border-fi-border prose-img:shadow-fi-card prose-li:font-serif prose-li:marker:text-fi-muted prose-table:font-serif prose-td:tabular-nums';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedMetadata = resolveArticleMetadata(frontmatter);
const reportImage = resolveReportImage(frontmatter, reportSlug, Astro.site);
const graph = reportSchemaGraph(
  resolvedMetadata,
  pageUrl,
  reportImage.url,
  Astro.site,
  articleBody,
  reportImage.width,
  reportImage.height,
  reportImage.alt,
);
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Investigations', href: '/reports/' },
];
import { ARN, RISK_WARNING, SIF_WARNING, TAGLINE } from '../lib/distributor';
---

<Layout
  title={resolvedMetadata.title}
  description={resolvedMetadata.description}
  ogImage={reportImage.path}
  ogImageAlt={reportImage.alt}
  ogImageWidth={reportImage.width}
  ogImageHeight={reportImage.height}
  ogType="article"
  graph={graph}
  riskDisclosures={false}
  extraLinks={[{
    rel: 'alternate',
    type: 'text/markdown',
    href: `/reports/${reportSlug}.md`,
  }]}
  article={{
    publishedTime: frontmatter.date,
    modifiedTime: frontmatter.updated || frontmatter.date,
    section: frontmatter.category,
    tags: frontmatter.tags,
  }}
>
  <div
    class="fixed left-0 right-0 top-fi-header z-fi-progress h-1 invisible bg-fi-border-dark opacity-0 transition-opacity duration-200 motion-reduce:transition-none"
    aria-hidden="true"
    data-article-progress
    data-reading-active="false"
  >
    <div class="h-full bg-fi-gold scroll-progress origin-left scale-x-0"></div>
  </div>

  <header
    id="article-top"
    class="bg-fi-dark px-4 pb-14 pt-24 sm:px-6 sm:pb-20 sm:pt-32"
    data-article-hero
    data-reading-active="false"
    tabindex="-1"
  >
    <div class="max-w-3xl mx-auto space-y-6">
      <ArticleBreadcrumbs items={breadcrumbs} />
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-fi-ink-inv leading-tight" style={`view-transition-name: report-${reportSlug}`}>{frontmatter.title}</h1>
      <p class="max-w-2xl font-serif text-xl leading-relaxed text-fi-muted-inv">{frontmatter.hook ?? frontmatter.description}</p>
      <ArticleMetadata
        published={frontmatter.date}
        updated={frontmatter.updated}
        readTime={frontmatter.readTime}
        category={frontmatter.category}
        status={frontmatter.status}
      />
    </div>
  </header>

  <article class="relative bg-white px-4 py-16 sm:px-6 lg:px-10 xl:py-24">
    <div class="mx-auto max-w-7xl xl:grid xl:grid-cols-fi-article xl:gap-8">
      <ArticleTableOfContents headings={headings} />

      <div class="mx-auto w-full max-w-fi-content xl:col-start-2 xl:row-start-1">
      {frontmatter.status === 'archived' && frontmatter.analysisThrough && frontmatter.supersededBy && (
        <div class="mb-12">
          <ArchivedReportNotice
            analysisThrough={frontmatter.analysisThrough}
            supersededBy={frontmatter.supersededBy}
          />
        </div>
      )}

      <div class={proseClasses}>
        <slot />
      </div>

      {frontmatter.serviceInvite ? (
        <>
          <!-- Generic guide: the service invite comes straight after the article,
               above its notes. -->
          <div class="mt-16">
            <ArticleServiceInvite
              heading={frontmatter.serviceInvite.heading}
              line={frontmatter.serviceInvite.line}
            />
          </div>
          {footnotesHtml && <div class={proseClasses} set:html={footnotesHtml} />}
        </>
      ) : (
        <>
          {footnotesHtml && <div class={proseClasses} set:html={footnotesHtml} />}
          <div class="mt-16 pt-8 border-t border-fi-border">
            <!-- One clear parting action after the report has delivered its evidence. -->
            <div class="bg-fi-dark rounded-lg p-8 flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-fi-ink-inv mb-2">Subscribe for Investigation Briefs</h3>
                <p class="text-fi-muted-inv">Get notified when we publish new fund research or update an existing investigation.</p>
              </div>
              <Button href={SUBSCRIBE_PAGE} variant="primary" size="md" icon="arrow-right" track={{ event: 'subscribe_click', placement: 'report_end' }}>Subscribe</Button>
            </div>
          </div>
        </>
      )}

      <div class="mt-12 pt-8 border-t border-fi-border">
        <div class="mx-auto max-w-fi-disclaimer text-sm leading-relaxed text-fi-muted">
          <!-- Articles carry the regulators' warnings here, so Layout drops the
               sitewide RiskDisclosures card on these pages. -->
          <h4 class="font-semibold text-fi-ink mb-3">Disclaimer</h4>
          <p class="mb-3">{RISK_WARNING}</p>
          <p class="mb-3">{SIF_WARNING}</p>
          <p class="mb-3">
            This article is general information. It does not consider your personal circumstances and is not a recommendation to invest in any fund or category. Past performance does not guarantee future results.
          </p>
          <p>
            Fund Investigator is run by an {TAGLINE} ({ARN}).
          </p>
        </div>
      </div>
      </div>
    </div>
  </article>

  <div
    id="image-lightbox"
    class="fixed inset-0 z-fi-header hidden items-center justify-center bg-fi-dark/95 p-4 cursor-zoom-out"
    role="dialog"
    aria-modal="true"
    aria-label="Enlarged image"
  >
    <button
      type="button"
      id="image-lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 text-fi-ink-inv/80 hover:text-fi-ink-inv transition-colors cursor-pointer"
      aria-label="Close enlarged image"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-fi-icon h-fi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <img
      id="image-lightbox-img"
      src=""
      alt=""
      class="max-h-fi-lightbox max-w-fi-lightbox object-contain rounded-lg shadow-fi-card-dark cursor-zoom-out"
    />
  </div>
</Layout>

<style>
  .scroll-progress { width: 100%; }

  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      animation: scroll-progress linear;
      animation-timeline: scroll();
    }
  }

  @keyframes scroll-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  #image-lightbox.flex { display: flex; }

  .article-prose :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
    cursor: zoom-in;
  }

  .article-prose :global(.article-subscribe-note) {
    @apply my-8 rounded-lg border border-fi-border bg-fi-light p-4 font-sans text-sm leading-relaxed text-fi-muted;
  }

  .article-prose :global(.article-subscribe-note > strong) {
    @apply mb-1 block font-semibold text-fi-ink;
  }

  .article-prose :global(.article-subscribe-note > a) {
    @apply rounded-sm border-b-0 font-semibold text-fi-link underline decoration-fi-link/40 underline-offset-4 hover:decoration-fi-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fi-link;
  }

  .article-prose :global(.article-table) {
    @apply my-8;
    min-width: 0;
  }

  .article-prose :global(.article-table-hint) {
    @apply mb-2 mt-0 font-sans text-sm leading-relaxed text-fi-muted;
  }

  .article-prose :global(.article-table-scroll) {
    max-width: 100%;
    overflow-x: auto;
  }

  .article-prose :global(.article-table-scroll:focus-visible) {
    @apply rounded outline outline-2 outline-offset-2 outline-fi-link;
  }

  .article-prose :global(.article-table-scroll table) {
    @apply my-0;
  }

  .article-prose :global(table[data-wide-table] th),
  .article-prose :global(table[data-wide-table] td) {
    @apply min-w-fi-table-cell sm:min-w-0;
  }

  .article-prose :global(a[data-footnote-ref]) {
    @apply border-b-0 font-bold text-fi-muted no-underline;
  }

  .article-prose :global(.footnotes) {
    @apply mt-10 border-t border-fi-border pt-6 text-sm text-fi-muted;
  }

  .article-prose :global(.footnotes ol) {
    @apply mt-4;
  }

  .article-prose :global(.footnotes li) {
    @apply my-3 pl-1;
  }

  .article-prose :global(.data-footnote-backref) {
    @apply border-b-0 font-bold text-fi-muted no-underline;
  }

  .article-prose :global(#investigation-settings + ul li) {
    @apply marker:text-fi-muted;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-article-table]').forEach((region) => {
    const table = region.querySelector('table');
    const hint = document.getElementById(region.dataset.tableHint ?? '');
    if (!table || !hint) return;

    const syncOverflow = () => {
      const overflowing = region.scrollWidth > region.clientWidth + 1;
      hint.hidden = !overflowing;
      // Only tables that need horizontal navigation add a keyboard stop.
      if (overflowing) {
        region.tabIndex = 0;
        region.setAttribute('aria-describedby', hint.id);
      } else {
        region.removeAttribute('tabindex');
        region.removeAttribute('aria-describedby');
      }
    };

    const observer = new ResizeObserver(syncOverflow);
    observer.observe(region);
    observer.observe(table);
    syncOverflow();
  });

  const articleHero = document.querySelector<HTMLElement>('[data-article-hero]');
  const progressTrack = document.querySelector<HTMLElement>('[data-article-progress]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hasNativeScrollProgress = typeof CSS !== 'undefined'
    && CSS.supports('animation-timeline: scroll()');

  const setArticleReadingState = (active: boolean) => {
    if (!articleHero) return;

    articleHero.dataset.readingActive = String(active);

    if (progressTrack) {
      progressTrack.dataset.readingActive = String(active);

      if (active) {
        progressTrack.classList.remove('invisible');

        const revealProgress = () => {
          if (progressTrack.dataset.readingActive === 'true') {
            progressTrack.classList.remove('opacity-0');
          }
        };

        if (reducedMotion.matches) revealProgress();
        else requestAnimationFrame(revealProgress);
      } else {
        progressTrack.classList.add('opacity-0');
        if (reducedMotion.matches) progressTrack.classList.add('invisible');
      }
    }

    // Shared article-reading contract. Consumers read the durable hero data
    // attribute for initial state, then subscribe to this event for changes.
    window.dispatchEvent(new CustomEvent('article-reading-statechange', {
      detail: { active },
    }));
  };

  const syncArticleReadingState = () => {
    if (!articleHero) return;
    const heroBounds = articleHero.getBoundingClientRect();
    const heroIntersectsViewport = heroBounds.bottom > 0 && heroBounds.top < window.innerHeight;
    setArticleReadingState(!heroIntersectsViewport);
  };

  progressTrack?.addEventListener('transitionend', (event) => {
    if (
      event.target === progressTrack
      && event.propertyName === 'opacity'
      && progressTrack.dataset.readingActive === 'false'
    ) {
      progressTrack.classList.add('invisible');
    }
  });

  if (articleHero) {
    if ('IntersectionObserver' in window) {
      syncArticleReadingState();

      const heroObserver = new IntersectionObserver(([entry]) => {
        if (entry) setArticleReadingState(!entry.isIntersecting);
      }, { threshold: 0 });

      heroObserver.observe(articleHero);
    } else {
      setArticleReadingState(true);
    }
  }

  const updateScrollProgress = () => {
    if (hasNativeScrollProgress) return;

    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = height > 0 ? Math.min(Math.max(winScroll / height, 0), 1) : 0;
    const bar = document.querySelector('.scroll-progress');
    if (bar instanceof HTMLElement) bar.style.transform = `scaleX(${scrolled})`;
  };

  // Fallback for browsers without scroll-driven animations. The initial and
  // load updates also cover restored scroll positions and deep links.
  updateScrollProgress();
  window.addEventListener('load', updateScrollProgress, { once: true });
  window.addEventListener('scroll', updateScrollProgress, { passive: true });
  window.addEventListener('pageshow', () => {
    if ('IntersectionObserver' in window) syncArticleReadingState();
    else setArticleReadingState(true);
    updateScrollProgress();
  });

  // Click-to-zoom lightbox for in-article images
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('image-lightbox-img');
  const closeButton = document.getElementById('image-lightbox-close');

  function openLightbox(img) {
    if (!(lightbox instanceof HTMLElement) || !(lightboxImg instanceof HTMLImageElement)) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!(lightbox instanceof HTMLElement)) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.article-prose img').forEach((img) => {
    img.addEventListener('click', () => openLightbox(img));
  });

  closeButton?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
  });
</script>
