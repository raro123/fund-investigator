# Sitewide discovery, security, and performance headers. Cloudflare Pages
# applies these rules to static asset responses.
/*
  Link: </sitemap-index.xml>; rel="sitemap", </llms.txt>; rel="alternate"; type="text/plain", </.well-known/api-catalog>; rel="api-catalog", </schemamap.xml>; rel="schemamap"
  No-Vary-Search: key-order, params=("utm_source" "utm_medium" "utm_campaign" "utm_content" "utm_term")
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Phase 4 machine-readable routes.
/reports/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex, follow
  Link: <https://fundinvestigator.com/reports/:splat/>; rel="canonical"
  Cache-Control: public, max-age=3600

/schema/*.json
  Content-Type: application/ld+json; charset=utf-8
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=3600

/schemamap.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=3600

/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=3600
