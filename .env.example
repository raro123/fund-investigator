# Cloudflare Account ID
# Get from: Dashboard URL (https://dash.cloudflare.com/[ACCOUNT_ID]/...)
# Required for: Browser error tracking
# NOTE: dead — the beacon script that read this was deleted (project_log.md #37).
PUBLIC_CF_ACCOUNT_ID=

# Cloudflare Pages Project Name
# Required for: Browser error tracking
# NOTE: dead — same as above.
PUBLIC_CF_PROJECT_NAME=fund-investigator

# PostHog project API key (client-side "project API key" — safe to expose,
# but keep it in an env var rather than hardcoded)
# Required for: product analytics in src/layouts/Layout.astro. No-ops cleanly
# if unset (and if PUBLIC_POSTHOG_HOST is unset).
PUBLIC_POSTHOG_KEY=

# PostHog Cloud region host. Must match the region the existing Deepdive
# PostHog project lives in — US: https://us.i.posthog.com,
# EU: https://eu.i.posthog.com. No silent default; if unset, analytics is
# disabled (with a console warning if only one of the two vars is set).
PUBLIC_POSTHOG_HOST=
